{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PL98cdS4G69YB2RbbfxZYa","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_suite\\EventSubscriber;\n     6→\n     7→use Drupal\\Component\\Datetime\\TimeInterface;\n     8→use Drupal\\Core\\Database\\Connection;\n     9→use Drupal\\migrate\\Event\\MigrateEvents;\n    10→use Drupal\\migrate\\Event\\MigrateImportEvent;\n    11→use Drupal\\migrate\\Event\\MigratePostRowSaveEvent;\n    12→use Drupal\\migrate\\Event\\MigratePreRowSaveEvent;\n    13→use Drupal\\migrate\\Plugin\\MigrateIdMapInterface;\n    14→use Symfony\\Component\\EventDispatcher\\EventSubscriberInterface;\n    15→\n    16→/**\n    17→ * Logs migration run data to migrate_suite_run_log.\n    18→ */\n    19→class MigrateRunLogger implements EventSubscriberInterface {\n    20→\n    21→  /**\n    22→   * Tracks the current run log IDs keyed by migration ID.\n    23→   *\n    24→   * @var array<string, int>\n    25→   */\n    26→  protected array $activeRuns = [];\n    27→\n    28→  /**\n    29→   * Tracks row-level counters keyed by migration ID.\n    30→   *\n    31→   * @var array<string, array{processed: int, created: int, updated: int, failed: int}>\n    32→   */\n    33→  protected array $counters = [];\n    34→\n    35→  /**\n    36→   * Constructs a MigrateRunLogger object.\n    37→   *\n    38→   * @param \\Drupal\\Core\\Database\\Connection $database\n    39→   *   The database connection.\n    40→   * @param \\Drupal\\Component\\Datetime\\TimeInterface $time\n    41→   *   The time service.\n    42→   */\n    43→  public function __construct(\n    44→    protected readonly Connection $database,\n    45→    protected readonly TimeInterface $time,\n    46→  ) {}\n    47→\n    48→  /**\n    49→   * {@inheritdoc}\n    50→   */\n    51→  public static function getSubscribedEvents(): array {\n    52→    return [\n    53→      MigrateEvents::PRE_IMPORT => ['onPreImport'],\n    54→      MigrateEvents::POST_IMPORT => ['onPostImport'],\n    55→      MigrateEvents::PRE_ROW_SAVE => ['onPreRowSave'],\n    56→      MigrateEvents::POST_ROW_SAVE => ['onPostRowSave'],\n    57→    ];\n    58→  }\n    59→\n    60→  /**\n    61→   * Reacts to the pre-import event.\n    62→   *\n    63→   * @param \\Drupal\\migrate\\Event\\MigrateImportEvent $event\n    64→   *   The import event.\n    65→   */\n    66→  public function onPreImport(MigrateImportEvent $event): void {\n    67→    $migrationId = $event->getMigration()->id();\n    68→\n    69→    $this->counters[$migrationId] = [\n    70→      'processed' => 0,\n    71→      'created' => 0,\n    72→      'updated' => 0,\n    73→      'failed' => 0,\n    74→    ];\n    75→\n    76→    $id = $this->database->insert('migrate_suite_run_log')\n    77→      ->fields([\n    78→        'migration_id' => $migrationId,\n    79→        'status' => 'running',\n    80→        'started' => $this->time->getRequestTime(),\n    81→      ])\n    82→      ->execute();\n    83→\n    84→    $this->activeRuns[$migrationId] = (int) $id;\n    85→  }\n    86→\n    87→  /**\n    88→   * Reacts to the post-import event.\n    89→   *\n    90→   * @param \\Drupal\\migrate\\Event\\MigrateImportEvent $event\n    91→   *   The import event.\n    92→   */\n    93→  public function onPostImport(MigrateImportEvent $event): void {\n    94→    $migrationId = $event->getMigration()->id();\n    95→\n    96→    if (!isset($this->activeRuns[$migrationId])) {\n    97→      return;\n    98→    }\n    99→\n   100→    $counters = $this->counters[$migrationId] ?? [\n   101→      'processed' => 0,\n   102→      'created' => 0,\n   103→      'updated' => 0,\n   104→      'failed' => 0,\n   105→    ];\n   106→\n   107→    $status = $counters['failed'] > 0 ? 'failed' : 'completed';\n   108→\n   109→    $this->database->update('migrate_suite_run_log')\n   110→      ->fields([\n   111→        'status' => $status,\n   112→        'finished' => $this->time->getRequestTime(),\n   113→        'items_processed' => $counters['processed'],\n   114→        'items_created' => $counters['created'],\n   115→        'items_updated' => $counters['updated'],\n   116→        'items_failed' => $counters['failed'],\n   117→      ])\n   118→      ->condition('id', $this->activeRuns[$migrationId])\n   119→      ->execute();\n   120→\n   121→    unset($this->activeRuns[$migrationId], $this->counters[$migrationId]);\n   122→  }\n   123→\n   124→  /**\n   125→   * Reacts to the pre-row-save event.\n   126→   *\n   127→   * @param \\Drupal\\migrate\\Event\\MigratePreRowSaveEvent $event\n   128→   *   The pre-row-save event.\n   129→   */\n   130→  public function onPreRowSave(MigratePreRowSaveEvent $event): void {\n   131→    // Track that a row is being processed.\n   132→    $migrationId = $event->getMigration()->id();\n   133→    if (isset($this->counters[$migrationId])) {\n   134→      $this->counters[$migrationId]['processed']++;\n   135→    }\n   136→  }\n   137→\n   138→  /**\n   139→   * Reacts to the post-row-save event.\n   140→   *\n   141→   * @param \\Drupal\\migrate\\Event\\MigratePostRowSaveEvent $event\n   142→   *   The post-row-save event.\n   143→   */\n   144→  public function onPostRowSave(MigratePostRowSaveEvent $event): void {\n   145→    $migrationId = $event->getMigration()->id();\n   146→\n   147→    if (!isset($this->counters[$migrationId])) {\n   148→      return;\n   149→    }\n   150→\n   151→    $idMap = $event->getRow()->getIdMap();\n   152→    $status = $idMap['source_row_status'] ?? MigrateIdMapInterface::STATUS_IMPORTED;\n   153→\n   154→    switch ($status) {\n   155→      case MigrateIdMapInterface::STATUS_IMPORTED:\n   156→        // Determine if this is a create or update based on destination IDs.\n   157→        $destIds = $event->getDestinationIdValues();\n   158→        if (!empty($destIds)) {\n   159→          // Check if the row had pre-existing destination IDs (update).\n   160→          $previousDestIds = $event->getRow()->getDestination();\n   161→          if (!empty($previousDestIds)) {\n   162→            $this->counters[$migrationId]['updated']++;\n   163→          }\n   164→          else {\n   165→            $this->counters[$migrationId]['created']++;\n   166→          }\n   167→        }\n   168→        break;\n   169→\n   170→      case MigrateIdMapInterface::STATUS_FAILED:\n   171→        $this->counters[$migrationId]['failed']++;\n   172→        break;\n   173→    }\n   174→  }\n   175→\n   176→}\n   177→"}]},"parent_tool_use_id":"toolu_01YQpbM5YUa7uWExQhuuSjjV","session_id":"8ff06007-d15b-4e19-9bb5-ef9d85432d82","uuid":"d75ff2f5-81bb-4fb1-8178-be6960880e8e"}
