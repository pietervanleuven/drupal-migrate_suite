{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DTSL2c4Vm13FWcfaDvcTyG","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_admin\\Controller;\n     6→\n     7→use Drupal\\Core\\Controller\\ControllerBase;\n     8→use Drupal\\Core\\Database\\Connection;\n     9→use Drupal\\Core\\Datetime\\DateFormatterInterface;\n    10→use Drupal\\Core\\Extension\\ModuleHandlerInterface;\n    11→use Drupal\\Core\\Link;\n    12→use Drupal\\Core\\Url;\n    13→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    14→use Drupal\\migrate_permissions\\MigrateAccessCheck;\n    15→use Symfony\\Component\\DependencyInjection\\ContainerInterface;\n    16→use Symfony\\Component\\HttpFoundation\\Request;\n    17→\n    18→/**\n    19→ * Controller for the migration dashboard page.\n    20→ */\n    21→class MigrationDashboardController extends ControllerBase {\n    22→\n    23→  /**\n    24→   * Constructs a MigrationDashboardController object.\n    25→   *\n    26→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    27→   *   The migration plugin manager.\n    28→   * @param \\Drupal\\Core\\Database\\Connection $database\n    29→   *   The database connection.\n    30→   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n    31→   *   The date formatter service.\n    32→   */\n    33→  public function __construct(\n    34→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    35→    protected readonly Connection $database,\n    36→    protected readonly DateFormatterInterface $dateFormatter,\n    37→    protected readonly ModuleHandlerInterface $moduleHandler,\n    38→    protected readonly ?MigrateAccessCheck $migrateAccessCheck,\n    39→  ) {}\n    40→\n    41→  /**\n    42→   * {@inheritdoc}\n    43→   */\n    44→  public static function create(ContainerInterface $container): static {\n    45→    $migrateAccessCheck = $container->get('module_handler')->moduleExists('migrate_permissions')\n    46→      ? $container->get('migrate_permissions.access_check')\n    47→      : NULL;\n    48→\n    49→    return new static(\n    50→      $container->get('plugin.manager.migration'),\n    51→      $container->get('database'),\n    52→      $container->get('date.formatter'),\n    53→      $container->get('module_handler'),\n    54→      $migrateAccessCheck,\n    55→    );\n    56→  }\n    57→\n    58→  /**\n    59→   * Builds the migration dashboard page.\n    60→   *\n    61→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n    62→   *   The current request.\n    63→   *\n    64→   * @return array\n    65→   *   A render array.\n    66→   */\n    67→  public function dashboard(Request $request): array {\n    68→    $search = $request->query->get('search', '');\n    69→    $statusFilter = $request->query->get('status', '');\n    70→    $groupFilter = $request->query->get('group', '');\n    71→\n    72→    $migrations = $this->migrationPluginManager->createInstances([]);\n    73→\n    74→    if (empty($migrations)) {\n    75→      return [\n    76→        '#markup' => '<p>' . $this->t('No migrations are currently configured. Configure migrations using migration YAML files or Drush commands.') . '</p>',\n    77→      ];\n    78→    }\n    79→\n    80→    // Collect all groups for the filter dropdown.\n    81→    $allGroups = [];\n    82→    $groupedMigrations = [];\n    83→\n    84→    $account = $this->currentUser();\n    85→    $permissionsModuleEnabled = $this->migrateAccessCheck !== NULL;\n    86→\n    87→    foreach ($migrations as $migrationId => $migration) {\n    88→      // Apply per-migration view permission filter.\n    89→      if ($permissionsModuleEnabled && !$this->migrateAccessCheck->canViewMigration($account, $migrationId)) {\n    90→        continue;\n    91→      }\n    92→\n    93→      $label = $migration->label() ?: $migrationId;\n    94→      $definition = $migration->getPluginDefinition();\n    95→      $group = $definition['migration_group'] ?? 'default';\n    96→      $allGroups[$group] = $group;\n    97→\n    98→      // Apply text search filter.\n    99→      if ($search !== '' && stripos($migrationId, $search) === FALSE && stripos((string) $label, $search) === FALSE) {\n   100→        continue;\n   101→      }\n   102→\n   103→      // Get migration status.\n   104→      $status = $this->getMigrationStatus($migration);\n   105→\n   106→      // Apply status filter.\n   107→      if ($statusFilter !== '' && $status !== $statusFilter) {\n   108→        continue;\n   109→      }\n   110→\n   111→      // Apply group filter.\n   112→      if ($groupFilter !== '' && $group !== $groupFilter) {\n   113→        continue;\n   114→      }\n   115→\n   116→      // Get counts from map table.\n   117→      $counts = $this->getItemCounts($migrationId);\n   118→\n   119→      // Get source count.\n   120→      $sourceCount = $this->getSourceCount($migration);\n   121→\n   122→      // Get last run timestamp.\n   123→      $lastRun = $this->getLastRunTimestamp($migrationId);\n   124→\n   125→      $groupedMigrations[$group][$migrationId] = [\n   126→        'label' => $label,\n   127→        'group' => $group,\n   128→        'status' => $status,\n   129→        'source_count' => $sourceCount,\n   130→        'imported_count' => $counts['imported'],\n   131→        'failed_count' => $counts['failed'],\n   132→        'last_run' => $lastRun,\n   133→      ];\n   134→    }\n   135→\n   136→    ksort($allGroups);\n   137→\n   138→    $build = [];\n   139→\n   140→    // Filter form.\n   141→    $build['filters'] = $this->buildFilterForm($search, $statusFilter, $groupFilter, $allGroups);\n   142→\n   143→    // Build grouped tables.\n   144→    foreach ($groupedMigrations as $group => $groupMigrations) {\n   145→      $build['group_' . $group] = $this->buildGroupTable($group, $groupMigrations);\n   146→    }\n   147→\n   148→    if (empty($groupedMigrations)) {\n   149→      if ($permissionsModuleEnabled && $search === '' && $statusFilter === '' && $groupFilter === '') {\n   150→        $build['empty'] = [\n   151→          '#markup' => '<p>' . $this->t('You do not have permission to view any migrations. Contact your site administrator to grant you per-migration view permissions.') . '</p>',\n   152→        ];\n   153→      }\n   154→      else {\n   155→        $build['empty'] = [\n   156→          '#markup' => '<p>' . $this->t('No migrations match the current filters.') . '</p>',\n   157→        ];\n   158→      }\n   159→    }\n   160→\n   161→    $build['#attached'] = [\n   162→      'library' => ['migrate_admin/dashboard'],\n   163→    ];\n   164→    $build['#cache'] = [\n   165→      'contexts' => ['url.query_args'],\n   166→      'tags' => ['migration_plugins'],\n   167→    ];\n   168→\n   169→    return $build;\n   170→  }\n   171→\n   172→  /**\n   173→   * Gets the current status of a migration.\n   174→   *\n   175→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   176→   *   The migration plugin instance.\n   177→   *\n   178→   * @return string\n   179→   *   The status string: idle, importing, rolling_back, completed, or failed.\n   180→   */\n   181→  protected function getMigrationStatus($migration): string {\n   182→    $status = $migration->getStatusLabel();\n   183→\n   184→    // Map Drupal's status labels to our internal statuses.\n   185→    $statusString = (string) $status;\n   186→    $statusMap = [\n   187→      'Idle' => 'idle',\n   188→      'Importing' => 'importing',\n   189→      'Rolling back' => 'rolling_back',\n   190→      'Stopping' => 'idle',\n   191→      'Disabled' => 'idle',\n   192→    ];\n   193→\n   194→    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n   195→\n   196→    // Check run log for completed/failed status if currently idle.\n   197→    if ($migrationStatus === 'idle') {\n   198→      $migrationId = $migration->id();\n   199→      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   200→        ->fields('r', ['status'])\n   201→        ->condition('migration_id', $migrationId)\n   202→        ->orderBy('id', 'DESC')\n   203→        ->range(0, 1)\n   204→        ->execute()\n   205→        ->fetchField();\n   206→\n   207→      if ($lastRun === 'completed') {\n   208→        $migrationStatus = 'completed';\n   209→      }\n   210→      elseif ($lastRun === 'failed') {\n   211→        $migrationStatus = 'failed';\n   212→      }\n   213→    }\n   214→\n   215→    return $migrationStatus;\n   216→  }\n   217→\n   218→  /**\n   219→   * Gets item counts from the map table.\n   220→   *\n   221→   * @param string $migrationId\n   222→   *   The migration ID.\n   223→   *\n   224→   * @return array\n   225→   *   Associative array with 'imported', 'needs_update', 'failed' counts.\n   226→   */\n   227→  protected function getItemCounts(string $migrationId): array {\n   228→    $counts = [\n   229→      'imported' => 0,\n   230→      'needs_update' => 0,\n   231→      'failed' => 0,\n   232→    ];\n   233→\n   234→    $table = 'migrate_map_' . $migrationId;\n   235→    if (!$this->database->schema()->tableExists($table)) {\n   236→      return $counts;\n   237→    }\n   238→\n   239→    $results = $this->database->select($table, 'map')\n   240→      ->fields('map', ['source_row_status'])\n   241→      ->groupBy('source_row_status')\n   242→      ->addExpression('COUNT(*)', 'count')\n   243→      ->execute()\n   244→      ->fetchAllKeyed();\n   245→\n   246→    // Status constants: 0 = imported, 1 = needs_update, 2 = failed.\n   247→    $statusMap = [\n   248→      '0' => 'imported',\n   249→      '1' => 'needs_update',\n   250→      '2' => 'failed',\n   251→    ];\n   252→\n   253→    foreach ($results as $status => $count) {\n   254→      $key = $statusMap[(string) $status] ?? NULL;\n   255→      if ($key !== NULL) {\n   256→        $counts[$key] = (int) $count;\n   257→      }\n   258→    }\n   259→\n   260→    return $counts;\n   261→  }\n   262→\n   263→  /**\n   264→   * Gets the source count for a migration.\n   265→   *\n   266→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   267→   *   The migration plugin instance.\n   268→   *\n   269→   * @return int|string\n   270→   *   The source count or 'N/A' if unavailable.\n   271→   */\n   272→  protected function getSourceCount($migration): int|string {\n   273→    try {\n   274→      $source = $migration->getSourcePlugin();\n   275→      $count = $source->count();\n   276→      return $count === -1 ? 'N/A' : $count;\n   277→    }\n   278→    catch (\\Exception $e) {\n   279→      return 'N/A';\n   280→    }\n   281→  }\n   282→\n   283→  /**\n   284→   * Gets the last run timestamp for a migration.\n   285→   *\n   286→   * @param string $migrationId\n   287→   *   The migration ID.\n   288→   *\n   289→   * @return int|null\n   290→   *   The timestamp of the last run, or NULL if never run.\n   291→   */\n   292→  protected function getLastRunTimestamp(string $migrationId): ?int {\n   293→    $result = $this->database->select('migrate_suite_run_log', 'r')\n   294→      ->fields('r', ['started'])\n   295→      ->condition('migration_id', $migrationId)\n   296→      ->orderBy('id', 'DESC')\n   297→      ->range(0, 1)\n   298→      ->execute()\n   299→      ->fetchField();\n   300→\n   301→    return $result ? (int) $result : NULL;\n   302→  }\n   303→\n   304→  /**\n   305→   * Builds the filter form.\n   306→   *\n   307→   * @param string $search\n   308→   *   Current search value.\n   309→   * @param string $statusFilter\n   310→   *   Current status filter.\n   311→   * @param string $groupFilter\n   312→   *   Current group filter.\n   313→   * @param array $allGroups\n   314→   *   All available migration groups.\n   315→   *\n   316→   * @return array\n   317→   *   A render array for the filter form.\n   318→   */\n   319→  protected function buildFilterForm(string $search, string $statusFilter, string $groupFilter, array $allGroups): array {\n   320→    $statusOptions = [\n   321→      '' => $this->t('- All statuses -'),\n   322→      'idle' => $this->t('Idle'),\n   323→      'importing' => $this->t('Importing'),\n   324→      'rolling_back' => $this->t('Rolling back'),\n   325→      'completed' => $this->t('Completed'),\n   326→      'failed' => $this->t('Failed'),\n   327→    ];\n   328→\n   329→    $groupOptions = ['' => $this->t('- All groups -')];\n   330→    foreach ($allGroups as $group) {\n   331→      $groupOptions[$group] = $group;\n   332→    }\n   333→\n   334→    return [\n   335→      '#type' => 'container',\n   336→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   337→      'form' => [\n   338→        '#type' => 'html_tag',\n   339→        '#tag' => 'form',\n   340→        '#attributes' => [\n   341→          'method' => 'get',\n   342→          'class' => ['migrate-dashboard-filter-form'],\n   343→        ],\n   344→        'search' => [\n   345→          '#type' => 'html_tag',\n   346→          '#tag' => 'div',\n   347→          '#attributes' => ['class' => ['form-item']],\n   348→          'label' => [\n   349→            '#type' => 'html_tag',\n   350→            '#tag' => 'label',\n   351→            '#attributes' => ['for' => 'edit-search'],\n   352→            '#value' => $this->t('Search'),\n   353→          ],\n   354→          'input' => [\n   355→            '#type' => 'html_tag',\n   356→            '#tag' => 'input',\n   357→            '#attributes' => [\n   358→              'type' => 'text',\n   359→              'name' => 'search',\n   360→              'id' => 'edit-search',\n   361→              'value' => $search,\n   362→              'placeholder' => $this->t('Migration ID or label'),\n   363→              'class' => ['form-text'],\n   364→            ],\n   365→          ],\n   366→        ],\n   367→        'status' => [\n   368→          '#type' => 'html_tag',\n   369→          '#tag' => 'div',\n   370→          '#attributes' => ['class' => ['form-item']],\n   371→          'label' => [\n   372→            '#type' => 'html_tag',\n   373→            '#tag' => 'label',\n   374→            '#attributes' => ['for' => 'edit-status'],\n   375→            '#value' => $this->t('Status'),\n   376→          ],\n   377→          'select' => [\n   378→            '#type' => 'html_tag',\n   379→            '#tag' => 'select',\n   380→            '#attributes' => [\n   381→              'name' => 'status',\n   382→              'id' => 'edit-status',\n   383→              'class' => ['form-select'],\n   384→            ],\n   385→            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n   386→          ],\n   387→        ],\n   388→        'group' => [\n   389→          '#type' => 'html_tag',\n   390→          '#tag' => 'div',\n   391→          '#attributes' => ['class' => ['form-item']],\n   392→          'label' => [\n   393→            '#type' => 'html_tag',\n   394→            '#tag' => 'label',\n   395→            '#attributes' => ['for' => 'edit-group'],\n   396→            '#value' => $this->t('Group'),\n   397→          ],\n   398→          'select' => [\n   399→            '#type' => 'html_tag',\n   400→            '#tag' => 'select',\n   401→            '#attributes' => [\n   402→              'name' => 'group',\n   403→              'id' => 'edit-group',\n   404→              'class' => ['form-select'],\n   405→            ],\n   406→            'options' => $this->buildSelectOptions($groupOptions, $groupFilter),\n   407→          ],\n   408→        ],\n   409→        'actions' => [\n   410→          '#type' => 'html_tag',\n   411→          '#tag' => 'div',\n   412→          '#attributes' => ['class' => ['form-actions']],\n   413→          'submit' => [\n   414→            '#type' => 'html_tag',\n   415→            '#tag' => 'input',\n   416→            '#attributes' => [\n   417→              'type' => 'submit',\n   418→              'value' => $this->t('Filter'),\n   419→              'class' => ['button', 'button--primary'],\n   420→            ],\n   421→          ],\n   422→        ],\n   423→      ],\n   424→    ];\n   425→  }\n   426→\n   427→  /**\n   428→   * Builds select option elements.\n   429→   *\n   430→   * @param array $options\n   431→   *   The options array.\n   432→   * @param string $selectedValue\n   433→   *   The currently selected value.\n   434→   *\n   435→   * @return array\n   436→   *   A render array of option elements.\n   437→   */\n   438→  protected function buildSelectOptions(array $options, string $selectedValue): array {\n   439→    $elements = [];\n   440→    foreach ($options as $value => $label) {\n   441→      $attributes = ['value' => $value];\n   442→      if ((string) $value === $selectedValue) {\n   443→        $attributes['selected'] = 'selected';\n   444→      }\n   445→      $elements[] = [\n   446→        '#type' => 'html_tag',\n   447→        '#tag' => 'option',\n   448→        '#attributes' => $attributes,\n   449→        '#value' => $label,\n   450→      ];\n   451→    }\n   452→    return $elements;\n   453→  }\n   454→\n   455→  /**\n   456→   * Builds a migration group table.\n   457→   *\n   458→   * @param string $group\n   459→   *   The group name.\n   460→   * @param array $migrations\n   461→   *   The migrations in this group.\n   462→   *\n   463→   * @return array\n   464→   *   A render array for the group.\n   465→   */\n   466→  protected function buildGroupTable(string $group, array $migrations): array {\n   467→    $rows = [];\n   468→    foreach ($migrations as $migrationId => $data) {\n   469→      $statusBadge = $this->buildStatusBadge($data['status']);\n   470→\n   471→      $lastRun = $data['last_run']\n   472→        ? $this->dateFormatter->format($data['last_run'], 'short')\n   473→        : $this->t('Never');\n   474→\n   475→      $rows[] = [\n   476→        Link::fromTextAndUrl($data['label'], Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]))->toString(),\n   477→        $data['group'],\n   478→        $statusBadge,\n   479→        $data['source_count'],\n   480→        $data['imported_count'],\n   481→        $data['failed_count'],\n   482→        $lastRun,\n   483→      ];\n   484→    }\n   485→\n   486→    return [\n   487→      '#type' => 'details',\n   488→      '#title' => $this->t('Group: @group (@count)', [\n   489→        '@group' => $group,\n   490→        '@count' => count($migrations),\n   491→      ]),\n   492→      '#open' => TRUE,\n   493→      'table' => [\n   494→        '#type' => 'table',\n   495→        '#header' => [\n   496→          $this->t('Migration'),\n   497→          $this->t('Group'),\n   498→          $this->t('Status'),\n   499→          $this->t('Source count'),\n   500→          $this->t('Imported'),\n   501→          $this->t('Failed'),\n   502→          $this->t('Last run'),\n   503→        ],\n   504→        '#rows' => $rows,\n   505→        '#empty' => $this->t('No migrations in this group.'),\n   506→      ],\n   507→    ];\n   508→  }\n   509→\n   510→  /**\n   511→   * Builds a colored status badge.\n   512→   *\n   513→   * @param string $status\n   514→   *   The migration status.\n   515→   *\n   516→   * @return array|string\n   517→   *   A markup string with the status badge.\n   518→   */\n   519→  protected function buildStatusBadge(string $status): array|string {\n   520→    $labels = [\n   521→      'idle' => $this->t('Idle'),\n   522→      'importing' => $this->t('Importing'),\n   523→      'rolling_back' => $this->t('Rolling back'),\n   524→      'completed' => $this->t('Completed'),\n   525→      'failed' => $this->t('Failed'),\n   526→    ];\n   527→\n   528→    $colors = [\n   529→      'idle' => 'color--success',\n   530→      'importing' => 'color--primary',\n   531→      'rolling_back' => 'color--warning',\n   532→      'completed' => 'color--success',\n   533→      'failed' => 'color--error',\n   534→    ];\n   535→\n   536→    $label = $labels[$status] ?? $status;\n   537→    $colorClass = $colors[$status] ?? '';\n   538→\n   539→    return [\n   540→      'data' => [\n   541→        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n   542→      ],\n   543→    ];\n   544→  }\n   545→\n   546→}\n   547→"}]},"parent_tool_use_id":"toolu_01JAmBAdd5ZHjEG9NHm5kRWQ","session_id":"d40015d6-5dc4-4d37-b8ef-a7f6409020fa","uuid":"d3562d87-b87f-46d3-b120-538db89a1aaf"}
