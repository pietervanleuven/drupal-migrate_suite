{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019W1YAwV3YiBbat64JTPsrF","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_health\\Service;\n     6→\n     7→use Drupal\\Component\\Datetime\\TimeInterface;\n     8→use Drupal\\Core\\Config\\ConfigFactoryInterface;\n     9→use Drupal\\Core\\Database\\Connection;\n    10→\n    11→/**\n    12→ * Analyzes migration health based on run history and failure rates.\n    13→ */\n    14→class MigrationHealthAnalyzer {\n    15→\n    16→  /**\n    17→   * Health status constants.\n    18→   */\n    19→  const HEALTHY = 'healthy';\n    20→  const STALE = 'stale';\n    21→  const FAILING = 'failing';\n    22→\n    23→  /**\n    24→   * Constructs a MigrationHealthAnalyzer object.\n    25→   *\n    26→   * @param \\Drupal\\Core\\Database\\Connection $database\n    27→   *   The database connection.\n    28→   * @param \\Drupal\\Core\\Config\\ConfigFactoryInterface $configFactory\n    29→   *   The config factory.\n    30→   * @param \\Drupal\\Component\\Datetime\\TimeInterface $time\n    31→   *   The time service.\n    32→   */\n    33→  public function __construct(\n    34→    protected readonly Connection $database,\n    35→    protected readonly ConfigFactoryInterface $configFactory,\n    36→    protected readonly TimeInterface $time,\n    37→  ) {}\n    38→\n    39→  /**\n    40→   * Gets the health status for a single migration.\n    41→   *\n    42→   * @param string $migrationId\n    43→   *   The migration ID.\n    44→   *\n    45→   * @return string\n    46→   *   One of: healthy, stale, failing.\n    47→   */\n    48→  public function getHealth(string $migrationId): string {\n    49→    $config = $this->configFactory->get('migrate_health.settings');\n    50→    $staleThreshold = (int) ($config->get('stale_threshold') ?? 7);\n    51→    $failureRateThreshold = (float) ($config->get('failure_rate_threshold') ?? 5);\n    52→\n    53→    // Check failure rate first (higher priority).\n    54→    if ($this->isFailingMigration($migrationId, $failureRateThreshold)) {\n    55→      return self::FAILING;\n    56→    }\n    57→\n    58→    // Check staleness.\n    59→    if ($this->isStaleMigration($migrationId, $staleThreshold)) {\n    60→      return self::STALE;\n    61→    }\n    62→\n    63→    return self::HEALTHY;\n    64→  }\n    65→\n    66→  /**\n    67→   * Gets health statuses for multiple migrations.\n    68→   *\n    69→   * @param array $migrationIds\n    70→   *   Array of migration IDs.\n    71→   *\n    72→   * @return array\n    73→   *   Associative array keyed by migration ID with health status values.\n    74→   */\n    75→  public function getHealthForMultiple(array $migrationIds): array {\n    76→    $results = [];\n    77→    foreach ($migrationIds as $migrationId) {\n    78→      $results[$migrationId] = $this->getHealth($migrationId);\n    79→    }\n    80→    return $results;\n    81→  }\n    82→\n    83→  /**\n    84→   * Gets an aggregate summary of health across all provided migrations.\n    85→   *\n    86→   * @param array $healthStatuses\n    87→   *   Associative array of migration_id => health status.\n    88→   *\n    89→   * @return array\n    90→   *   Array with keys: healthy, stale, failing (counts).\n    91→   */\n    92→  public function getAggregateSummary(array $healthStatuses): array {\n    93→    $summary = [\n    94→      self::HEALTHY => 0,\n    95→      self::STALE => 0,\n    96→      self::FAILING => 0,\n    97→    ];\n    98→\n    99→    foreach ($healthStatuses as $status) {\n   100→      if (isset($summary[$status])) {\n   101→        $summary[$status]++;\n   102→      }\n   103→    }\n   104→\n   105→    return $summary;\n   106→  }\n   107→\n   108→  /**\n   109→   * Checks if a migration's failure rate exceeds the threshold.\n   110→   *\n   111→   * @param string $migrationId\n   112→   *   The migration ID.\n   113→   * @param float $threshold\n   114→   *   The failure rate threshold as a percentage.\n   115→   *\n   116→   * @return bool\n   117→   *   TRUE if failing.\n   118→   */\n   119→  protected function isFailingMigration(string $migrationId, float $threshold): bool {\n   120→    $table = 'migrate_map_' . $migrationId;\n   121→    if (!$this->database->schema()->tableExists($table)) {\n   122→      return FALSE;\n   123→    }\n   124→\n   125→    $total = (int) $this->database->select($table, 'map')\n   126→      ->countQuery()\n   127→      ->execute()\n   128→      ->fetchField();\n   129→\n   130→    if ($total === 0) {\n   131→      return FALSE;\n   132→    }\n   133→\n   134→    // Status 2 = MigrateIdMapInterface::STATUS_FAILED.\n   135→    $failed = (int) $this->database->select($table, 'map')\n   136→      ->condition('source_row_status', 2)\n   137→      ->countQuery()\n   138→      ->execute()\n   139→      ->fetchField();\n   140→\n   141→    $failureRate = ($failed / $total) * 100;\n   142→    return $failureRate > $threshold;\n   143→  }\n   144→\n   145→  /**\n   146→   * Checks if a migration is stale (hasn't run within the threshold).\n   147→   *\n   148→   * @param string $migrationId\n   149→   *   The migration ID.\n   150→   * @param int $thresholdDays\n   151→   *   Number of days before a migration is considered stale.\n   152→   *\n   153→   * @return bool\n   154→   *   TRUE if stale.\n   155→   */\n   156→  protected function isStaleMigration(string $migrationId, int $thresholdDays): bool {\n   157→    $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   158→      ->fields('r', ['started'])\n   159→      ->condition('migration_id', $migrationId)\n   160→      ->orderBy('id', 'DESC')\n   161→      ->range(0, 1)\n   162→      ->execute()\n   163→      ->fetchField();\n   164→\n   165→    if (!$lastRun) {\n   166→      // Never run = stale.\n   167→      return TRUE;\n   168→    }\n   169→\n   170→    $staleTimestamp = $this->time->getRequestTime() - ($thresholdDays * 86400);\n   171→    return (int) $lastRun < $staleTimestamp;\n   172→  }\n   173→\n   174→}\n   175→"}]},"parent_tool_use_id":"toolu_01K4BTcZkXfLmZoZb78Si7ST","session_id":"947754a4-35aa-442f-a4b8-f81a7a0a67f9","uuid":"0f4ef15f-b580-4913-89ac-2be032d2b166"}
