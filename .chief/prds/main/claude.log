{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V6Afi3c3CD75JhWMuATRo2","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_source_field\\Service;\n     6→\n     7→use Drupal\\Core\\Database\\Connection;\n     8→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n     9→\n    10→/**\n    11→ * Service for looking up migration provenance data for entities.\n    12→ */\n    13→class ProvenanceLookup {\n    14→\n    15→  /**\n    16→   * Constructs a ProvenanceLookup object.\n    17→   *\n    18→   * @param \\Drupal\\Core\\Database\\Connection $database\n    19→   *   The database connection.\n    20→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    21→   *   The migration plugin manager.\n    22→   */\n    23→  public function __construct(\n    24→    protected readonly Connection $database,\n    25→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    26→  ) {}\n    27→\n    28→  /**\n    29→   * Looks up provenance data for an entity.\n    30→   *\n    31→   * @param string $entityTypeId\n    32→   *   The entity type ID (e.g., 'node').\n    33→   * @param string|int $entityId\n    34→   *   The entity ID.\n    35→   *\n    36→   * @return array|null\n    37→   *   An associative array with keys 'migration_id', 'migration_label',\n    38→   *   'source_ids', and 'last_imported', or NULL if not found.\n    39→   */\n    40→  public function lookupProvenance(string $entityTypeId, string|int $entityId): ?array {\n    41→    $migrations = $this->migrationPluginManager->createInstances([]);\n    42→\n    43→    foreach ($migrations as $migrationId => $migration) {\n    44→      $definition = $migration->getPluginDefinition();\n    45→      $destPlugin = $definition['destination']['plugin'] ?? '';\n    46→\n    47→      // Only check migrations that target this entity type.\n    48→      if ($destPlugin !== 'entity:' . $entityTypeId) {\n    49→        continue;\n    50→      }\n    51→\n    52→      $table = 'migrate_map_' . $migrationId;\n    53→      if (!$this->database->schema()->tableExists($table)) {\n    54→        continue;\n    55→      }\n    56→\n    57→      // Query for a row where destid1 matches the entity ID.\n    58→      if (!$this->database->schema()->fieldExists($table, 'destid1')) {\n    59→        continue;\n    60→      }\n    61→\n    62→      try {\n    63→        $row = $this->database->select($table, 'map')\n    64→          ->fields('map')\n    65→          ->condition('destid1', (string) $entityId)\n    66→          ->range(0, 1)\n    67→          ->execute()\n    68→          ->fetchAssoc();\n    69→      }\n    70→      catch (\\Exception $e) {\n    71→        continue;\n    72→      }\n    73→\n    74→      if (!$row) {\n    75→        continue;\n    76→      }\n    77→\n    78→      // Extract source IDs.\n    79→      $sourceIds = [];\n    80→      for ($i = 1; $i <= 9; $i++) {\n    81→        $col = 'sourceid' . $i;\n    82→        if (isset($row[$col]) && $row[$col] !== NULL) {\n    83→          $sourceIds[] = $row[$col];\n    84→        }\n    85→      }\n    86→\n    87→      return [\n    88→        'migration_id' => $migrationId,\n    89→        'migration_label' => $migration->label() ?: $migrationId,\n    90→        'source_ids' => $sourceIds,\n    91→        'last_imported' => !empty($row['last_imported']) ? (int) $row['last_imported'] : NULL,\n    92→      ];\n    93→    }\n    94→\n    95→    return NULL;\n    96→  }\n    97→\n    98→}\n    99→"}]},"parent_tool_use_id":null,"session_id":"28cfe27e-2fc7-424c-a54a-476b587371b6","uuid":"7e50b792-ef1f-4df2-b086-e84c4d075f5c","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_source_field/src/Service/ProvenanceLookup.php","content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace Drupal\\migrate_source_field\\Service;\n\nuse Drupal\\Core\\Database\\Connection;\nuse Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n\n/**\n * Service for looking up migration provenance data for entities.\n */\nclass ProvenanceLookup {\n\n  /**\n   * Constructs a ProvenanceLookup object.\n   *\n   * @param \\Drupal\\Core\\Database\\Connection $database\n   *   The database connection.\n   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n   *   The migration plugin manager.\n   */\n  public function __construct(\n    protected readonly Connection $database,\n    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n  ) {}\n\n  /**\n   * Looks up provenance data for an entity.\n   *\n   * @param string $entityTypeId\n   *   The entity type ID (e.g., 'node').\n   * @param string|int $entityId\n   *   The entity ID.\n   *\n   * @return array|null\n   *   An associative array with keys 'migration_id', 'migration_label',\n   *   'source_ids', and 'last_imported', or NULL if not found.\n   */\n  public function lookupProvenance(string $entityTypeId, string|int $entityId): ?array {\n    $migrations = $this->migrationPluginManager->createInstances([]);\n\n    foreach ($migrations as $migrationId => $migration) {\n      $definition = $migration->getPluginDefinition();\n      $destPlugin = $definition['destination']['plugin'] ?? '';\n\n      // Only check migrations that target this entity type.\n      if ($destPlugin !== 'entity:' . $entityTypeId) {\n        continue;\n      }\n\n      $table = 'migrate_map_' . $migrationId;\n      if (!$this->database->schema()->tableExists($table)) {\n        continue;\n      }\n\n      // Query for a row where destid1 matches the entity ID.\n      if (!$this->database->schema()->fieldExists($table, 'destid1')) {\n        continue;\n      }\n\n      try {\n        $row = $this->database->select($table, 'map')\n          ->fields('map')\n          ->condition('destid1', (string) $entityId)\n          ->range(0, 1)\n          ->execute()\n          ->fetchAssoc();\n      }\n      catch (\\Exception $e) {\n        continue;\n      }\n\n      if (!$row) {\n        continue;\n      }\n\n      // Extract source IDs.\n      $sourceIds = [];\n      for ($i = 1; $i <= 9; $i++) {\n        $col = 'sourceid' . $i;\n        if (isset($row[$col]) && $row[$col] !== NULL) {\n          $sourceIds[] = $row[$col];\n        }\n      }\n\n      return [\n        'migration_id' => $migrationId,\n        'migration_label' => $migration->label() ?: $migrationId,\n        'source_ids' => $sourceIds,\n        'last_imported' => !empty($row['last_imported']) ? (int) $row['last_imported'] : NULL,\n      ];\n    }\n\n    return NULL;\n  }\n\n}\n","numLines":99,"startLine":1,"totalLines":99}}}
