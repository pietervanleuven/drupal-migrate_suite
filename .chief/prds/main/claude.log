  203→    if (empty($migrations[$migration_id])) {\n   204→      throw new NotFoundHttpException();\n   205→    }\n   206→    return $migrations[$migration_id];\n   207→  }\n   208→\n   209→  /**\n   210→   * Gets the current status of a migration.\n   211→   *\n   212→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   213→   *   The migration plugin instance.\n   214→   *\n   215→   * @return string\n   216→   *   The status string.\n   217→   */\n   218→  protected function getMigrationStatus($migration): string {\n   219→    $statusString = (string) $migration->getStatusLabel();\n   220→    $statusMap = [\n   221→      'Idle' => 'idle',\n   222→      'Importing' => 'importing',\n   223→      'Rolling back' => 'rolling_back',\n   224→      'Stopping' => 'idle',\n   225→      'Disabled' => 'idle',\n   226→    ];\n   227→\n   228→    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n   229→\n   230→    if ($migrationStatus === 'idle') {\n   231→      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   232→        ->fields('r', ['status'])\n   233→        ->condition('migration_id', $migration->id())\n   234→        ->orderBy('id', 'DESC')\n   235→        ->range(0, 1)\n   236→        ->execute()\n   237→        ->fetchField();\n   238→\n   239→      if ($lastRun === 'completed') {\n   240→        $migrationStatus = 'completed';\n   241→      }\n   242→      elseif ($lastRun === 'failed') {\n   243→        $migrationStatus = 'failed';\n   244→      }\n   245→    }\n   246→\n   247→    return $migrationStatus;\n   248→  }\n   249→\n   250→  /**\n   251→   * Gets the last run stats from the run log.\n   252→   *\n   253→   * @param string $migrationId\n   254→   *   The migration ID.\n   255→   *\n   256→   * @return object|null\n   257→   *   The last run log row, or NULL if never run.\n   258→   */\n   259→  protected function getLastRunStats(string $migrationId): ?object {\n   260→    $result = $this->database->select('migrate_suite_run_log', 'r')\n   261→      ->fields('r')\n   262→      ->condition('migration_id', $migrationId)\n   263→      ->orderBy('id', 'DESC')\n   264→      ->range(0, 1)\n   265→      ->execute()\n   266→      ->fetchObject();\n   267→\n   268→    return $result ?: NULL;\n   269→  }\n   270→\n   271→  /**\n   272→   * Builds a summary string for the last run.\n   273→   *\n   274→   * @param object $lastRun\n   275→   *   The last run log row.\n   276→   *\n   277→   * @return string\n   278→   *   A formatted summary string.\n   279→   */\n   280→  protected function buildLastRunSummary(object $lastRun): string {\n   281→    $started = $this->dateFormatter->format((int) $lastRun->started, 'short');\n   282→    $parts = [$this->t('Started: @date', ['@date' => $started])];\n   283→\n   284→    if ($lastRun->finished) {\n   285→      $finished = $this->dateFormatter->format((int) $lastRun->finished, 'short');\n   286→      $parts[] = $this->t('Finished: @date', ['@date' => $finished]);\n   287→    }\n   288→\n   289→    $parts[] = $this->t('Processed: @count', ['@count' => $lastRun->items_processed]);\n   290→    $parts[] = $this->t('Created: @count', ['@count' => $lastRun->items_created]);\n   291→    $parts[] = $this->t('Updated: @count', ['@count' => $lastRun->items_updated]);\n   292→    $parts[] = $this->t('Failed: @count', ['@count' => $lastRun->items_failed]);\n   293→\n   294→    return implode(' | ', $parts);\n   295→  }\n   296→\n   297→  /**\n   298→   * Builds a colored status badge.\n   299→   *\n   300→   * @param string $status\n   301→   *   The migration status.\n   302→   *\n   303→   * @return array\n   304→   *   A render array with the badge markup.\n   305→   */\n   306→  protected function buildStatusBadge(string $status): array {\n   307→    $labels = [\n   308→      'idle' => $this->t('Idle'),\n   309→      'importing' => $this->t('Importing'),\n   310→      'rolling_back' => $this->t('Rolling back'),\n   311→      'completed' => $this->t('Completed'),\n   312→      'failed' => $this->t('Failed'),\n   313→    ];\n   314→\n   315→    $colors = [\n   316→      'idle' => 'color--success',\n   317→      'importing' => 'color--primary',\n   318→      'rolling_back' => 'color--warning',\n   319→      'completed' => 'color--success',\n   320→      'failed' => 'color--error',\n   321→    ];\n   322→\n   323→    $label = $labels[$status] ?? $status;\n   324→    $colorClass = $colors[$status] ?? '';\n   325→\n   326→    return [\n   327→      'data' => [\n   328→        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n   329→      ],\n   330→    ];\n   331→  }\n   332→\n   333→  /**\n   334→   * Builds the imported items section with filters and pager.\n   335→   *\n   336→   * @param string $migrationId\n   337→   *   The migration ID.\n   338→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   339→   *   The current request.\n   340→   *\n   341→   * @return array\n   342→   *   A render array.\n   343→   */\n   344→  protected function buildImportedItemsSection(string $migrationId, Request $request): array {\n   345→    $search = $request->query->get('search', '');\n   346→    $statusFilter = $request->query->get('status', '');\n   347→    $page = max(0, (int) $request->query->get('page', 0));\n   348→\n   349→    $table = 'migrate_map_' . $migrationId;\n   350→    if (!$this->database->schema()->tableExists($table)) {\n   351→      return [\n   352→        '#markup' => '<p>' . $this->t('No map table exists for this migration. The migration may not have been run yet.') . '</p>',\n   353→      ];\n   354→    }\n   355→\n   356→    // Build the query.\n   357→    $query = $this->database->select($table, 'map')\n   358→      ->fields('map');\n   359→\n   360→    // Apply status filter.\n   361→    $statusMap = [\n   362→      'imported' => 0,\n   363→      'needs_update' => 1,\n   364→      'failed' => 2,\n   365→    ];\n   366→    if ($statusFilter !== '' && isset($statusMap[$statusFilter])) {\n   367→      $query->condition('source_row_status', $statusMap[$statusFilter]);\n   368→    }\n   369→\n   370→    // Apply search filter on source IDs.\n   371→    if ($search !== '') {\n   372→      $or = $query->orConditionGroup();\n   373→      // Search across sourceid columns (up to 5).\n   374→      for ($i = 1; $i <= 5; $i++) {\n   375→        $col = 'sourceid' . $i;\n   376→        if ($this->database->schema()->fieldExists($table, $col)) {\n   377→          $or->condition($col, '%' . $this->database->escapeLike($search) . '%', 'LIKE');\n   378→        }\n   379→      }\n   380→      $query->condition($or);\n   381→    }\n   382→\n   383→    // Count total for pager.\n   384→    $countQuery = clone $query;\n   385→    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n   386→\n   387→    // Apply pager.\n   388→    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n   389→    $query->orderBy('last_imported', 'DESC');\n   390→\n   391→    $rows = $query->execute()->fetchAll();\n   392→\n   393→    // Detect source ID and destination ID columns.\n   394→    $sourceIdCols = [];\n   395→    $destIdCols = [];\n   396→    for ($i = 1; $i <= 9; $i++) {\n   397→      if ($this->database->schema()->fieldExists($table, 'sourceid' . $i)) {\n   398→        $sourceIdCols[] = 'sourceid' . $i;\n   399→      }\n   400→      if ($this->database->schema()->fieldExists($table, 'destid' . $i)) {\n   401→        $destIdCols[] = 'destid' . $i;\n   402→      }\n   403→    }\n   404→\n   405→    // Build filter form.\n   406→    $build = [];\n   407→    $build['filters'] = $this->buildItemFilterForm($migrationId, $search, $statusFilter);\n   408→\n   409→    // Build table rows.\n   410→    $tableRows = [];\n   411→    foreach ($rows as $row) {\n   412→      $sourceIds = [];\n   413→      foreach ($sourceIdCols as $col) {\n   414→        if (isset($row->$col) && $row->$col !== NULL) {\n   415→          $sourceIds[] = $row->$col;\n   416→        }\n   417→      }\n   418→\n   419→      $destIds = [];\n   420→      foreach ($destIdCols as $col) {\n   421→        if (isset($row->$col) && $row->$col !== NULL) {\n   422→          $destIds[] = $row->$col;\n   423→        }\n   424→      }\n   425→\n   426→      $destDisplay = implode(', ', $destIds) ?: $this->t('N/A');\n   427→\n   428→      // Try to link to the entity if we have a single destination ID.\n   429→      if (count($destIds) === 1) {\n   430→        $destDisplay = $this->buildEntityLink($migrationId, (string) $destIds[0]) ?: $destDisplay;\n   431→      }\n   432→\n   433→      $statusLabel = $this->getRowStatusLabel((int) $row->source_row_status);\n   434→\n   435→      $lastImported = !empty($row->last_imported)\n   436→        ? $this->dateFormatter->format((int) $row->last_imported, 'short')\n   437→        : $this->t('Unknown');\n   438→\n   439→      $tableRows[] = [\n   440→        implode(', ', $sourceIds),\n   441→        ['data' => ['#markup' => (string) $destDisplay]],\n   442→        $statusLabel,\n   443→        $lastImported,\n   444→      ];\n   445→    }\n   446→\n   447→    $build['table'] = [\n   448→      '#type' => 'table',\n   449→      '#header' => [\n   450→        $this->t('Source ID(s)'),\n   451→        $this->t('Destination entity'),\n   452→        $this->t('Status'),\n   453→        $this->t('Last import'),\n   454→      ],\n   455→      '#rows' => $tableRows,\n   456→      '#empty' => $this->t('No imported items found.'),\n   457→    ];\n   458→\n   459→    // Build pager.\n   460→    if ($total > self::ITEMS_PER_PAGE) {\n   461→      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request);\n   462→    }\n   463→\n   464→    return $build;\n   465→  }\n   466→\n   467→  /**\n   468→   * Builds the messages section with filters and pager.\n   469→   *\n   470→   * @param string $migrationId\n   471→   *   The migration ID.\n   472→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   473→   *   The current request.\n   474→   *\n   475→   * @return array\n   476→   *   A render array.\n   477→   */\n   478→  protected function buildMessagesSection(string $migrationId, Request $request): array {\n   479→    $severityFilter = $request->query->get('severity', '');\n   480→    $page = max(0, (int) $request->query->get('page', 0));\n   481→\n   482→    $table = 'migrate_message_' . $migrationId;\n   483→    if (!$this->database->schema()->tableExists($table)) {\n   484→      return [\n   485→        '#markup' => '<p>' . $this->t('No message table exists for this migration.') . '</p>',\n   486→      ];\n   487→    }\n   488→\n   489→    $query = $this->database->select($table, 'msg')\n   490→      ->fields('msg');\n   491→\n   492→    // Apply severity filter.\n   493→    $severityMap = [\n   494→      'notice' => 6,\n   495→      'warning' => 4,\n   496→      'error' => 3,\n   497→    ];\n   498→    if ($severityFilter !== '' && isset($severityMap[$severityFilter])) {\n   499→      $query->condition('level', $severityMap[$severityFilter]);\n   500→    }\n   501→\n   502→    // Count total for pager.\n   503→    $countQuery = clone $query;\n   504→    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n   505→\n   506→    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n   507→    $rows = $query->execute()->fetchAll();\n   508→\n   509→    // Detect source ID columns.\n   510→    $sourceIdCols = [];\n   511→    for ($i = 1; $i <= 9; $i++) {\n   512→      $col = 'src_' . $i;\n   513→      if ($this->database->schema()->fieldExists($table, $col)) {\n   514→        $sourceIdCols[] = $col;\n   515→      }\n   516→    }\n   517→\n   518→    // Build severity filter.\n   519→    $build = [];\n   520→    $build['filters'] = $this->buildMessageFilterForm($migrationId, $severityFilter);\n   521→\n   522→    // Build table rows.\n   523→    $tableRows = [];\n   524→    foreach ($rows as $row) {\n   525→      $sourceIds = [];\n   526→      foreach ($sourceIdCols as $col) {\n   527→        if (isset($row->$col) && $row->$col !== NULL) {\n   528→          $sourceIds[] = $row->$col;\n   529→        }\n   530→      }\n   531→\n   532→      $severityIcon = $this->getSeverityIcon((int) $row->level);\n   533→\n   534→      $tableRows[] = [\n   535→        implode(', ', $sourceIds),\n   536→        ['data' => ['#markup' => $severityIcon]],\n   537→        $row->message ?? '',\n   538→      ];\n   539→    }\n   540→\n   541→    $build['table'] = [\n   542→      '#type' => 'table',\n   543→      '#header' => [\n   544→        $this->t('Source ID(s)'),\n   545→        $this->t('Severity'),\n   546→        $this->t('Message'),\n   547→      ],\n   548→      '#rows' => $tableRows,\n   549→      '#empty' => $this->t('No messages found.'),\n   550→    ];\n   551→\n   552→    // Build pager.\n   553→    if ($total > self::ITEMS_PER_PAGE) {\n   554→      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request, 'messages');\n   555→    }\n   556→\n   557→    return $build;\n   558→  }\n   559→\n   560→  /**\n   561→   * Builds the filter form for imported items.\n   562→   *\n   563→   * @param string $migrationId\n   564→   *   The migration ID.\n   565→   * @param string $search\n   566→   *   Current search value.\n   567→   * @param string $statusFilter\n   568→   *   Current status filter.\n   569→   *\n   570→   * @return array\n   571→   *   A render array.\n   572→   */\n   573→  protected function buildItemFilterForm(string $migrationId, string $search, string $statusFilter): array {\n   574→    $statusOptions = [\n   575→      '' => $this->t('- All statuses -'),\n   576→      'imported' => $this->t('Imported'),\n   577→      'needs_update' => $this->t('Needs update'),\n   578→      'failed' => $this->t('Failed'),\n   579→    ];\n   580→\n   581→    return [\n   582→      '#type' => 'container',\n   583→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   584→      'form' => [\n   585→        '#type' => 'html_tag',\n   586→        '#tag' => 'form',\n   587→        '#attributes' => [\n   588→          'method' => 'get',\n   589→          'class' => ['migrate-dashboard-filter-form'],\n   590→        ],\n   591→        'search' => [\n   592→          '#type' => 'html_tag',\n   593→          '#tag' => 'div',\n   594→          '#attributes' => ['class' => ['form-item']],\n   595→          'label' => [\n   596→            '#type' => 'html_tag',\n   597→            '#tag' => 'label',\n   598→            '#attributes' => ['for' => 'edit-search'],\n   599→            '#value' => $this->t('Source ID'),\n   600→          ],\n   601→          'input' => [\n   602→            '#type' => 'html_tag',\n   603→            '#tag' => 'input',\n   604→            '#attributes' => [\n   605→              'type' => 'text',\n   606→              'name' => 'search',\n   607→              'id' => 'edit-search',\n   608→              'value' => $search,\n   609→              'placeholder' => $this->t('Search source ID'),\n   610→              'class' => ['form-text'],\n   611→            ],\n   612→          ],\n   613→        ],\n   614→        'status' => [\n   615→          '#type' => 'html_tag',\n   616→          '#tag' => 'div',\n   617→          '#attributes' => ['class' => ['form-item']],\n   618→          'label' => [\n   619→            '#type' => 'html_tag',\n   620→            '#tag' => 'label',\n   621→            '#attributes' => ['for' => 'edit-status'],\n   622→            '#value' => $this->t('Status'),\n   623→          ],\n   624→          'select' => [\n   625→            '#type' => 'html_tag',\n   626→            '#tag' => 'select',\n   627→            '#attributes' => [\n   628→              'name' => 'status',\n   629→              'id' => 'edit-status',\n   630→              'class' => ['form-select'],\n   631→            ],\n   632→            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n   633→          ],\n   634→        ],\n   635→        'actions' => [\n   636→          '#type' => 'html_tag',\n   637→          '#tag' => 'div',\n   638→          '#attributes' => ['class' => ['form-actions']],\n   639→          'submit' => [\n   640→            '#type' => 'html_tag',\n   641→            '#tag' => 'input',\n   642→            '#attributes' => [\n   643→              'type' => 'submit',\n   644→              'value' => $this->t('Filter'),\n   645→              'class' => ['button', 'button--primary'],\n   646→            ],\n   647→          ],\n   648→        ],\n   649→      ],\n   650→    ];\n   651→  }\n   652→\n   653→  /**\n   654→   * Builds the filter form for messages.\n   655→   *\n   656→   * @param string $migrationId\n   657→   *   The migration ID.\n   658→   * @param string $severityFilter\n   659→   *   Current severity filter.\n   660→   *\n   661→   * @return array\n   662→   *   A render array.\n   663→   */\n   664→  protected function buildMessageFilterForm(string $migrationId, string $severityFilter): array {\n   665→    $severityOptions = [\n   666→      '' => $this->t('- All severities -'),\n   667→      'notice' => $this->t('Notice'),\n   668→      'warning' => $this->t('Warning'),\n   669→      'error' => $this->t('Error'),\n   670→    ];\n   671→\n   672→    return [\n   673→      '#type' => 'container',\n   674→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   675→      'form' => [\n   676→        '#type' => 'html_tag',\n   677→        '#tag' => 'form',\n   678→        '#attributes' => [\n   679→          'method' => 'get',\n   680→          'class' => ['migrate-dashboard-filter-form'],\n   681→        ],\n   682→        'severity' => [\n   683→          '#type' => 'html_tag',\n   684→          '#tag' => 'div',\n   685→          '#attributes' => ['class' => ['form-item']],\n   686→          'label' => [\n   687→            '#type' => 'html_tag',\n   688→            '#tag' => 'label',\n   689→            '#attributes' => ['for' => 'edit-severity'],\n   690→            '#value' => $this->t('Severity'),\n   691→          ],\n   692→          'select' => [\n   693→            '#type' => 'html_tag',\n   694→            '#tag' => 'select',\n   695→            '#attributes' => [\n   696→              'name' => 'severity',\n   697→              'id' => 'edit-severity',\n   698→              'class' => ['form-select'],\n   699→            ],\n   700→            'options' => $this->buildSelectOptions($severityOptions, $severityFilter),\n   701→          ],\n   702→        ],\n   703→        'actions' => [\n   704→          '#type' => 'html_tag',\n   705→          '#tag' => 'div',\n   706→          '#attributes' => ['class' => ['form-actions']],\n   707→          'submit' => [\n   708→            '#type' => 'html_tag',\n   709→            '#tag' => 'input',\n   710→            '#attributes' => [\n   711→              'type' => 'submit',\n   712→              'value' => $this->t('Filter'),\n   713→              'class' => ['button', 'button--primary'],\n   714→            ],\n   715→          ],\n   716→        ],\n   717→      ],\n   718→    ];\n   719→  }\n   720→\n   721→  /**\n   722→   * Builds select option elements.\n   723→   *\n   724→   * @param array $options\n   725→   *   The options array.\n   726→   * @param string $selectedValue\n   727→   *   The currently selected value.\n   728→   *\n   729→   * @return array\n   730→   *   A render array of option elements.\n   731→   */\n   732→  protected function buildSelectOptions(array $options, string $selectedValue): array {\n   733→    $elements = [];\n   734→    foreach ($options as $value => $label) {\n   735→      $attributes = ['value' => $value];\n   736→      if ((string) $value === $selectedValue) {\n   737→        $attributes['selected'] = 'selected';\n   738→      }\n   739→      $elements[] = [\n   740→        '#type' => 'html_tag',\n   741→        '#tag' => 'option',\n   742→        '#attributes' => $attributes,\n   743→        '#value' => $label,\n   744→      ];\n   745→    }\n   746→    return $elements;\n   747→  }\n   748→\n   749→  /**\n   750→   * Builds a simple pager.\n   751→   *\n   752→   * @param string $migrationId\n   753→   *   The migration ID.\n   754→   * @param int $currentPage\n   755→   *   The current page number (0-indexed).\n   756→   * @param int $total\n   757→   *   The total number of items.\n   758→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   759→   *   The current request.\n   760→   * @param string $tab\n   761→   *   The current tab ('items' or 'messages').\n   762→   *\n   763→   * @return array\n   764→   *   A render array for the pager.\n   765→   */\n   766→  protected function buildPager(string $migrationId, int $currentPage, int $total, Request $request, string $tab = 'items'): array {\n   767→    $totalPages = (int) ceil($total / self::ITEMS_PER_PAGE);\n   768→    $route = $tab === 'messages' ? 'migrate_admin.migration_messages' : 'migrate_admin.migration_detail';\n   769→\n   770→    $queryParams = $request->query->all();\n   771→    $links = [];\n   772→\n   773→    if ($currentPage > 0) {\n   774→      $queryParams['page'] = $currentPage - 1;\n   775→      $links['previous'] = [\n   776→        '#type' => 'html_tag',\n   777→        '#tag' => 'a',\n   778→        '#value' => $this->t('Previous'),\n   779→        '#attributes' => [\n   780→          'href' => Url::fromRoute($route, ['migration_id' => $migrationId], ['query' => $queryParams])->toString(),\n   781→          'class' => ['button'],\n   782→        ],\n   783→      ];\n   784→    }\n   785→\n   786→    $links['info'] = [\n   787→      '#type' => 'html_tag',\n   788→      '#tag' => 'span',\n   789→      '#value' => $this->t('Page @current of @total (@items items)', [\n   790→        '@current' => $currentPage + 1,\n   791→        '@total' => $totalPages,\n   792→        '@items' => $total,\n   793→      ]),\n   794→      '#attributes' => ['class' => ['migrate-pager-info']],\n   795→    ];\n   796→\n   797→    if ($currentPage < $totalPages - 1) {\n   798→      $queryParams['page'] = $currentPage + 1;\n   799→      $links['next'] = [\n   800→        '#type' => 'html_tag',\n   801→        '#tag' => 'a',\n   802→        '#value' => $this->t('Next'),\n   803→        '#attributes' => [\n   804→          'href' => Url::fromRoute($route, ['migration_id' => $migrationId], ['query' => $queryParams])->toString(),\n   805→          'class' => ['button'],\n   806→        ],\n   807→      ];\n   808→    }\n   809→\n   810→    return [\n   811→      '#type' => 'container',\n   812→      '#attributes' => ['class' => ['migrate-pager']],\n   813→    ] + $links;\n   814→  }\n   815→\n   816→  /**\n   817→   * Gets a human-readable status label for a row status.\n   818→   *\n   819→   * @param int $status\n   820→   *   The source_row_status value.\n   821→   *\n   822→   * @return string\n   823→   *   The status label.\n   824→   */\n   825→  protected function getRowStatusLabel(int $status): string {\n   826→    $labels = [\n   827→      0 => (string) $this->t('Imported'),\n   828→      1 => (string) $this->t('Needs update'),\n   829→      2 => (string) $this->t('Failed'),\n   830→    ];\n   831→\n   832→    return $labels[$status] ?? (string) $this->t('Unknown');\n   833→  }\n   834→\n   835→  /**\n   836→   * Gets a severity icon for a message level.\n   837→   *\n   838→   * @param int $level\n   839→   *   The RFC 5424 severity level.\n   840→   *\n   841→   * @return string\n   842→   *   HTML markup for the severity icon.\n   843→   */\n   844→  protected function getSeverityIcon(int $level): string {\n   845→    // RFC 5424 levels: 3=error, 4=warning, 5=notice, 6=info, 7=debug.\n   846→    if ($level <= 3) {\n   847→      return '<span class=\"badge color--error\">' . $this->t('Error') . '</span>';\n   848→    }\n   849→    elseif ($level <= 4) {\n   850→      return '<span class=\"badge color--warning\">' . $this->t('Warning') . '</span>';\n   851→    }\n   852→    return '<span class=\"badge color--success\">' . $this->t('Notice') . '</span>';\n   853→  }\n   854→\n   855→  /**\n   856→   * Attempts to build a link to the destination entity.\n   857→   *\n   858→   * @param string $migrationId\n   859→   *   The migration ID.\n   860→   * @param string $destId\n   861→   *   The destination entity ID.\n   862→   *\n   863→   * @return string|null\n   864→   *   The HTML link markup, or NULL if not possible.\n   865→   */\n   866→  protected function buildEntityLink(string $migrationId, string $destId): ?string {\n   867→    try {\n   868→      $migrations = $this->migrationPluginManager->createInstances([$migrationId]);\n   869→      if (empty($migrations[$migrationId])) {\n   870→        return NULL;\n   871→      }\n   872→      $migration = $migrations[$migrationId];\n   873→      $definition = $migration->getPluginDefinition();\n   874→      $destPlugin = $definition['destination']['plugin'] ?? '';\n   875→\n   876→      // Extract entity type from destination plugin (e.g., 'entity:node').\n   877→      if (str_starts_with($destPlugin, 'entity:')) {\n   878→        $entityTypeId = substr($destPlugin, 7);\n   879→        $entityTypeManager = \\Drupal::entityTypeManager();\n   880→        if ($entityTypeManager->hasDefinition($entityTypeId)) {\n   881→          $entity = $entityTypeManager->getStorage($entityTypeId)->load($destId);\n   882→          if ($entity && $entity->hasLinkTemplate('canonical')) {\n   883→            $url = $entity->toUrl()->toString();\n   884→            $label = method_exists($entity, 'label') ? $entity->label() : $destId;\n   885→            return '<a href=\"' . $url . '\">' . htmlspecialchars((string) $label, ENT_QUOTES) . ' (' . $destId . ')</a>';\n   886→          }\n   887→        }\n   888→      }\n   889→    }\n   890→    catch (\\Exception $e) {\n   891→      // Fall through to return NULL.\n   892→    }\n   893→\n   894→    return NULL;\n   895→  }\n   896→\n   897→}\n   898→"}]},"parent_tool_use_id":"toolu_01YQpbM5YUa7uWExQhuuSjjV","session_id":"8ff06007-d15b-4e19-9bb5-ef9d85432d82","uuid":"0c6150eb-612e-48f3-9d56-9d5740e262c0"}
