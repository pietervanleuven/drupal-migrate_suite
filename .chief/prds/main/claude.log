{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FgpwNnuhbrSf5cfqFkBvmW","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_admin\\Controller;\n     6→\n     7→use Drupal\\Core\\Controller\\ControllerBase;\n     8→use Drupal\\Core\\Database\\Connection;\n     9→use Drupal\\Core\\Datetime\\DateFormatterInterface;\n    10→use Drupal\\Core\\Url;\n    11→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    12→use Drupal\\migrate_permissions\\MigrateAccessCheck;\n    13→use Symfony\\Component\\DependencyInjection\\ContainerInterface;\n    14→use Symfony\\Component\\HttpFoundation\\Request;\n    15→use Symfony\\Component\\HttpKernel\\Exception\\AccessDeniedHttpException;\n    16→use Symfony\\Component\\HttpKernel\\Exception\\NotFoundHttpException;\n    17→\n    18→/**\n    19→ * Controller for the migration detail page.\n    20→ */\n    21→class MigrationDetailController extends ControllerBase {\n    22→\n    23→  /**\n    24→   * Number of items per page.\n    25→   */\n    26→  protected const ITEMS_PER_PAGE = 50;\n    27→\n    28→  /**\n    29→   * Constructs a MigrationDetailController object.\n    30→   *\n    31→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    32→   *   The migration plugin manager.\n    33→   * @param \\Drupal\\Core\\Database\\Connection $database\n    34→   *   The database connection.\n    35→   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n    36→   *   The date formatter service.\n    37→   */\n    38→  public function __construct(\n    39→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    40→    protected readonly Connection $database,\n    41→    protected readonly DateFormatterInterface $dateFormatter,\n    42→    protected readonly ?MigrateAccessCheck $migrateAccessCheck,\n    43→  ) {}\n    44→\n    45→  /**\n    46→   * {@inheritdoc}\n    47→   */\n    48→  public static function create(ContainerInterface $container): static {\n    49→    $migrateAccessCheck = $container->get('module_handler')->moduleExists('migrate_permissions')\n    50→      ? $container->get('migrate_permissions.access_check')\n    51→      : NULL;\n    52→\n    53→    return new static(\n    54→      $container->get('plugin.manager.migration'),\n    55→      $container->get('database'),\n    56→      $container->get('date.formatter'),\n    57→      $migrateAccessCheck,\n    58→    );\n    59→  }\n    60→\n    61→  /**\n    62→   * Builds the migration detail page.\n    63→   *\n    64→   * @param string $migration_id\n    65→   *   The migration plugin ID.\n    66→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n    67→   *   The current request.\n    68→   *\n    69→   * @return array\n    70→   *   A render array.\n    71→   */\n    72→  public function detail(string $migration_id, Request $request): array {\n    73→    $migration = $this->loadMigration($migration_id);\n    74→\n    75→    $definition = $migration->getPluginDefinition();\n    76→    $group = $definition['migration_group'] ?? 'default';\n    77→    $sourcePlugin = $definition['source']['plugin'] ?? $this->t('Unknown');\n    78→    $destinationPlugin = $definition['destination']['plugin'] ?? $this->t('Unknown');\n    79→\n    80→    // Get status.\n    81→    $status = $this->getMigrationStatus($migration);\n    82→\n    83→    // Get last run stats.\n    84→    $lastRun = $this->getLastRunStats($migration_id);\n    85→\n    86→    // Build summary section.\n    87→    $build = [];\n    88→\n    89→    $build['summary'] = [\n    90→      '#type' => 'details',\n    91→      '#title' => $this->t('Summary'),\n    92→      '#open' => TRUE,\n    93→      'table' => [\n    94→        '#type' => 'table',\n    95→        '#rows' => [\n    96→          [$this->t('Migration'), $migration->label() ?: $migration_id],\n    97→          [$this->t('Group'), $group],\n    98→          [$this->t('Source plugin'), $sourcePlugin],\n    99→          [$this->t('Destination plugin'), $destinationPlugin],\n   100→          [$this->t('Status'), $this->buildStatusBadge($status)],\n   101→          [$this->t('Last run'), $lastRun ? $this->buildLastRunSummary($lastRun) : $this->t('Never')],\n   102→        ],\n   103→      ],\n   104→    ];\n   105→\n   106→    // Build tabs.\n   107→    $build['tabs'] = [\n   108→      '#type' => 'container',\n   109→      '#attributes' => ['class' => ['migrate-detail-tabs']],\n   110→      'items_tab' => [\n   111→        '#type' => 'html_tag',\n   112→        '#tag' => 'a',\n   113→        '#value' => $this->t('Imported Items'),\n   114→        '#attributes' => [\n   115→          'href' => Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migration_id])->toString(),\n   116→          'class' => ['migrate-tab', 'migrate-tab--active'],\n   117→        ],\n   118→      ],\n   119→      'messages_tab' => [\n   120→        '#type' => 'html_tag',\n   121→        '#tag' => 'a',\n   122→        '#value' => $this->t('Messages'),\n   123→        '#attributes' => [\n   124→          'href' => Url::fromRoute('migrate_admin.migration_messages', ['migration_id' => $migration_id])->toString(),\n   125→          'class' => ['migrate-tab'],\n   126→        ],\n   127→      ],\n   128→    ];\n   129→\n   130→    // Build imported items section.\n   131→    $build['items'] = $this->buildImportedItemsSection($migration_id, $request);\n   132→\n   133→    $build['#attached'] = [\n   134→      'library' => ['migrate_admin/dashboard'],\n   135→    ];\n   136→    $build['#cache'] = [\n   137→      'contexts' => ['url.query_args', 'url.path'],\n   138→      'tags' => ['migration_plugins'],\n   139→    ];\n   140→\n   141→    return $build;\n   142→  }\n   143→\n   144→  /**\n   145→   * Builds the migration messages page.\n   146→   *\n   147→   * @param string $migration_id\n   148→   *   The migration plugin ID.\n   149→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   150→   *   The current request.\n   151→   *\n   152→   * @return array\n   153→   *   A render array.\n   154→   */\n   155→  public function messages(string $migration_id, Request $request): array {\n   156→    $migration = $this->loadMigration($migration_id);\n   157→\n   158→    $build = [];\n   159→\n   160→    // Build tabs.\n   161→    $build['tabs'] = [\n   162→      '#type' => 'container',\n   163→      '#attributes' => ['class' => ['migrate-detail-tabs']],\n   164→      'items_tab' => [\n   165→        '#type' => 'html_tag',\n   166→        '#tag' => 'a',\n   167→        '#value' => $this->t('Imported Items'),\n   168→        '#attributes' => [\n   169→          'href' => Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migration_id])->toString(),\n   170→          'class' => ['migrate-tab'],\n   171→        ],\n   172→      ],\n   173→      'messages_tab' => [\n   174→        '#type' => 'html_tag',\n   175→        '#tag' => 'a',\n   176→        '#value' => $this->t('Messages'),\n   177→        '#attributes' => [\n   178→          'href' => Url::fromRoute('migrate_admin.migration_messages', ['migration_id' => $migration_id])->toString(),\n   179→          'class' => ['migrate-tab', 'migrate-tab--active'],\n   180→        ],\n   181→      ],\n   182→    ];\n   183→\n   184→    // Build messages section.\n   185→    $build['messages'] = $this->buildMessagesSection($migration_id, $request);\n   186→\n   187→    $build['#attached'] = [\n   188→      'library' => ['migrate_admin/dashboard'],\n   189→    ];\n   190→    $build['#cache'] = [\n   191→      'contexts' => ['url.query_args', 'url.path'],\n   192→      'tags' => ['migration_plugins'],\n   193→    ];\n   194→\n   195→    return $build;\n   196→  }\n   197→\n   198→  /**\n   199→   * Loads a migration plugin or throws 404.\n   200→   *\n   201→   * @param string $migration_id\n   202→   *   The migration plugin ID.\n   203→   *\n   204→   * @return \\Drupal\\migrate\\Plugin\\MigrationInterface\n   205→   *   The migration plugin instance.\n   206→   *\n   207→   * @throws \\Symfony\\Component\\HttpKernel\\Exception\\NotFoundHttpException\n   208→   */\n   209→  protected function loadMigration(string $migration_id) {\n   210→    $migrations = $this->migrationPluginManager->createInstances([$migration_id]);\n   211→    if (empty($migrations[$migration_id])) {\n   212→      throw new NotFoundHttpException();\n   213→    }\n   214→\n   215→    // Check per-migration view permission if migrate_permissions is enabled.\n   216→    if ($this->migrateAccessCheck !== NULL && !$this->migrateAccessCheck->canViewMigration($this->currentUser(), $migration_id)) {\n   217→      throw new AccessDeniedHttpException();\n   218→    }\n   219→\n   220→    return $migrations[$migration_id];\n   221→  }\n   222→\n   223→  /**\n   224→   * Gets the current status of a migration.\n   225→   *\n   226→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   227→   *   The migration plugin instance.\n   228→   *\n   229→   * @return string\n   230→   *   The status string.\n   231→   */\n   232→  protected function getMigrationStatus($migration): string {\n   233→    $statusString = (string) $migration->getStatusLabel();\n   234→    $statusMap = [\n   235→      'Idle' => 'idle',\n   236→      'Importing' => 'importing',\n   237→      'Rolling back' => 'rolling_back',\n   238→      'Stopping' => 'idle',\n   239→      'Disabled' => 'idle',\n   240→    ];\n   241→\n   242→    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n   243→\n   244→    if ($migrationStatus === 'idle') {\n   245→      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   246→        ->fields('r', ['status'])\n   247→        ->condition('migration_id', $migration->id())\n   248→        ->orderBy('id', 'DESC')\n   249→        ->range(0, 1)\n   250→        ->execute()\n   251→        ->fetchField();\n   252→\n   253→      if ($lastRun === 'completed') {\n   254→        $migrationStatus = 'completed';\n   255→      }\n   256→      elseif ($lastRun === 'failed') {\n   257→        $migrationStatus = 'failed';\n   258→      }\n   259→    }\n   260→\n   261→    return $migrationStatus;\n   262→  }\n   263→\n   264→  /**\n   265→   * Gets the last run stats from the run log.\n   266→   *\n   267→   * @param string $migrationId\n   268→   *   The migration ID.\n   269→   *\n   270→   * @return object|null\n   271→   *   The last run log row, or NULL if never run.\n   272→   */\n   273→  protected function getLastRunStats(string $migrationId): ?object {\n   274→    $result = $this->database->select('migrate_suite_run_log', 'r')\n   275→      ->fields('r')\n   276→      ->condition('migration_id', $migrationId)\n   277→      ->orderBy('id', 'DESC')\n   278→      ->range(0, 1)\n   279→      ->execute()\n   280→      ->fetchObject();\n   281→\n   282→    return $result ?: NULL;\n   283→  }\n   284→\n   285→  /**\n   286→   * Builds a summary string for the last run.\n   287→   *\n   288→   * @param object $lastRun\n   289→   *   The last run log row.\n   290→   *\n   291→   * @return string\n   292→   *   A formatted summary string.\n   293→   */\n   294→  protected function buildLastRunSummary(object $lastRun): string {\n   295→    $started = $this->dateFormatter->format((int) $lastRun->started, 'short');\n   296→    $parts = [$this->t('Started: @date', ['@date' => $started])];\n   297→\n   298→    if ($lastRun->finished) {\n   299→      $finished = $this->dateFormatter->format((int) $lastRun->finished, 'short');\n   300→      $parts[] = $this->t('Finished: @date', ['@date' => $finished]);\n   301→    }\n   302→\n   303→    $parts[] = $this->t('Processed: @count', ['@count' => $lastRun->items_processed]);\n   304→    $parts[] = $this->t('Created: @count', ['@count' => $lastRun->items_created]);\n   305→    $parts[] = $this->t('Updated: @count', ['@count' => $lastRun->items_updated]);\n   306→    $parts[] = $this->t('Failed: @count', ['@count' => $lastRun->items_failed]);\n   307→\n   308→    return implode(' | ', $parts);\n   309→  }\n   310→\n   311→  /**\n   312→   * Builds a colored status badge.\n   313→   *\n   314→   * @param string $status\n   315→   *   The migration status.\n   316→   *\n   317→   * @return array\n   318→   *   A render array with the badge markup.\n   319→   */\n   320→  protected function buildStatusBadge(string $status): array {\n   321→    $labels = [\n   322→      'idle' => $this->t('Idle'),\n   323→      'importing' => $this->t('Importing'),\n   324→      'rolling_back' => $this->t('Rolling back'),\n   325→      'completed' => $this->t('Completed'),\n   326→      'failed' => $this->t('Failed'),\n   327→    ];\n   328→\n   329→    $colors = [\n   330→      'idle' => 'color--success',\n   331→      'importing' => 'color--primary',\n   332→      'rolling_back' => 'color--warning',\n   333→      'completed' => 'color--success',\n   334→      'failed' => 'color--error',\n   335→    ];\n   336→\n   337→    $label = $labels[$status] ?? $status;\n   338→    $colorClass = $colors[$status] ?? '';\n   339→\n   340→    return [\n   341→      'data' => [\n   342→        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n   343→      ],\n   344→    ];\n   345→  }\n   346→\n   347→  /**\n   348→   * Builds the imported items section with filters and pager.\n   349→   *\n   350→   * @param string $migrationId\n   351→   *   The migration ID.\n   352→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   353→   *   The current request.\n   354→   *\n   355→   * @return array\n   356→   *   A render array.\n   357→   */\n   358→  protected function buildImportedItemsSection(string $migrationId, Request $request): array {\n   359→    $search = $request->query->get('search', '');\n   360→    $statusFilter = $request->query->get('status', '');\n   361→    $page = max(0, (int) $request->query->get('page', 0));\n   362→\n   363→    $table = 'migrate_map_' . $migrationId;\n   364→    if (!$this->database->schema()->tableExists($table)) {\n   365→      return [\n   366→        '#markup' => '<p>' . $this->t('No map table exists for this migration. The migration may not have been run yet.') . '</p>',\n   367→      ];\n   368→    }\n   369→\n   370→    // Build the query.\n   371→    $query = $this->database->select($table, 'map')\n   372→      ->fields('map');\n   373→\n   374→    // Apply status filter.\n   375→    $statusMap = [\n   376→      'imported' => 0,\n   377→      'needs_update' => 1,\n   378→      'failed' => 2,\n   379→    ];\n   380→    if ($statusFilter !== '' && isset($statusMap[$statusFilter])) {\n   381→      $query->condition('source_row_status', $statusMap[$statusFilter]);\n   382→    }\n   383→\n   384→    // Apply search filter on source IDs.\n   385→    if ($search !== '') {\n   386→      $or = $query->orConditionGroup();\n   387→      // Search across sourceid columns (up to 5).\n   388→      for ($i = 1; $i <= 5; $i++) {\n   389→        $col = 'sourceid' . $i;\n   390→        if ($this->database->schema()->fieldExists($table, $col)) {\n   391→          $or->condition($col, '%' . $this->database->escapeLike($search) . '%', 'LIKE');\n   392→        }\n   393→      }\n   394→      $query->condition($or);\n   395→    }\n   396→\n   397→    // Count total for pager.\n   398→    $countQuery = clone $query;\n   399→    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n   400→\n   401→    // Apply pager.\n   402→    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n   403→    $query->orderBy('last_imported', 'DESC');\n   404→\n   405→    $rows = $query->execute()->fetchAll();\n   406→\n   407→    // Detect source ID and destination ID columns.\n   408→    $sourceIdCols = [];\n   409→    $destIdCols = [];\n   410→    for ($i = 1; $i <= 9; $i++) {\n   411→      if ($this->database->schema()->fieldExists($table, 'sourceid' . $i)) {\n   412→        $sourceIdCols[] = 'sourceid' . $i;\n   413→      }\n   414→      if ($this->database->schema()->fieldExists($table, 'destid' . $i)) {\n   415→        $destIdCols[] = 'destid' . $i;\n   416→      }\n   417→    }\n   418→\n   419→    // Build filter form.\n   420→    $build = [];\n   421→    $build['filters'] = $this->buildItemFilterForm($migrationId, $search, $statusFilter);\n   422→\n   423→    // Build table rows.\n   424→    $tableRows = [];\n   425→    foreach ($rows as $row) {\n   426→      $sourceIds = [];\n   427→      foreach ($sourceIdCols as $col) {\n   428→        if (isset($row->$col) && $row->$col !== NULL) {\n   429→          $sourceIds[] = $row->$col;\n   430→        }\n   431→      }\n   432→\n   433→      $destIds = [];\n   434→      foreach ($destIdCols as $col) {\n   435→        if (isset($row->$col) && $row->$col !== NULL) {\n   436→          $destIds[] = $row->$col;\n   437→        }\n   438→      }\n   439→\n   440→      $destDisplay = implode(', ', $destIds) ?: $this->t('N/A');\n   441→\n   442→      // Try to link to the entity if we have a single destination ID.\n   443→      if (count($destIds) === 1) {\n   444→        $destDisplay = $this->buildEntityLink($migrationId, (string) $destIds[0]) ?: $destDisplay;\n   445→      }\n   446→\n   447→      $statusLabel = $this->getRowStatusLabel((int) $row->source_row_status);\n   448→\n   449→      $lastImported = !empty($row->last_imported)\n   450→        ? $this->dateFormatter->format((int) $row->last_imported, 'short')\n   451→        : $this->t('Unknown');\n   452→\n   453→      $tableRows[] = [\n   454→        implode(', ', $sourceIds),\n   455→        ['data' => ['#markup' => (string) $destDisplay]],\n   456→        $statusLabel,\n   457→        $lastImported,\n   458→      ];\n   459→    }\n   460→\n   461→    $build['table'] = [\n   462→      '#type' => 'table',\n   463→      '#header' => [\n   464→        $this->t('Source ID(s)'),\n   465→        $this->t('Destination entity'),\n   466→        $this->t('Status'),\n   467→        $this->t('Last import'),\n   468→      ],\n   469→      '#rows' => $tableRows,\n   470→      '#empty' => $this->t('No imported items found.'),\n   471→    ];\n   472→\n   473→    // Build pager.\n   474→    if ($total > self::ITEMS_PER_PAGE) {\n   475→      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request);\n   476→    }\n   477→\n   478→    return $build;\n   479→  }\n   480→\n   481→  /**\n   482→   * Builds the messages section with filters and pager.\n   483→   *\n   484→   * @param string $migrationId\n   485→   *   The migration ID.\n   486→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   487→   *   The current request.\n   488→   *\n   489→   * @return array\n   490→   *   A render array.\n   491→   */\n   492→  protected function buildMessagesSection(string $migrationId, Request $request): array {\n   493→    $severityFilter = $request->query->get('severity', '');\n   494→    $page = max(0, (int) $request->query->get('page', 0));\n   495→\n   496→    $table = 'migrate_message_' . $migrationId;\n   497→    if (!$this->database->schema()->tableExists($table)) {\n   498→      return [\n   499→        '#markup' => '<p>' . $this->t('No message table exists for this migration.') . '</p>',\n   500→      ];\n   501→    }\n   502→\n   503→    $query = $this->database->select($table, 'msg')\n   504→      ->fields('msg');\n   505→\n   506→    // Apply severity filter.\n   507→    $severityMap = [\n   508→      'notice' => 6,\n   509→      'warning' => 4,\n   510→      'error' => 3,\n   511→    ];\n   512→    if ($severityFilter !== '' && isset($severityMap[$severityFilter])) {\n   513→      $query->condition('level', $severityMap[$severityFilter]);\n   514→    }\n   515→\n   516→    // Count total for pager.\n   517→    $countQuery = clone $query;\n   518→    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n   519→\n   520→    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n   521→    $rows = $query->execute()->fetchAll();\n   522→\n   523→    // Detect source ID columns.\n   524→    $sourceIdCols = [];\n   525→    for ($i = 1; $i <= 9; $i++) {\n   526→      $col = 'src_' . $i;\n   527→      if ($this->database->schema()->fieldExists($table, $col)) {\n   528→        $sourceIdCols[] = $col;\n   529→      }\n   530→    }\n   531→\n   532→    // Build severity filter.\n   533→    $build = [];\n   534→    $build['filters'] = $this->buildMessageFilterForm($migrationId, $severityFilter);\n   535→\n   536→    // Build table rows.\n   537→    $tableRows = [];\n   538→    foreach ($rows as $row) {\n   539→      $sourceIds = [];\n   540→      foreach ($sourceIdCols as $col) {\n   541→        if (isset($row->$col) && $row->$col !== NULL) {\n   542→          $sourceIds[] = $row->$col;\n   543→        }\n   544→      }\n   545→\n   546→      $severityIcon = $this->getSeverityIcon((int) $row->level);\n   547→\n   548→      $tableRows[] = [\n   549→        implode(', ', $sourceIds),\n   550→        ['data' => ['#markup' => $severityIcon]],\n   551→        $row->message ?? '',\n   552→      ];\n   553→    }\n   554→\n   555→    $build['table'] = [\n   556→      '#type' => 'table',\n   557→      '#header' => [\n   558→        $this->t('Source ID(s)'),\n   559→        $this->t('Severity'),\n   560→        $this->t('Message'),\n   561→      ],\n   562→      '#rows' => $tableRows,\n   563→      '#empty' => $this->t('No messages found.'),\n   564→    ];\n   565→\n   566→    // Build pager.\n   567→    if ($total > self::ITEMS_PER_PAGE) {\n   568→      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request, 'messages');\n   569→    }\n   570→\n   571→    return $build;\n   572→  }\n   573→\n   574→  /**\n   575→   * Builds the filter form for imported items.\n   576→   *\n   577→   * @param string $migrationId\n   578→   *   The migration ID.\n   579→   * @param string $search\n   580→   *   Current search value.\n   581→   * @param string $statusFilter\n   582→   *   Current status filter.\n   583→   *\n   584→   * @return array\n   585→   *   A render array.\n   586→   */\n   587→  protected function buildItemFilterForm(string $migrationId, string $search, string $statusFilter): array {\n   588→    $statusOptions = [\n   589→      '' => $this->t('- All statuses -'),\n   590→      'imported' => $this->t('Imported'),\n   591→      'needs_update' => $this->t('Needs update'),\n   592→      'failed' => $this->t('Failed'),\n   593→    ];\n   594→\n   595→    return [\n   596→      '#type' => 'container',\n   597→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   598→      'form' => [\n   599→        '#type' => 'html_tag',\n   600→        '#tag' => 'form',\n   601→        '#attributes' => [\n   602→          'method' => 'get',\n   603→          'class' => ['migrate-dashboard-filter-form'],\n   604→        ],\n   605→        'search' => [\n   606→          '#type' => 'html_tag',\n   607→          '#tag' => 'div',\n   608→          '#attributes' => ['class' => ['form-item']],\n   609→          'label' => [\n   610→            '#type' => 'html_tag',\n   611→            '#tag' => 'label',\n   612→            '#attributes' => ['for' => 'edit-search'],\n   613→            '#value' => $this->t('Source ID'),\n   614→          ],\n   615→          'input' => [\n   616→            '#type' => 'html_tag',\n   617→            '#tag' => 'input',\n   618→            '#attributes' => [\n   619→              'type' => 'text',\n   620→              'name' => 'search',\n   621→              'id' => 'edit-search',\n   622→              'value' => $search,\n   623→              'placeholder' => $this->t('Search source ID'),\n   624→              'class' => ['form-text'],\n   625→            ],\n   626→          ],\n   627→        ],\n   628→        'status' => [\n   629→          '#type' => 'html_tag',\n   630→          '#tag' => 'div',\n   631→          '#attributes' => ['class' => ['form-item']],\n   632→          'label' => [\n   633→            '#type' => 'html_tag',\n   634→            '#tag' => 'label',\n   635→            '#attributes' => ['for' => 'edit-status'],\n   636→            '#value' => $this->t('Status'),\n   637→          ],\n   638→          'select' => [\n   639→            '#type' => 'html_tag',\n   640→            '#tag' => 'select',\n   641→            '#attributes' => [\n   642→              'name' => 'status',\n   643→              'id' => 'edit-status',\n   644→              'class' => ['form-select'],\n   645→            ],\n   646→            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n   647→          ],\n   648→        ],\n   649→        'actions' => [\n   650→          '#type' => 'html_tag',\n   651→          '#tag' => 'div',\n   652→          '#attributes' => ['class' => ['form-actions']],\n   653→          'submit' => [\n   654→            '#type' => 'html_tag',\n   655→            '#tag' => 'input',\n   656→            '#attributes' => [\n   657→              'type' => 'submit',\n   658→              'value' => $this->t('Filter'),\n   659→              'class' => ['button', 'button--primary'],\n   660→            ],\n   661→          ],\n   662→        ],\n   663→      ],\n   664→    ];\n   665→  }\n   666→\n   667→  /**\n   668→   * Builds the filter form for messages.\n   669→   *\n   670→   * @param string $migrationId\n   671→   *   The migration ID.\n   672→   * @param string $severityFilter\n   673→   *   Current severity filter.\n   674→   *\n   675→   * @return array\n   676→   *   A render array.\n   677→   */\n   678→  protected function buildMessageFilterForm(string $migrationId, string $severityFilter): array {\n   679→    $severityOptions = [\n   680→      '' => $this->t('- All severities -'),\n   681→      'notice' => $this->t('Notice'),\n   682→      'warning' => $this->t('Warning'),\n   683→      'error' => $this->t('Error'),\n   684→    ];\n   685→\n   686→    return [\n   687→      '#type' => 'container',\n   688→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   689→      'form' => [\n   690→        '#type' => 'html_tag',\n   691→        '#tag' => 'form',\n   692→        '#attributes' => [\n   693→          'method' => 'get',\n   694→          'class' => ['migrate-dashboard-filter-form'],\n   695→        ],\n   696→        'severity' => [\n   697→          '#type' => 'html_tag',\n   698→          '#tag' => 'div',\n   699→          '#attributes' => ['class' => ['form-item']],\n   700→          'label' => [\n   701→            '#type' => 'html_tag',\n   702→            '#tag' => 'label',\n   703→            '#attributes' => ['for' => 'edit-severity'],\n   704→            '#value' => $this->t('Severity'),\n   705→          ],\n   706→          'select' => [\n   707→            '#type' => 'html_tag',\n   708→            '#tag' => 'select',\n   709→            '#attributes' => [\n   710→              'name' => 'severity',\n   711→              'id' => 'edit-severity',\n   712→              'class' => ['form-select'],\n   713→            ],\n   714→            'options' => $this->buildSelectOptions($severityOptions, $severityFilter),\n   715→          ],\n   716→        ],\n   717→        'actions' => [\n   718→          '#type' => 'html_tag',\n   719→          '#tag' => 'div',\n   720→          '#attributes' => ['class' => ['form-actions']],\n   721→          'submit' => [\n   722→            '#type' => 'html_tag',\n   723→            '#tag' => 'input',\n   724→            '#attributes' => [\n   725→              'type' => 'submit',\n   726→              'value' => $this->t('Filter'),\n   727→              'class' => ['button', 'button--primary'],\n   728→            ],\n   729→          ],\n   730→        ],\n   731→      ],\n   732→    ];\n   733→  }\n   734→\n   735→  /**\n   736→   * Builds select option elements.\n   737→   *\n   738→   * @param array $options\n   739→   *   The options array.\n   740→   * @param string $selectedValue\n   741→   *   The currently selected value.\n   742→   *\n   743→   * @return array\n   744→   *   A render array of option elements.\n   745→   */\n   746→  protected function buildSelectOptions(array $options, string $selectedValue): array {\n   747→    $elements = [];\n   748→    foreach ($options as $value => $label) {\n   749→      $attributes = ['value' => $value];\n   750→      if ((string) $value === $selectedValue) {\n   751→        $attributes['selected'] = 'selected';\n   752→      }\n   753→      $elements[] = [\n   754→        '#type' => 'html_tag',\n   755→        '#tag' => 'option',\n   756→        '#attributes' => $attributes,\n   757→        '#value' => $label,\n   758→      ];\n   759→    }\n   760→    return $elements;\n   761→  }\n   762→\n   763→  /**\n   764→   * Builds a simple pager.\n   765→   *\n   766→   * @param string $migrationId\n   767→   *   The migration ID.\n   768→   * @param int $currentPage\n   769→   *   The current page number (0-indexed).\n   770→   * @param int $total\n   771→   *   The total number of items.\n   772→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   773→   *   The current request.\n   774→   * @param string $tab\n   775→   *   The current tab ('items' or 'messages').\n   776→   *\n   777→   * @return array\n   778→   *   A render array for the pager.\n   779→   */\n   780→  protected function buildPager(string $migrationId, int $currentPage, int $total, Request $request, string $tab = 'items'): array {\n   781→    $totalPages = (int) ceil($total / self::ITEMS_PER_PAGE);\n   782→    $route = $tab === 'messages' ? 'migrate_admin.migration_messages' : 'migrate_admin.migration_detail';\n   783→\n   784→    $queryParams = $request->query->all();\n   785→    $links = [];\n   786→\n   787→    if ($currentPage > 0) {\n   788→      $queryParams['page'] = $currentPage - 1;\n   789→      $links['previous'] = [\n   790→        '#type' => 'html_tag',\n   791→        '#tag' => 'a',\n   792→        '#value' => $this->t('Previous'),\n   793→        '#attributes' => [\n   794→          'href' => Url::fromRoute($route, ['migration_id' => $migrationId], ['query' => $queryParams])->toString(),\n   795→          'class' => ['button'],\n   796→        ],\n   797→      ];\n   798→    }\n   799→\n   800→    $links['info'] = [\n   801→      '#type' => 'html_tag',\n   802→      '#tag' => 'span',\n   803→      '#value' => $this->t('Page @current of @total (@items items)', [\n   804→        '@current' => $currentPage + 1,\n   805→        '@total' => $totalPages,\n   806→        '@items' => $total,\n   807→      ]),\n   808→      '#attributes' => ['class' => ['migrate-pager-info']],\n   809→    ];\n   810→\n   811→    if ($currentPage < $totalPages - 1) {\n   812→      $queryParams['page'] = $currentPage + 1;\n   813→      $links['next'] = [\n   814→        '#type' => 'html_tag',\n   815→        '#tag' => 'a',\n   816→        '#value' => $this->t('Next'),\n   817→        '#attributes' => [\n   818→          'href' => Url::fromRoute($route, ['migration_id' => $migrationId], ['query' => $queryParams])->toString(),\n   819→          'class' => ['button'],\n   820→        ],\n   821→      ];\n   822→    }\n   823→\n   824→    return [\n   825→      '#type' => 'container',\n   826→      '#attributes' => ['class' => ['migrate-pager']],\n   827→    ] + $links;\n   828→  }\n   829→\n   830→  /**\n   831→   * Gets a human-readable status label for a row status.\n   832→   *\n   833→   * @param int $status\n   834→   *   The source_row_status value.\n   835→   *\n   836→   * @return string\n   837→   *   The status label.\n   838→   */\n   839→  protected function getRowStatusLabel(int $status): string {\n   840→    $labels = [\n   841→      0 => (string) $this->t('Imported'),\n   842→      1 => (string) $this->t('Needs update'),\n   843→      2 => (string) $this->t('Failed'),\n   844→    ];\n   845→\n   846→    return $labels[$status] ?? (string) $this->t('Unknown');\n   847→  }\n   848→\n   849→  /**\n   850→   * Gets a severity icon for a message level.\n   851→   *\n   852→   * @param int $level\n   853→   *   The RFC 5424 severity level.\n   854→   *\n   855→   * @return string\n   856→   *   HTML markup for the severity icon.\n   857→   */\n   858→  protected function getSeverityIcon(int $level): string {\n   859→    // RFC 5424 levels: 3=error, 4=warning, 5=notice, 6=info, 7=debug.\n   860→    if ($level <= 3) {\n   861→      return '<span class=\"badge color--error\">' . $this->t('Error') . '</span>';\n   862→    }\n   863→    elseif ($level <= 4) {\n   864→      return '<span class=\"badge color--warning\">' . $this->t('Warning') . '</span>';\n   865→    }\n   866→    return '<span class=\"badge color--success\">' . $this->t('Notice') . '</span>';\n   867→  }\n   868→\n   869→  /**\n   870→   * Attempts to build a link to the destination entity.\n   871→   *\n   872→   * @param string $migrationId\n   873→   *   The migration ID.\n   874→   * @param string $destId\n   875→   *   The destination entity ID.\n   876→   *\n   877→   * @return string|null\n   878→   *   The HTML link markup, or NULL if not possible.\n   879→   */\n   880→  protected function buildEntityLink(string $migrationId, string $destId): ?string {\n   881→    try {\n   882→      $migrations = $this->migrationPluginManager->createInstances([$migrationId]);\n   883→      if (empty($migrations[$migrationId])) {\n   884→        return NULL;\n   885→      }\n   886→      $migration = $migrations[$migrationId];\n   887→      $definition = $migration->getPluginDefinition();\n   888→      $destPlugin = $definition['destination']['plugin'] ?? '';\n   889→\n   890→      // Extract entity type from destination plugin (e.g., 'entity:node').\n   891→      if (str_starts_with($destPlugin, 'entity:')) {\n   892→        $entityTypeId = substr($destPlugin, 7);\n   893→        $entityTypeManager = \\Drupal::entityTypeManager();\n   894→        if ($entityTypeManager->hasDefinition($entityTypeId)) {\n   895→          $entity = $entityTypeManager->getStorage($entityTypeId)->load($destId);\n   896→          if ($entity && $entity->hasLinkTemplate('canonical')) {\n   897→            $url = $entity->toUrl()->toString();\n   898→            $label = method_exists($entity, 'label') ? $entity->label() : $destId;\n   899→            return '<a href=\"' . $url . '\">' . htmlspecialchars((string) $label, ENT_QUOTES) . ' (' . $destId . ')</a>';\n   900→          }\n   901→        }\n   902→      }\n   903→    }\n   904→    catch (\\Exception $e) {\n   905→      // Fall through to return NULL.\n   906→    }\n   907→\n   908→    return NULL;\n   909→  }\n   910→\n   911→}\n   912→"}]},"parent_tool_use_id":null,"session_id":"804c2cf8-5541-47a7-a331-3655bdfe0e70","uuid":"2a9fa4d7-e2bb-4425-ace0-c7f5d8bc6ad6","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_admin/src/Controller/MigrationDetailController.php","content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace Drupal\\migrate_admin\\Controller;\n\nuse Drupal\\Core\\Controller\\ControllerBase;\nuse Drupal\\Core\\Database\\Connection;\nuse Drupal\\Core\\Datetime\\DateFormatterInterface;\nuse Drupal\\Core\\Url;\nuse Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\nuse Drupal\\migrate_permissions\\MigrateAccessCheck;\nuse Symfony\\Component\\DependencyInjection\\ContainerInterface;\nuse Symfony\\Component\\HttpFoundation\\Request;\nuse Symfony\\Component\\HttpKernel\\Exception\\AccessDeniedHttpException;\nuse Symfony\\Component\\HttpKernel\\Exception\\NotFoundHttpException;\n\n/**\n * Controller for the migration detail page.\n */\nclass MigrationDetailController extends ControllerBase {\n\n  /**\n   * Number of items per page.\n   */\n  protected const ITEMS_PER_PAGE = 50;\n\n  /**\n   * Constructs a MigrationDetailController object.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n   *   The migration plugin manager.\n   * @param \\Drupal\\Core\\Database\\Connection $database\n   *   The database connection.\n   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n   *   The date formatter service.\n   */\n  public function __construct(\n    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    protected readonly Connection $database,\n    protected readonly DateFormatterInterface $dateFormatter,\n    protected readonly ?MigrateAccessCheck $migrateAccessCheck,\n  ) {}\n\n  /**\n   * {@inheritdoc}\n   */\n  public static function create(ContainerInterface $container): static {\n    $migrateAccessCheck = $container->get('module_handler')->moduleExists('migrate_permissions')\n      ? $container->get('migrate_permissions.access_check')\n      : NULL;\n\n    return new static(\n      $container->get('plugin.manager.migration'),\n      $container->get('database'),\n      $container->get('date.formatter'),\n      $migrateAccessCheck,\n    );\n  }\n\n  /**\n   * Builds the migration detail page.\n   *\n   * @param string $migration_id\n   *   The migration plugin ID.\n   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   *   The current request.\n   *\n   * @return array\n   *   A render array.\n   */\n  public function detail(string $migration_id, Request $request): array {\n    $migration = $this->loadMigration($migration_id);\n\n    $definition = $migration->getPluginDefinition();\n    $group = $definition['migration_group'] ?? 'default';\n    $sourcePlugin = $definition['source']['plugin'] ?? $this->t('Unknown');\n    $destinationPlugin = $definition['destination']['plugin'] ?? $this->t('Unknown');\n\n    // Get status.\n    $status = $this->getMigrationStatus($migration);\n\n    // Get last run stats.\n    $lastRun = $this->getLastRunStats($migration_id);\n\n    // Build summary section.\n    $build = [];\n\n    $build['summary'] = [\n      '#type' => 'details',\n      '#title' => $this->t('Summary'),\n      '#open' => TRUE,\n      'table' => [\n        '#type' => 'table',\n        '#rows' => [\n          [$this->t('Migration'), $migration->label() ?: $migration_id],\n          [$this->t('Group'), $group],\n          [$this->t('Source plugin'), $sourcePlugin],\n          [$this->t('Destination plugin'), $destinationPlugin],\n          [$this->t('Status'), $this->buildStatusBadge($status)],\n          [$this->t('Last run'), $lastRun ? $this->buildLastRunSummary($lastRun) : $this->t('Never')],\n        ],\n      ],\n    ];\n\n    // Build tabs.\n    $build['tabs'] = [\n      '#type' => 'container',\n      '#attributes' => ['class' => ['migrate-detail-tabs']],\n      'items_tab' => [\n        '#type' => 'html_tag',\n        '#tag' => 'a',\n        '#value' => $this->t('Imported Items'),\n        '#attributes' => [\n          'href' => Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migration_id])->toString(),\n          'class' => ['migrate-tab', 'migrate-tab--active'],\n        ],\n      ],\n      'messages_tab' => [\n        '#type' => 'html_tag',\n        '#tag' => 'a',\n        '#value' => $this->t('Messages'),\n        '#attributes' => [\n          'href' => Url::fromRoute('migrate_admin.migration_messages', ['migration_id' => $migration_id])->toString(),\n          'class' => ['migrate-tab'],\n        ],\n      ],\n    ];\n\n    // Build imported items section.\n    $build['items'] = $this->buildImportedItemsSection($migration_id, $request);\n\n    $build['#attached'] = [\n      'library' => ['migrate_admin/dashboard'],\n    ];\n    $build['#cache'] = [\n      'contexts' => ['url.query_args', 'url.path'],\n      'tags' => ['migration_plugins'],\n    ];\n\n    return $build;\n  }\n\n  /**\n   * Builds the migration messages page.\n   *\n   * @param string $migration_id\n   *   The migration plugin ID.\n   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   *   The current request.\n   *\n   * @return array\n   *   A render array.\n   */\n  public function messages(string $migration_id, Request $request): array {\n    $migration = $this->loadMigration($migration_id);\n\n    $build = [];\n\n    // Build tabs.\n    $build['tabs'] = [\n      '#type' => 'container',\n      '#attributes' => ['class' => ['migrate-detail-tabs']],\n      'items_tab' => [\n        '#type' => 'html_tag',\n        '#tag' => 'a',\n        '#value' => $this->t('Imported Items'),\n        '#attributes' => [\n          'href' => Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migration_id])->toString(),\n          'class' => ['migrate-tab'],\n        ],\n      ],\n      'messages_tab' => [\n        '#type' => 'html_tag',\n        '#tag' => 'a',\n        '#value' => $this->t('Messages'),\n        '#attributes' => [\n          'href' => Url::fromRoute('migrate_admin.migration_messages', ['migration_id' => $migration_id])->toString(),\n          'class' => ['migrate-tab', 'migrate-tab--active'],\n        ],\n      ],\n    ];\n\n    // Build messages section.\n    $build['messages'] = $this->buildMessagesSection($migration_id, $request);\n\n    $build['#attached'] = [\n      'library' => ['migrate_admin/dashboard'],\n    ];\n    $build['#cache'] = [\n      'contexts' => ['url.query_args', 'url.path'],\n      'tags' => ['migration_plugins'],\n    ];\n\n    return $build;\n  }\n\n  /**\n   * Loads a migration plugin or throws 404.\n   *\n   * @param string $migration_id\n   *   The migration plugin ID.\n   *\n   * @return \\Drupal\\migrate\\Plugin\\MigrationInterface\n   *   The migration plugin instance.\n   *\n   * @throws \\Symfony\\Component\\HttpKernel\\Exception\\NotFoundHttpException\n   */\n  protected function loadMigration(string $migration_id) {\n    $migrations = $this->migrationPluginManager->createInstances([$migration_id]);\n    if (empty($migrations[$migration_id])) {\n      throw new NotFoundHttpException();\n    }\n\n    // Check per-migration view permission if migrate_permissions is enabled.\n    if ($this->migrateAccessCheck !== NULL && !$this->migrateAccessCheck->canViewMigration($this->currentUser(), $migration_id)) {\n      throw new AccessDeniedHttpException();\n    }\n\n    return $migrations[$migration_id];\n  }\n\n  /**\n   * Gets the current status of a migration.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   *   The migration plugin instance.\n   *\n   * @return string\n   *   The status string.\n   */\n  protected function getMigrationStatus($migration): string {\n    $statusString = (string) $migration->getStatusLabel();\n    $statusMap = [\n      'Idle' => 'idle',\n      'Importing' => 'importing',\n      'Rolling back' => 'rolling_back',\n      'Stopping' => 'idle',\n      'Disabled' => 'idle',\n    ];\n\n    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n\n    if ($migrationStatus === 'idle') {\n      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n        ->fields('r', ['status'])\n        ->condition('migration_id', $migration->id())\n        ->orderBy('id', 'DESC')\n        ->range(0, 1)\n        ->execute()\n        ->fetchField();\n\n      if ($lastRun === 'completed') {\n        $migrationStatus = 'completed';\n      }\n      elseif ($lastRun === 'failed') {\n        $migrationStatus = 'failed';\n      }\n    }\n\n    return $migrationStatus;\n  }\n\n  /**\n   * Gets the last run stats from the run log.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   *\n   * @return object|null\n   *   The last run log row, or NULL if never run.\n   */\n  protected function getLastRunStats(string $migrationId): ?object {\n    $result = $this->database->select('migrate_suite_run_log', 'r')\n      ->fields('r')\n      ->condition('migration_id', $migrationId)\n      ->orderBy('id', 'DESC')\n      ->range(0, 1)\n      ->execute()\n      ->fetchObject();\n\n    return $result ?: NULL;\n  }\n\n  /**\n   * Builds a summary string for the last run.\n   *\n   * @param object $lastRun\n   *   The last run log row.\n   *\n   * @return string\n   *   A formatted summary string.\n   */\n  protected function buildLastRunSummary(object $lastRun): string {\n    $started = $this->dateFormatter->format((int) $lastRun->started, 'short');\n    $parts = [$this->t('Started: @date', ['@date' => $started])];\n\n    if ($lastRun->finished) {\n      $finished = $this->dateFormatter->format((int) $lastRun->finished, 'short');\n      $parts[] = $this->t('Finished: @date', ['@date' => $finished]);\n    }\n\n    $parts[] = $this->t('Processed: @count', ['@count' => $lastRun->items_processed]);\n    $parts[] = $this->t('Created: @count', ['@count' => $lastRun->items_created]);\n    $parts[] = $this->t('Updated: @count', ['@count' => $lastRun->items_updated]);\n    $parts[] = $this->t('Failed: @count', ['@count' => $lastRun->items_failed]);\n\n    return implode(' | ', $parts);\n  }\n\n  /**\n   * Builds a colored status badge.\n   *\n   * @param string $status\n   *   The migration status.\n   *\n   * @return array\n   *   A render array with the badge markup.\n   */\n  protected function buildStatusBadge(string $status): array {\n    $labels = [\n      'idle' => $this->t('Idle'),\n      'importing' => $this->t('Importing'),\n      'rolling_back' => $this->t('Rolling back'),\n      'completed' => $this->t('Completed'),\n      'failed' => $this->t('Failed'),\n    ];\n\n    $colors = [\n      'idle' => 'color--success',\n      'importing' => 'color--primary',\n      'rolling_back' => 'color--warning',\n      'completed' => 'color--success',\n      'failed' => 'color--error',\n    ];\n\n    $label = $labels[$status] ?? $status;\n    $colorClass = $colors[$status] ?? '';\n\n    return [\n      'data' => [\n        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n      ],\n    ];\n  }\n\n  /**\n   * Builds the imported items section with filters and pager.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   *   The current request.\n   *\n   * @return array\n   *   A render array.\n   */\n  protected function buildImportedItemsSection(string $migrationId, Request $request): array {\n    $search = $request->query->get('search', '');\n    $statusFilter = $request->query->get('status', '');\n    $page = max(0, (int) $request->query->get('page', 0));\n\n    $table = 'migrate_map_' . $migrationId;\n    if (!$this->database->schema()->tableExists($table)) {\n      return [\n        '#markup' => '<p>' . $this->t('No map table exists for this migration. The migration may not have been run yet.') . '</p>',\n      ];\n    }\n\n    // Build the query.\n    $query = $this->database->select($table, 'map')\n      ->fields('map');\n\n    // Apply status filter.\n    $statusMap = [\n      'imported' => 0,\n      'needs_update' => 1,\n      'failed' => 2,\n    ];\n    if ($statusFilter !== '' && isset($statusMap[$statusFilter])) {\n      $query->condition('source_row_status', $statusMap[$statusFilter]);\n    }\n\n    // Apply search filter on source IDs.\n    if ($search !== '') {\n      $or = $query->orConditionGroup();\n      // Search across sourceid columns (up to 5).\n      for ($i = 1; $i <= 5; $i++) {\n        $col = 'sourceid' . $i;\n        if ($this->database->schema()->fieldExists($table, $col)) {\n          $or->condition($col, '%' . $this->database->escapeLike($search) . '%', 'LIKE');\n        }\n      }\n      $query->condition($or);\n    }\n\n    // Count total for pager.\n    $countQuery = clone $query;\n    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n\n    // Apply pager.\n    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n    $query->orderBy('last_imported', 'DESC');\n\n    $rows = $query->execute()->fetchAll();\n\n    // Detect source ID and destination ID columns.\n    $sourceIdCols = [];\n    $destIdCols = [];\n    for ($i = 1; $i <= 9; $i++) {\n      if ($this->database->schema()->fieldExists($table, 'sourceid' . $i)) {\n        $sourceIdCols[] = 'sourceid' . $i;\n      }\n      if ($this->database->schema()->fieldExists($table, 'destid' . $i)) {\n        $destIdCols[] = 'destid' . $i;\n      }\n    }\n\n    // Build filter form.\n    $build = [];\n    $build['filters'] = $this->buildItemFilterForm($migrationId, $search, $statusFilter);\n\n    // Build table rows.\n    $tableRows = [];\n    foreach ($rows as $row) {\n      $sourceIds = [];\n      foreach ($sourceIdCols as $col) {\n        if (isset($row->$col) && $row->$col !== NULL) {\n          $sourceIds[] = $row->$col;\n        }\n      }\n\n      $destIds = [];\n      foreach ($destIdCols as $col) {\n        if (isset($row->$col) && $row->$col !== NULL) {\n          $destIds[] = $row->$col;\n        }\n      }\n\n      $destDisplay = implode(', ', $destIds) ?: $this->t('N/A');\n\n      // Try to link to the entity if we have a single destination ID.\n      if (count($destIds) === 1) {\n        $destDisplay = $this->buildEntityLink($migrationId, (string) $destIds[0]) ?: $destDisplay;\n      }\n\n      $statusLabel = $this->getRowStatusLabel((int) $row->source_row_status);\n\n      $lastImported = !empty($row->last_imported)\n        ? $this->dateFormatter->format((int) $row->last_imported, 'short')\n        : $this->t('Unknown');\n\n      $tableRows[] = [\n        implode(', ', $sourceIds),\n        ['data' => ['#markup' => (string) $destDisplay]],\n        $statusLabel,\n        $lastImported,\n      ];\n    }\n\n    $build['table'] = [\n      '#type' => 'table',\n      '#header' => [\n        $this->t('Source ID(s)'),\n        $this->t('Destination entity'),\n        $this->t('Status'),\n        $this->t('Last import'),\n      ],\n      '#rows' => $tableRows,\n      '#empty' => $this->t('No imported items found.'),\n    ];\n\n    // Build pager.\n    if ($total > self::ITEMS_PER_PAGE) {\n      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request);\n    }\n\n    return $build;\n  }\n\n  /**\n   * Builds the messages section with filters and pager.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   *   The current request.\n   *\n   * @return array\n   *   A render array.\n   */\n  protected function buildMessagesSection(string $migrationId, Request $request): array {\n    $severityFilter = $request->query->get('severity', '');\n    $page = max(0, (int) $request->query->get('page', 0));\n\n    $table = 'migrate_message_' . $migrationId;\n    if (!$this->database->schema()->tableExists($table)) {\n      return [\n        '#markup' => '<p>' . $this->t('No message table exists for this migration.') . '</p>',\n      ];\n    }\n\n    $query = $this->database->select($table, 'msg')\n      ->fields('msg');\n\n    // Apply severity filter.\n    $severityMap = [\n      'notice' => 6,\n      'warning' => 4,\n      'error' => 3,\n    ];\n    if ($severityFilter !== '' && isset($severityMap[$severityFilter])) {\n      $query->condition('level', $severityMap[$severityFilter]);\n    }\n\n    // Count total for pager.\n    $countQuery = clone $query;\n    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n\n    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n    $rows = $query->execute()->fetchAll();\n\n    // Detect source ID columns.\n    $sourceIdCols = [];\n    for ($i = 1; $i <= 9; $i++) {\n      $col = 'src_' . $i;\n      if ($this->database->schema()->fieldExists($table, $col)) {\n        $sourceIdCols[] = $col;\n      }\n    }\n\n    // Build severity filter.\n    $build = [];\n    $build['filters'] = $this->buildMessageFilterForm($migrationId, $severityFilter);\n\n    // Build table rows.\n    $tableRows = [];\n    foreach ($rows as $row) {\n      $sourceIds = [];\n      foreach ($sourceIdCols as $col) {\n        if (isset($row->$col) && $row->$col !== NULL) {\n          $sourceIds[] = $row->$col;\n        }\n      }\n\n      $severityIcon = $this->getSeverityIcon((int) $row->level);\n\n      $tableRows[] = [\n        implode(', ', $sourceIds),\n        ['data' => ['#markup' => $severityIcon]],\n        $row->message ?? '',\n      ];\n    }\n\n    $build['table'] = [\n      '#type' => 'table',\n      '#header' => [\n        $this->t('Source ID(s)'),\n        $this->t('Severity'),\n        $this->t('Message'),\n      ],\n      '#rows' => $tableRows,\n      '#empty' => $this->t('No messages found.'),\n    ];\n\n    // Build pager.\n    if ($total > self::ITEMS_PER_PAGE) {\n      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request, 'messages');\n    }\n\n    return $build;\n  }\n\n  /**\n   * Builds the filter form for imported items.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   * @param string $search\n   *   Current search value.\n   * @param string $statusFilter\n   *   Current status filter.\n   *\n   * @return array\n   *   A render array.\n   */\n  protected function buildItemFilterForm(string $migrationId, string $search, string $statusFilter): array {\n    $statusOptions = [\n      '' => $this->t('- All statuses -'),\n      'imported' => $this->t('Imported'),\n      'needs_update' => $this->t('Needs update'),\n      'failed' => $this->t('Failed'),\n    ];\n\n    return [\n      '#type' => 'container',\n      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n      'form' => [\n        '#type' => 'html_tag',\n        '#tag' => 'form',\n        '#attributes' => [\n          'method' => 'get',\n          'class' => ['migrate-dashboard-filter-form'],\n        ],\n        'search' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-search'],\n            '#value' => $this->t('Source ID'),\n          ],\n          'input' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'text',\n              'name' => 'search',\n              'id' => 'edit-search',\n              'value' => $search,\n              'placeholder' => $this->t('Search source ID'),\n              'class' => ['form-text'],\n            ],\n          ],\n        ],\n        'status' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-status'],\n            '#value' => $this->t('Status'),\n          ],\n          'select' => [\n            '#type' => 'html_tag',\n            '#tag' => 'select',\n            '#attributes' => [\n              'name' => 'status',\n              'id' => 'edit-status',\n              'class' => ['form-select'],\n            ],\n            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n          ],\n        ],\n        'actions' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-actions']],\n          'submit' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'submit',\n              'value' => $this->t('Filter'),\n              'class' => ['button', 'button--primary'],\n            ],\n          ],\n        ],\n      ],\n    ];\n  }\n\n  /**\n   * Builds the filter form for messages.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   * @param string $severityFilter\n   *   Current severity filter.\n   *\n   * @return array\n   *   A render array.\n   */\n  protected function buildMessageFilterForm(string $migrationId, string $severityFilter): array {\n    $severityOptions = [\n      '' => $this->t('- All severities -'),\n      'notice' => $this->t('Notice'),\n      'warning' => $this->t('Warning'),\n      'error' => $this->t('Error'),\n    ];\n\n    return [\n      '#type' => 'container',\n      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n      'form' => [\n        '#type' => 'html_tag',\n        '#tag' => 'form',\n        '#attributes' => [\n          'method' => 'get',\n          'class' => ['migrate-dashboard-filter-form'],\n        ],\n        'severity' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-severity'],\n            '#value' => $this->t('Severity'),\n          ],\n          'select' => [\n            '#type' => 'html_tag',\n            '#tag' => 'select',\n            '#attributes' => [\n              'name' => 'severity',\n              'id' => 'edit-severity',\n              'class' => ['form-select'],\n            ],\n            'options' => $this->buildSelectOptions($severityOptions, $severityFilter),\n          ],\n        ],\n        'actions' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-actions']],\n          'submit' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'submit',\n              'value' => $this->t('Filter'),\n              'class' => ['button', 'button--primary'],\n            ],\n          ],\n        ],\n      ],\n    ];\n  }\n\n  /**\n   * Builds select option elements.\n   *\n   * @param array $options\n   *   The options array.\n   * @param string $selectedValue\n   *   The currently selected value.\n   *\n   * @return array\n   *   A render array of option elements.\n   */\n  protected function buildSelectOptions(array $options, string $selectedValue): array {\n    $elements = [];\n    foreach ($options as $value => $label) {\n      $attributes = ['value' => $value];\n      if ((string) $value === $selectedValue) {\n        $attributes['selected'] = 'selected';\n      }\n      $elements[] = [\n        '#type' => 'html_tag',\n        '#tag' => 'option',\n        '#attributes' => $attributes,\n        '#value' => $label,\n      ];\n    }\n    return $elements;\n  }\n\n  /**\n   * Builds a simple pager.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   * @param int $currentPage\n   *   The current page number (0-indexed).\n   * @param int $total\n   *   The total number of items.\n   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   *   The current request.\n   * @param string $tab\n   *   The current tab ('items' or 'messages').\n   *\n   * @return array\n   *   A render array for the pager.\n   */\n  protected function buildPager(string $migrationId, int $currentPage, int $total, Request $request, string $tab = 'items'): array {\n    $totalPages = (int) ceil($total / self::ITEMS_PER_PAGE);\n    $route = $tab === 'messages' ? 'migrate_admin.migration_messages' : 'migrate_admin.migration_detail';\n\n    $queryParams = $request->query->all();\n    $links = [];\n\n    if ($currentPage > 0) {\n      $queryParams['page'] = $currentPage - 1;\n      $links['previous'] = [\n        '#type' => 'html_tag',\n        '#tag' => 'a',\n        '#value' => $this->t('Previous'),\n        '#attributes' => [\n          'href' => Url::fromRoute($route, ['migration_id' => $migrationId], ['query' => $queryParams])->toString(),\n          'class' => ['button'],\n        ],\n      ];\n    }\n\n    $links['info'] = [\n      '#type' => 'html_tag',\n      '#tag' => 'span',\n      '#value' => $this->t('Page @current of @total (@items items)', [\n        '@current' => $currentPage + 1,\n        '@total' => $totalPages,\n        '@items' => $total,\n      ]),\n      '#attributes' => ['class' => ['migrate-pager-info']],\n    ];\n\n    if ($currentPage < $totalPages - 1) {\n      $queryParams['page'] = $currentPage + 1;\n      $links['next'] = [\n        '#type' => 'html_tag',\n        '#tag' => 'a',\n        '#value' => $this->t('Next'),\n        '#attributes' => [\n          'href' => Url::fromRoute($route, ['migration_id' => $migrationId], ['query' => $queryParams])->toString(),\n          'class' => ['button'],\n        ],\n      ];\n    }\n\n    return [\n      '#type' => 'container',\n      '#attributes' => ['class' => ['migrate-pager']],\n    ] + $links;\n  }\n\n  /**\n   * Gets a human-readable status label for a row status.\n   *\n   * @param int $status\n   *   The source_row_status value.\n   *\n   * @return string\n   *   The status label.\n   */\n  protected function getRowStatusLabel(int $status): string {\n    $labels = [\n      0 => (string) $this->t('Imported'),\n      1 => (string) $this->t('Needs update'),\n      2 => (string) $this->t('Failed'),\n    ];\n\n    return $labels[$status] ?? (string) $this->t('Unknown');\n  }\n\n  /**\n   * Gets a severity icon for a message level.\n   *\n   * @param int $level\n   *   The RFC 5424 severity level.\n   *\n   * @return string\n   *   HTML markup for the severity icon.\n   */\n  protected function getSeverityIcon(int $level): string {\n    // RFC 5424 levels: 3=error, 4=warning, 5=notice, 6=info, 7=debug.\n    if ($level <= 3) {\n      return '<span class=\"badge color--error\">' . $this->t('Error') . '</span>';\n    }\n    elseif ($level <= 4) {\n      return '<span class=\"badge color--warning\">' . $this->t('Warning') . '</span>';\n    }\n    return '<span class=\"badge color--success\">' . $this->t('Notice') . '</span>';\n  }\n\n  /**\n   * Attempts to build a link to the destination entity.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   * @param string $destId\n   *   The destination entity ID.\n   *\n   * @return string|null\n   *   The HTML link markup, or NULL if not possible.\n   */\n  protected function buildEntityLink(string $migrationId, string $destId): ?string {\n    try {\n      $migrations = $this->migrationPluginManager->createInstances([$migrationId]);\n      if (empty($migrations[$migrationId])) {\n        return NULL;\n      }\n      $migration = $migrations[$migrationId];\n      $definition = $migration->getPluginDefinition();\n      $destPlugin = $definition['destination']['plugin'] ?? '';\n\n      // Extract entity type from destination plugin (e.g., 'entity:node').\n      if (str_starts_with($destPlugin, 'entity:')) {\n        $entityTypeId = substr($destPlugin, 7);\n        $entityTypeManager = \\Drupal::entityTypeManager();\n        if ($entityTypeManager->hasDefinition($entityTypeId)) {\n          $entity = $entityTypeManager->getStorage($entityTypeId)->load($destId);\n          if ($entity && $entity->hasLinkTemplate('canonical')) {\n            $url = $entity->toUrl()->toString();\n            $label = method_exists($entity, 'label') ? $entity->label() : $destId;\n            return '<a href=\"' . $url . '\">' . htmlspecialchars((string) $label, ENT_QUOTES) . ' (' . $destId . ')</a>';\n          }\n        }\n      }\n    }\n    catch (\\Exception $e) {\n      // Fall through to return NULL.\n    }\n\n    return NULL;\n  }\n\n}\n","numLines":912,"startLine":1,"totalLines":912}}}
