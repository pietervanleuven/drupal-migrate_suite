y {\n    54→    $table = $this->getMapTableName($migrationId);\n    55→\n    56→    if (!$this->database->schema()->tableExists($table)) {\n    57→      return [];\n    58→    }\n    59→\n    60→    $query = $this->database->select($table, 'map')\n    61→      ->fields('map');\n    62→\n    63→    $index = 1;\n    64→    foreach ($sourceIdValues as $value) {\n    65→      $query->condition('sourceid' . $index, $value);\n    66→      $index++;\n    67→    }\n    68→\n    69→    $row = $query->execute()->fetchAssoc();\n    70→\n    71→    if (!$row) {\n    72→      return [];\n    73→    }\n    74→\n    75→    $destIds = [];\n    76→    foreach ($row as $key => $value) {\n    77→      if (str_starts_with($key, 'destid')) {\n    78→        $destIds[$key] = $value;\n    79→      }\n    80→    }\n    81→\n    82→    return $destIds;\n    83→  }\n    84→\n    85→  /**\n    86→   * Lists all imported items for a migration.\n    87→   *\n    88→   * @param string $migrationId\n    89→   *   The migration plugin ID.\n    90→   * @param int $limit\n    91→   *   The number of items to return.\n    92→   * @param int $offset\n    93→   *   The offset for pagination.\n    94→   *\n    95→   * @return array\n    96→   *   An array of map table rows.\n    97→   */\n    98→  public function listImportedItems(string $migrationId, int $limit = 50, int $offset = 0): array {\n    99→    $table = $this->getMapTableName($migrationId);\n   100→\n   101→    if (!$this->database->schema()->tableExists($table)) {\n   102→      return [];\n   103→    }\n   104→\n   105→    return $this->database->select($table, 'map')\n   106→      ->fields('map')\n   107→      ->range($offset, $limit)\n   108→      ->execute()\n   109→      ->fetchAll();\n   110→  }\n   111→\n   112→  /**\n   113→   * Counts items by status for a migration.\n   114→   *\n   115→   * @param string $migrationId\n   116→   *   The migration plugin ID.\n   117→   *\n   118→   * @return array\n   119→   *   An associative array with keys 'imported', 'needs_update', 'failed'\n   120→   *   and their respective counts.\n   121→   */\n   122→  public function countItemsByStatus(string $migrationId): array {\n   123→    $table = $this->getMapTableName($migrationId);\n   124→\n   125→    $counts = [\n   126→      'imported' => 0,\n   127→      'needs_update' => 0,\n   128→      'failed' => 0,\n   129→    ];\n   130→\n   131→    if (!$this->database->schema()->tableExists($table)) {\n   132→      return $counts;\n   133→    }\n   134→\n   135→    $results = $this->database->select($table, 'map')\n   136→      ->fields('map', ['source_row_status'])\n   137→      ->groupBy('source_row_status')\n   138→      ->addExpression('COUNT(*)', 'count')\n   139→      ->execute()\n   140→      ->fetchAllKeyed();\n   141→\n   142→    $statusMap = [\n   143→      (string) MigrateIdMapInterface::STATUS_IMPORTED => 'imported',\n   144→      (string) MigrateIdMapInterface::STATUS_NEEDS_UPDATE => 'needs_update',\n   145→      (string) MigrateIdMapInterface::STATUS_FAILED => 'failed',\n   146→    ];\n   147→\n   148→    foreach ($results as $status => $count) {\n   149→      $key = $statusMap[(string) $status] ?? NULL;\n   150→      if ($key !== NULL) {\n   151→        $counts[$key] = (int) $count;\n   152→      }\n   153→    }\n   154→\n   155→    return $counts;\n   156→  }\n   157→\n   158→}\n   159→"}]},"parent_tool_use_id":null,"session_id":"c2acd8b5-f80d-48c8-b462-6b0e23d48724","uuid":"08dca190-9add-44ac-8e95-4808194c1f9b","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/src/Service/MigrateMapQuery.php","content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace Drupal\\migrate_suite\\Service;\n\nuse Drupal\\Core\\Database\\Connection;\nuse Drupal\\migrate\\Plugin\\MigrateIdMapInterface;\nuse Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n\n/**\n * Service for querying migration map tables.\n */\nclass MigrateMapQuery {\n\n  /**\n   * Constructs a MigrateMapQuery object.\n   *\n   * @param \\Drupal\\Core\\Database\\Connection $database\n   *   The database connection.\n   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n   *   The migration plugin manager.\n   */\n  public function __construct(\n    protected readonly Connection $database,\n    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n  ) {}\n\n  /**\n   * Gets the map table name for a migration.\n   *\n   * @param string $migrationId\n   *   The migration plugin ID.\n   *\n   * @return string\n   *   The map table name.\n   */\n  protected function getMapTableName(string $migrationId): string {\n    return 'migrate_map_' . $migrationId;\n  }\n\n  /**\n   * Looks up destination IDs by source ID.\n   *\n   * @param string $migrationId\n   *   The migration plugin ID.\n   * @param array $sourceIdValues\n   *   The source ID values keyed by source ID field name.\n   *\n   * @return array\n   *   The destination ID values, or an empty array if not found.\n   */\n  public function lookupDestinationIds(string $migrationId, array $sourceIdValues): array {\n    $table = $this->getMapTableName($migrationId);\n\n    if (!$this->database->schema()->tableExists($table)) {\n      return [];\n    }\n\n    $query = $this->database->select($table, 'map')\n      ->fields('map');\n\n    $index = 1;\n    foreach ($sourceIdValues as $value) {\n      $query->condition('sourceid' . $index, $value);\n      $index++;\n    }\n\n    $row = $query->execute()->fetchAssoc();\n\n    if (!$row) {\n      return [];\n    }\n\n    $destIds = [];\n    foreach ($row as $key => $value) {\n      if (str_starts_with($key, 'destid')) {\n        $destIds[$key] = $value;\n      }\n    }\n\n    return $destIds;\n  }\n\n  /**\n   * Lists all imported items for a migration.\n   *\n   * @param string $migrationId\n   *   The migration plugin ID.\n   * @param int $limit\n   *   The number of items to return.\n   * @param int $offset\n   *   The offset for pagination.\n   *\n   * @return array\n   *   An array of map table rows.\n   */\n  public function listImportedItems(string $migrationId, int $limit = 50, int $offset = 0): array {\n    $table = $this->getMapTableName($migrationId);\n\n    if (!$this->database->schema()->tableExists($table)) {\n      return [];\n    }\n\n    return $this->database->select($table, 'map')\n      ->fields('map')\n      ->range($offset, $limit)\n      ->execute()\n      ->fetchAll();\n  }\n\n  /**\n   * Counts items by status for a migration.\n   *\n   * @param string $migrationId\n   *   The migration plugin ID.\n   *\n   * @return array\n   *   An associative array with keys 'imported', 'needs_update', 'failed'\n   *   and their respective counts.\n   */\n  public function countItemsByStatus(string $migrationId): array {\n    $table = $this->getMapTableName($migrationId);\n\n    $counts = [\n      'imported' => 0,\n      'needs_update' => 0,\n      'failed' => 0,\n    ];\n\n    if (!$this->database->schema()->tableExists($table)) {\n      return $counts;\n    }\n\n    $results = $this->database->select($table, 'map')\n      ->fields('map', ['source_row_status'])\n      ->groupBy('source_row_status')\n      ->addExpression('COUNT(*)', 'count')\n      ->execute()\n      ->fetchAllKeyed();\n\n    $statusMap = [\n      (string) MigrateIdMapInterface::STATUS_IMPORTED => 'imported',\n      (string) MigrateIdMapInterface::STATUS_NEEDS_UPDATE => 'needs_update',\n      (string) MigrateIdMapInterface::STATUS_FAILED => 'failed',\n    ];\n\n    foreach ($results as $status => $count) {\n      $key = $statusMap[(string) $status] ?? NULL;\n      if ($key !== NULL) {\n        $counts[$key] = (int) $count;\n      }\n    }\n\n    return $counts;\n  }\n\n}\n","numLines":159,"startLine":1,"totalLines":159}}}
