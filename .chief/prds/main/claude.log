 {\n    $statusString = (string) $migration->getStatusLabel();\n    $statusMap = [\n      'Idle' => 'idle',\n      'Importing' => 'importing',\n      'Rolling back' => 'rolling_back',\n      'Stopping' => 'idle',\n      'Disabled' => 'idle',","numLines":25,"startLine":209,"totalLines":906}}}
