{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_011Y7f3bo3eobux1eXqzdx6c","type":"message","role":"assistant","content":[{"type":"text","text":"Now let me create the module file with all the hooks."}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":311,"cache_read_input_tokens":66107,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":311},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"947754a4-35aa-442f-a4b8-f81a7a0a67f9","uuid":"3c6f21cc-2868-4a99-a6e7-e88b4fe41e96"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_011Y7f3bo3eobux1eXqzdx6c","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ku2nLpzrmdmMRASVyp8gTV","name":"Write","input":{"file_path":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_source_field/migrate_source_field.module","content":"<?php\n\n/**\n * @file\n * Provides migration provenance pseudo-field on migrated entities.\n */\n\ndeclare(strict_types=1);\n\nuse Drupal\\Core\\Entity\\Display\\EntityViewDisplayInterface;\nuse Drupal\\Core\\Entity\\EntityInterface;\nuse Drupal\\Core\\Form\\FormStateInterface;\nuse Drupal\\Core\\Url;\nuse Drupal\\node\\NodeInterface;\nuse Drupal\\node\\NodeTypeInterface;\n\n/**\n * Implements hook_entity_extra_field_info().\n */\nfunction migrate_source_field_entity_extra_field_info(): array {\n  $extra = [];\n\n  $nodeTypes = \\Drupal::entityTypeManager()\n    ->getStorage('node_type')\n    ->loadMultiple();\n\n  foreach ($nodeTypes as $nodeType) {\n    assert($nodeType instanceof NodeTypeInterface);\n    $extra['node'][$nodeType->id()]['display']['migrate_provenance'] = [\n      'label' => t('Migration provenance'),\n      'description' => t('Shows migration source information for imported content.'),\n      'weight' => 100,\n      'visible' => FALSE,\n    ];\n    $extra['node'][$nodeType->id()]['form']['migrate_provenance'] = [\n      'label' => t('Migration provenance'),\n      'description' => t('Shows migration source information for imported content.'),\n      'weight' => 100,\n      'visible' => FALSE,\n    ];\n  }\n\n  return $extra;\n}\n\n/**\n * Implements hook_ENTITY_TYPE_view() for node entities.\n */\nfunction migrate_source_field_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {\n  if (!$display->getComponent('migrate_provenance')) {\n    return;\n  }\n\n  $provenance = _migrate_source_field_get_provenance($entity);\n  if ($provenance === NULL) {\n    return;\n  }\n\n  $build['migrate_provenance'] = _migrate_source_field_build_provenance_display($provenance);\n  $build['migrate_provenance']['#cache'] = [\n    'tags' => ['migrate_source_field:provenance'],\n  ];\n}\n\n/**\n * Implements hook_form_BASE_FORM_ID_alter() for node forms.\n */\nfunction migrate_source_field_form_node_form_alter(array &$form, FormStateInterface $form_state): void {\n  /** @var \\Drupal\\node\\NodeInterface $node */\n  $node = $form_state->getFormObject()->getEntity();\n\n  if ($node->isNew()) {\n    return;\n  }\n\n  // Check if the pseudo-field is enabled on the form display.\n  $formDisplay = \\Drupal::entityTypeManager()\n    ->getStorage('entity_form_display')\n    ->load('node.' . $node->bundle() . '.default');\n\n  if (!$formDisplay || !$formDisplay->getComponent('migrate_provenance')) {\n    return;\n  }\n\n  $provenance = _migrate_source_field_get_provenance($node);\n  if ($provenance === NULL) {\n    return;\n  }\n\n  $form['migrate_provenance'] = _migrate_source_field_build_provenance_display($provenance);\n  $form['migrate_provenance']['#weight'] = 100;\n}\n\n/**\n * Gets provenance data for an entity.\n *\n * @param \\Drupal\\Core\\Entity\\EntityInterface $entity\n *   The entity.\n *\n * @return array|null\n *   Provenance data or NULL if not found.\n */\nfunction _migrate_source_field_get_provenance(EntityInterface $entity): ?array {\n  if (!$entity instanceof NodeInterface || $entity->isNew()) {\n    return NULL;\n  }\n\n  /** @var \\Drupal\\migrate_source_field\\Service\\ProvenanceLookup $provenanceLookup */\n  $provenanceLookup = \\Drupal::service('migrate_source_field.provenance_lookup');\n  return $provenanceLookup->lookupProvenance(\n    $entity->getEntityTypeId(),\n    $entity->id(),\n  );\n}\n\n/**\n * Builds the provenance display render array.\n *\n * @param array $provenance\n *   The provenance data from ProvenanceLookup.\n *\n * @return array\n *   A render array.\n */\nfunction _migrate_source_field_build_provenance_display(array $provenance): array {\n  $migrationLabel = $provenance['migration_label'];\n  $migrationId = $provenance['migration_id'];\n\n  // Link to detail page if user has permission.\n  $currentUser = \\Drupal::currentUser();\n  $hasDetailAccess = $currentUser->hasPermission('view migrate suite dashboard');\n  if ($hasDetailAccess) {\n    try {\n      $url = Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]);\n      $migrationLabel = '<a href=\"' . $url->toString() . '\">' . htmlspecialchars((string) $migrationLabel, ENT_QUOTES) . '</a>';\n    }\n    catch (\\Exception $e) {\n      // Route may not exist if migrate_admin is not installed.\n      $migrationLabel = htmlspecialchars((string) $migrationLabel, ENT_QUOTES);\n    }\n  }\n  else {\n    $migrationLabel = htmlspecialchars((string) $migrationLabel, ENT_QUOTES);\n  }\n\n  $rows = [\n    [t('Migration'), ['data' => ['#markup' => $migrationLabel]]],\n    [t('Source ID(s)'), implode(' / ', $provenance['source_ids'])],\n  ];\n\n  if ($provenance['last_imported'] !== NULL) {\n    $importDate = \\Drupal::service('date.formatter')\n      ->format($provenance['last_imported'], 'short');\n    $rows[] = [t('Import date'), $importDate];\n  }\n\n  return [\n    '#type' => 'details',\n    '#title' => t('Migration provenance'),\n    '#open' => TRUE,\n    'table' => [\n      '#type' => 'table',\n      '#rows' => $rows,\n    ],\n  ];\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":311,"cache_read_input_tokens":66107,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":311},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"947754a4-35aa-442f-a4b8-f81a7a0a67f9","uuid":"79c0e922-3966-446d-aeb1-b3e0d7100198"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ku2nLpzrmdmMRASVyp8gTV","type":"tool_result","content":"File created successfully at: /Users/pieter/Projects/drupal-migrate_suite/modules/migrate_source_field/migrate_source_field.module"}]},"parent_tool_use_id":null,"session_id":"947754a4-35aa-442f-a4b8-f81a7a0a67f9","uuid":"98cafbc5-426a-49d0-97ee-a37cbcc20968","tool_use_result":{"type":"create","filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_source_field/migrate_source_field.module","content":"<?php\n\n/**\n * @file\n * Provides migration provenance pseudo-field on migrated entities.\n */\n\ndeclare(strict_types=1);\n\nuse Drupal\\Core\\Entity\\Display\\EntityViewDisplayInterface;\nuse Drupal\\Core\\Entity\\EntityInterface;\nuse Drupal\\Core\\Form\\FormStateInterface;\nuse Drupal\\Core\\Url;\nuse Drupal\\node\\NodeInterface;\nuse Drupal\\node\\NodeTypeInterface;\n\n/**\n * Implements hook_entity_extra_field_info().\n */\nfunction migrate_source_field_entity_extra_field_info(): array {\n  $extra = [];\n\n  $nodeTypes = \\Drupal::entityTypeManager()\n    ->getStorage('node_type')\n    ->loadMultiple();\n\n  foreach ($nodeTypes as $nodeType) {\n    assert($nodeType instanceof NodeTypeInterface);\n    $extra['node'][$nodeType->id()]['display']['migrate_provenance'] = [\n      'label' => t('Migration provenance'),\n      'description' => t('Shows migration source information for imported content.'),\n      'weight' => 100,\n      'visible' => FALSE,\n    ];\n    $extra['node'][$nodeType->id()]['form']['migrate_provenance'] = [\n      'label' => t('Migration provenance'),\n      'description' => t('Shows migration source information for imported content.'),\n      'weight' => 100,\n      'visible' => FALSE,\n    ];\n  }\n\n  return $extra;\n}\n\n/**\n * Implements hook_ENTITY_TYPE_view() for node entities.\n */\nfunction migrate_source_field_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {\n  if (!$display->getComponent('migrate_provenance')) {\n    return;\n  }\n\n  $provenance = _migrate_source_field_get_provenance($entity);\n  if ($provenance === NULL) {\n    return;\n  }\n\n  $build['migrate_provenance'] = _migrate_source_field_build_provenance_display($provenance);\n  $build['migrate_provenance']['#cache'] = [\n    'tags' => ['migrate_source_field:provenance'],\n  ];\n}\n\n/**\n * Implements hook_form_BASE_FORM_ID_alter() for node forms.\n */\nfunction migrate_source_field_form_node_form_alter(array &$form, FormStateInterface $form_state): void {\n  /** @var \\Drupal\\node\\NodeInterface $node */\n  $node = $form_state->getFormObject()->getEntity();\n\n  if ($node->isNew()) {\n    return;\n  }\n\n  // Check if the pseudo-field is enabled on the form display.\n  $formDisplay = \\Drupal::entityTypeManager()\n    ->getStorage('entity_form_display')\n    ->load('node.' . $node->bundle() . '.default');\n\n  if (!$formDisplay || !$formDisplay->getComponent('migrate_provenance')) {\n    return;\n  }\n\n  $provenance = _migrate_source_field_get_provenance($node);\n  if ($provenance === NULL) {\n    return;\n  }\n\n  $form['migrate_provenance'] = _migrate_source_field_build_provenance_display($provenance);\n  $form['migrate_provenance']['#weight'] = 100;\n}\n\n/**\n * Gets provenance data for an entity.\n *\n * @param \\Drupal\\Core\\Entity\\EntityInterface $entity\n *   The entity.\n *\n * @return array|null\n *   Provenance data or NULL if not found.\n */\nfunction _migrate_source_field_get_provenance(EntityInterface $entity): ?array {\n  if (!$entity instanceof NodeInterface || $entity->isNew()) {\n    return NULL;\n  }\n\n  /** @var \\Drupal\\migrate_source_field\\Service\\ProvenanceLookup $provenanceLookup */\n  $provenanceLookup = \\Drupal::service('migrate_source_field.provenance_lookup');\n  return $provenanceLookup->lookupProvenance(\n    $entity->getEntityTypeId(),\n    $entity->id(),\n  );\n}\n\n/**\n * Builds the provenance display render array.\n *\n * @param array $provenance\n *   The provenance data from ProvenanceLookup.\n *\n * @return array\n *   A render array.\n */\nfunction _migrate_source_field_build_provenance_display(array $provenance): array {\n  $migrationLabel = $provenance['migration_label'];\n  $migrationId = $provenance['migration_id'];\n\n  // Link to detail page if user has permission.\n  $currentUser = \\Drupal::currentUser();\n  $hasDetailAccess = $currentUser->hasPermission('view migrate suite dashboard');\n  if ($hasDetailAccess) {\n    try {\n      $url = Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]);\n      $migrationLabel = '<a href=\"' . $url->toString() . '\">' . htmlspecialchars((string) $migrationLabel, ENT_QUOTES) . '</a>';\n    }\n    catch (\\Exception $e) {\n      // Route may not exist if migrate_admin is not installed.\n      $migrationLabel = htmlspecialchars((string) $migrationLabel, ENT_QUOTES);\n    }\n  }\n  else {\n    $migrationLabel = htmlspecialchars((string) $migrationLabel, ENT_QUOTES);\n  }\n\n  $rows = [\n    [t('Migration'), ['data' => ['#markup' => $migrationLabel]]],\n    [t('Source ID(s)'), implode(' / ', $provenance['source_ids'])],\n  ];\n\n  if ($provenance['last_imported'] !== NULL) {\n    $importDate = \\Drupal::service('date.formatter')\n      ->format($provenance['last_imported'], 'short');\n    $rows[] = [t('Import date'), $importDate];\n  }\n\n  return [\n    '#type' => 'details',\n    '#title' => t('Migration provenance'),\n    '#open' => TRUE,\n    'table' => [\n      '#type' => 'table',\n      '#rows' => $rows,\n    ],\n  ];\n}\n","structuredPatch":[],"originalFile":null}}
