{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cp1TemMHTrbvqxi32nEruM","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_admin\\Controller;\n     6→\n     7→use Drupal\\Core\\Controller\\ControllerBase;\n     8→use Drupal\\Core\\Database\\Connection;\n     9→use Drupal\\Core\\Datetime\\DateFormatterInterface;\n    10→use Drupal\\Core\\Extension\\ModuleHandlerInterface;\n    11→use Drupal\\Core\\Link;\n    12→use Drupal\\Core\\Url;\n    13→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    14→use Drupal\\migrate_permissions\\MigrateAccessCheck;\n    15→use Symfony\\Component\\DependencyInjection\\ContainerInterface;\n    16→use Symfony\\Component\\HttpFoundation\\Request;\n    17→\n    18→/**\n    19→ * Controller for the migration dashboard page.\n    20→ */\n    21→class MigrationDashboardController extends ControllerBase {\n    22→\n    23→  /**\n    24→   * Constructs a MigrationDashboardController object.\n    25→   *\n    26→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    27→   *   The migration plugin manager.\n    28→   * @param \\Drupal\\Core\\Database\\Connection $database\n    29→   *   The database connection.\n    30→   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n    31→   *   The date formatter service.\n    32→   */\n    33→  public function __construct(\n    34→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    35→    protected readonly Connection $database,\n    36→    protected readonly DateFormatterInterface $dateFormatter,\n    37→    protected readonly ModuleHandlerInterface $moduleHandler,\n    38→    protected readonly ?MigrateAccessCheck $migrateAccessCheck,\n    39→  ) {}\n    40→\n    41→  /**\n    42→   * {@inheritdoc}\n    43→   */\n    44→  public static function create(ContainerInterface $container): static {\n    45→    $migrateAccessCheck = $container->get('module_handler')->moduleExists('migrate_permissions')\n    46→      ? $container->get('migrate_permissions.access_check')\n    47→      : NULL;\n    48→\n    49→    return new static(\n    50→      $container->get('plugin.manager.migration'),\n    51→      $container->get('database'),\n    52→      $container->get('date.formatter'),\n    53→      $container->get('module_handler'),\n    54→      $migrateAccessCheck,\n    55→    );\n    56→  }\n    57→\n    58→  /**\n    59→   * Builds the migration dashboard page.\n    60→   *\n    61→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n    62→   *   The current request.\n    63→   *\n    64→   * @return array\n    65→   *   A render array.\n    66→   */\n    67→  public function dashboard(Request $request): array {\n    68→    $search = $request->query->get('search', '');\n    69→    $statusFilter = $request->query->get('status', '');\n    70→    $groupFilter = $request->query->get('group', '');\n    71→\n    72→    $migrations = $this->migrationPluginManager->createInstances([]);\n    73→\n    74→    if (empty($migrations)) {\n    75→      return [\n    76→        '#markup' => '<p>' . $this->t('No migrations are currently configured. Configure migrations using migration YAML files or Drush commands.') . '</p>',\n    77→      ];\n    78→    }\n    79→\n    80→    // Collect all groups for the filter dropdown.\n    81→    $allGroups = [];\n    82→    $groupedMigrations = [];\n    83→\n    84→    $account = $this->currentUser();\n    85→    $permissionsModuleEnabled = $this->migrateAccessCheck !== NULL;\n    86→\n    87→    foreach ($migrations as $migrationId => $migration) {\n    88→      // Apply per-migration view permission filter.\n    89→      if ($permissionsModuleEnabled && !$this->migrateAccessCheck->canViewMigration($account, $migrationId)) {\n    90→        continue;\n    91→      }\n    92→\n    93→      $label = $migration->label() ?: $migrationId;\n    94→      $definition = $migration->getPluginDefinition();\n    95→      $group = $definition['migration_group'] ?? 'default';\n    96→      $allGroups[$group] = $group;\n    97→\n    98→      // Apply text search filter.\n    99→      if ($search !== '' && stripos($migrationId, $search) === FALSE && stripos((string) $label, $search) === FALSE) {\n   100→        continue;\n   101→      }\n   102→\n   103→      // Get migration status.\n   104→      $status = $this->getMigrationStatus($migration);\n   105→\n   106→      // Apply status filter.\n   107→      if ($statusFilter !== '' && $status !== $statusFilter) {\n   108→        continue;\n   109→      }\n   110→\n   111→      // Apply group filter.\n   112→      if ($groupFilter !== '' && $group !== $groupFilter) {\n   113→        continue;\n   114→      }\n   115→\n   116→      // Get counts from map table.\n   117→      $counts = $this->getItemCounts($migrationId);\n   118→\n   119→      // Get source count.\n   120→      $sourceCount = $this->getSourceCount($migration);\n   121→\n   122→      // Get last run timestamp.\n   123→      $lastRun = $this->getLastRunTimestamp($migrationId);\n   124→\n   125→      $groupedMigrations[$group][$migrationId] = [\n   126→        'label' => $label,\n   127→        'group' => $group,\n   128→        'status' => $status,\n   129→        'source_count' => $sourceCount,\n   130→        'imported_count' => $counts['imported'],\n   131→        'failed_count' => $counts['failed'],\n   132→        'last_run' => $lastRun,\n   133→      ];\n   134→    }\n   135→\n   136→    ksort($allGroups);\n   137→\n   138→    $build = [];\n   139→\n   140→    // Filter form.\n   141→    $build['filters'] = $this->buildFilterForm($search, $statusFilter, $groupFilter, $allGroups);\n   142→\n   143→    // Build grouped tables.\n   144→    foreach ($groupedMigrations as $group => $groupMigrations) {\n   145→      $build['group_' . $group] = $this->buildGroupTable($group, $groupMigrations);\n   146→    }\n   147→\n   148→    if (empty($groupedMigrations)) {\n   149→      if ($permissionsModuleEnabled && $search === '' && $statusFilter === '' && $groupFilter === '') {\n   150→        $build['empty'] = [\n   151→          '#markup' => '<p>' . $this->t('You do not have permission to view any migrations. Contact your site administrator to grant you per-migration view permissions.') . '</p>',\n   152→        ];\n   153→      }\n   154→      else {\n   155→        $build['empty'] = [\n   156→          '#markup' => '<p>' . $this->t('No migrations match the current filters.') . '</p>',\n   157→        ];\n   158→      }\n   159→    }\n   160→\n   161→    $build['#attached'] = [\n   162→      'library' => ['migrate_admin/dashboard'],\n   163→    ];\n   164→    $build['#cache'] = [\n   165→      'contexts' => ['url.query_args'],\n   166→      'tags' => ['migration_plugins'],\n   167→    ];\n   168→\n   169→    return $build;\n   170→  }\n   171→\n   172→  /**\n   173→   * Gets the current status of a migration.\n   174→   *\n   175→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   176→   *   The migration plugin instance.\n   177→   *\n   178→   * @return string\n   179→   *   The status string: idle, importing, rolling_back, completed, or failed.\n   180→   */\n   181→  protected function getMigrationStatus($migration): string {\n   182→    $status = $migration->getStatusLabel();\n   183→\n   184→    // Map Drupal's status labels to our internal statuses.\n   185→    $statusString = (string) $status;\n   186→    $statusMap = [\n   187→      'Idle' => 'idle',\n   188→      'Importing' => 'importing',\n   189→      'Rolling back' => 'rolling_back',\n   190→      'Stopping' => 'idle',\n   191→      'Disabled' => 'idle',\n   192→    ];\n   193→\n   194→    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n   195→\n   196→    // Check run log for completed/failed status if currently idle.\n   197→    if ($migrationStatus === 'idle') {\n   198→      $migrationId = $migration->id();\n   199→      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   200→        ->fields('r', ['status'])\n   201→        ->condition('migration_id', $migrationId)\n   202→        ->orderBy('id', 'DESC')\n   203→        ->range(0, 1)\n   204→        ->execute()\n   205→        ->fetchField();\n   206→\n   207→      if ($lastRun === 'completed') {\n   208→        $migrationStatus = 'completed';\n   209→      }\n   210→      elseif ($lastRun === 'failed') {\n   211→        $migrationStatus = 'failed';\n   212→      }\n   213→    }\n   214→\n   215→    return $migrationStatus;\n   216→  }\n   217→\n   218→  /**\n   219→   * Gets item counts from the map table.\n   220→   *\n   221→   * @param string $migrationId\n   222→   *   The migration ID.\n   223→   *\n   224→   * @return array\n   225→   *   Associative array with 'imported', 'needs_update', 'failed' counts.\n   226→   */\n   227→  protected function getItemCounts(string $migrationId): array {\n   228→    $counts = [\n   229→      'imported' => 0,\n   230→      'needs_update' => 0,\n   231→      'failed' => 0,\n   232→    ];\n   233→\n   234→    $table = 'migrate_map_' . $migrationId;\n   235→    if (!$this->database->schema()->tableExists($table)) {\n   236→      return $counts;\n   237→    }\n   238→\n   239→    $results = $this->database->select($table, 'map')\n   240→      ->fields('map', ['source_row_status'])\n   241→      ->groupBy('source_row_status')\n   242→      ->addExpression('COUNT(*)', 'count')\n   243→      ->execute()\n   244→      ->fetchAllKeyed();\n   245→\n   246→    // Status constants: 0 = imported, 1 = needs_update, 2 = failed.\n   247→    $statusMap = [\n   248→      '0' => 'imported',\n   249→      '1' => 'needs_update',\n   250→      '2' => 'failed',\n   251→    ];\n   252→\n   253→    foreach ($results as $status => $count) {\n   254→      $key = $statusMap[(string) $status] ?? NULL;\n   255→      if ($key !== NULL) {\n   256→        $counts[$key] = (int) $count;\n   257→      }\n   258→    }\n   259→\n   260→    return $counts;\n   261→  }\n   262→\n   263→  /**\n   264→   * Gets the source count for a migration.\n   265→   *\n   266→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   267→   *   The migration plugin instance.\n   268→   *\n   269→   * @return int|string\n   270→   *   The source count or 'N/A' if unavailable.\n   271→   */\n   272→  protected function getSourceCount($migration): int|string {\n   273→    try {\n   274→      $source = $migration->getSourcePlugin();\n   275→      $count = $source->count();\n   276→      return $count === -1 ? 'N/A' : $count;\n   277→    }\n   278→    catch (\\Exception $e) {\n   279→      return 'N/A';\n   280→    }\n   281→  }\n   282→\n   283→  /**\n   284→   * Gets the last run timestamp for a migration.\n   285→   *\n   286→   * @param string $migrationId\n   287→   *   The migration ID.\n   288→   *\n   289→   * @return int|null\n   290→   *   The timestamp of the last run, or NULL if never run.\n   291→   */\n   292→  protected function getLastRunTimestamp(string $migrationId): ?int {\n   293→    $result = $this->database->select('migrate_suite_run_log', 'r')\n   294→      ->fields('r', ['started'])\n   295→      ->condition('migration_id', $migrationId)\n   296→      ->orderBy('id', 'DESC')\n   297→      ->range(0, 1)\n   298→      ->execute()\n   299→      ->fetchField();\n   300→\n   301→    return $result ? (int) $result : NULL;\n   302→  }\n   303→\n   304→  /**\n   305→   * Builds the filter form.\n   306→   *\n   307→   * @param string $search\n   308→   *   Current search value.\n   309→   * @param string $statusFilter\n   310→   *   Current status filter.\n   311→   * @param string $groupFilter\n   312→   *   Current group filter.\n   313→   * @param array $allGroups\n   314→   *   All available migration groups.\n   315→   *\n   316→   * @return array\n   317→   *   A render array for the filter form.\n   318→   */\n   319→  protected function buildFilterForm(string $search, string $statusFilter, string $groupFilter, array $allGroups): array {\n   320→    $statusOptions = [\n   321→      '' => $this->t('- All statuses -'),\n   322→      'idle' => $this->t('Idle'),\n   323→      'importing' => $this->t('Importing'),\n   324→      'rolling_back' => $this->t('Rolling back'),\n   325→      'completed' => $this->t('Completed'),\n   326→      'failed' => $this->t('Failed'),\n   327→    ];\n   328→\n   329→    $groupOptions = ['' => $this->t('- All groups -')];\n   330→    foreach ($allGroups as $group) {\n   331→      $groupOptions[$group] = $group;\n   332→    }\n   333→\n   334→    return [\n   335→      '#type' => 'container',\n   336→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   337→      'form' => [\n   338→        '#type' => 'html_tag',\n   339→        '#tag' => 'form',\n   340→        '#attributes' => [\n   341→          'method' => 'get',\n   342→          'class' => ['migrate-dashboard-filter-form'],\n   343→        ],\n   344→        'search' => [\n   345→          '#type' => 'html_tag',\n   346→          '#tag' => 'div',\n   347→          '#attributes' => ['class' => ['form-item']],\n   348→          'label' => [\n   349→            '#type' => 'html_tag',\n   350→            '#tag' => 'label',\n   351→            '#attributes' => ['for' => 'edit-search'],\n   352→            '#value' => $this->t('Search'),\n   353→          ],\n   354→          'input' => [\n   355→            '#type' => 'html_tag',\n   356→            '#tag' => 'input',\n   357→            '#attributes' => [\n   358→              'type' => 'text',\n   359→              'name' => 'search',\n   360→              'id' => 'edit-search',\n   361→              'value' => $search,\n   362→              'placeholder' => $this->t('Migration ID or label'),\n   363→              'class' => ['form-text'],\n   364→            ],\n   365→          ],\n   366→        ],\n   367→        'status' => [\n   368→          '#type' => 'html_tag',\n   369→          '#tag' => 'div',\n   370→          '#attributes' => ['class' => ['form-item']],\n   371→          'label' => [\n   372→            '#type' => 'html_tag',\n   373→            '#tag' => 'label',\n   374→            '#attributes' => ['for' => 'edit-status'],\n   375→            '#value' => $this->t('Status'),\n   376→          ],\n   377→          'select' => [\n   378→            '#type' => 'html_tag',\n   379→            '#tag' => 'select',\n   380→            '#attributes' => [\n   381→              'name' => 'status',\n   382→              'id' => 'edit-status',\n   383→              'class' => ['form-select'],\n   384→            ],\n   385→            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n   386→          ],\n   387→        ],\n   388→        'group' => [\n   389→          '#type' => 'html_tag',\n   390→          '#tag' => 'div',\n   391→          '#attributes' => ['class' => ['form-item']],\n   392→          'label' => [\n   393→            '#type' => 'html_tag',\n   394→            '#tag' => 'label',\n   395→            '#attributes' => ['for' => 'edit-group'],\n   396→            '#value' => $this->t('Group'),\n   397→          ],\n   398→          'select' => [\n   399→            '#type' => 'html_tag',\n   400→            '#tag' => 'select',\n   401→            '#attributes' => [\n   402→              'name' => 'group',\n   403→              'id' => 'edit-group',\n   404→              'class' => ['form-select'],\n   405→            ],\n   406→            'options' => $this->buildSelectOptions($groupOptions, $groupFilter),\n   407→          ],\n   408→        ],\n   409→        'actions' => [\n   410→          '#type' => 'html_tag',\n   411→          '#tag' => 'div',\n   412→          '#attributes' => ['class' => ['form-actions']],\n   413→          'submit' => [\n   414→            '#type' => 'html_tag',\n   415→            '#tag' => 'input',\n   416→            '#attributes' => [\n   417→              'type' => 'submit',\n   418→              'value' => $this->t('Filter'),\n   419→              'class' => ['button', 'button--primary'],\n   420→            ],\n   421→          ],\n   422→        ],\n   423→      ],\n   424→    ];\n   425→  }\n   426→\n   427→  /**\n   428→   * Builds select option elements.\n   429→   *\n   430→   * @param array $options\n   431→   *   The options array.\n   432→   * @param string $selectedValue\n   433→   *   The currently selected value.\n   434→   *\n   435→   * @return array\n   436→   *   A render array of option elements.\n   437→   */\n   438→  protected function buildSelectOptions(array $options, string $selectedValue): array {\n   439→    $elements = [];\n   440→    foreach ($options as $value => $label) {\n   441→      $attributes = ['value' => $value];\n   442→      if ((string) $value === $selectedValue) {\n   443→        $attributes['selected'] = 'selected';\n   444→      }\n   445→      $elements[] = [\n   446→        '#type' => 'html_tag',\n   447→        '#tag' => 'option',\n   448→        '#attributes' => $attributes,\n   449→        '#value' => $label,\n   450→      ];\n   451→    }\n   452→    return $elements;\n   453→  }\n   454→\n   455→  /**\n   456→   * Builds a migration group table.\n   457→   *\n   458→   * @param string $group\n   459→   *   The group name.\n   460→   * @param array $migrations\n   461→   *   The migrations in this group.\n   462→   *\n   463→   * @return array\n   464→   *   A render array for the group.\n   465→   */\n   466→  protected function buildGroupTable(string $group, array $migrations): array {\n   467→    $rows = [];\n   468→    foreach ($migrations as $migrationId => $data) {\n   469→      $statusBadge = $this->buildStatusBadge($data['status']);\n   470→\n   471→      $lastRun = $data['last_run']\n   472→        ? $this->dateFormatter->format($data['last_run'], 'short')\n   473→        : $this->t('Never');\n   474→\n   475→      $rows[] = [\n   476→        Link::fromTextAndUrl($data['label'], Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]))->toString(),\n   477→        $data['group'],\n   478→        $statusBadge,\n   479→        $data['source_count'],\n   480→        $data['imported_count'],\n   481→        $data['failed_count'],\n   482→        $lastRun,\n   483→      ];\n   484→    }\n   485→\n   486→    return [\n   487→      '#type' => 'details',\n   488→      '#title' => $this->t('Group: @group (@count)', [\n   489→        '@group' => $group,\n   490→        '@count' => count($migrations),\n   491→      ]),\n   492→      '#open' => TRUE,\n   493→      'table' => [\n   494→        '#type' => 'table',\n   495→        '#header' => [\n   496→          $this->t('Migration'),\n   497→          $this->t('Group'),\n   498→          $this->t('Status'),\n   499→          $this->t('Source count'),\n   500→          $this->t('Imported'),\n   501→          $this->t('Failed'),\n   502→          $this->t('Last run'),\n   503→        ],\n   504→        '#rows' => $rows,\n   505→        '#empty' => $this->t('No migrations in this group.'),\n   506→      ],\n   507→    ];\n   508→  }\n   509→\n   510→  /**\n   511→   * Builds a colored status badge.\n   512→   *\n   513→   * @param string $status\n   514→   *   The migration status.\n   515→   *\n   516→   * @return array|string\n   517→   *   A markup string with the status badge.\n   518→   */\n   519→  protected function buildStatusBadge(string $status): array|string {\n   520→    $labels = [\n   521→      'idle' => $this->t('Idle'),\n   522→      'importing' => $this->t('Importing'),\n   523→      'rolling_back' => $this->t('Rolling back'),\n   524→      'completed' => $this->t('Completed'),\n   525→      'failed' => $this->t('Failed'),\n   526→    ];\n   527→\n   528→    $colors = [\n   529→      'idle' => 'color--success',\n   530→      'importing' => 'color--primary',\n   531→      'rolling_back' => 'color--warning',\n   532→      'completed' => 'color--success',\n   533→      'failed' => 'color--error',\n   534→    ];\n   535→\n   536→    $label = $labels[$status] ?? $status;\n   537→    $colorClass = $colors[$status] ?? '';\n   538→\n   539→    return [\n   540→      'data' => [\n   541→        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n   542→      ],\n   543→    ];\n   544→  }\n   545→\n   546→}\n   547→"}]},"parent_tool_use_id":null,"session_id":"d40015d6-5dc4-4d37-b8ef-a7f6409020fa","uuid":"33f08df9-feea-47ea-96dd-5d169f5265d8","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_admin/src/Controller/MigrationDashboardController.php","content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace Drupal\\migrate_admin\\Controller;\n\nuse Drupal\\Core\\Controller\\ControllerBase;\nuse Drupal\\Core\\Database\\Connection;\nuse Drupal\\Core\\Datetime\\DateFormatterInterface;\nuse Drupal\\Core\\Extension\\ModuleHandlerInterface;\nuse Drupal\\Core\\Link;\nuse Drupal\\Core\\Url;\nuse Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\nuse Drupal\\migrate_permissions\\MigrateAccessCheck;\nuse Symfony\\Component\\DependencyInjection\\ContainerInterface;\nuse Symfony\\Component\\HttpFoundation\\Request;\n\n/**\n * Controller for the migration dashboard page.\n */\nclass MigrationDashboardController extends ControllerBase {\n\n  /**\n   * Constructs a MigrationDashboardController object.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n   *   The migration plugin manager.\n   * @param \\Drupal\\Core\\Database\\Connection $database\n   *   The database connection.\n   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n   *   The date formatter service.\n   */\n  public function __construct(\n    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    protected readonly Connection $database,\n    protected readonly DateFormatterInterface $dateFormatter,\n    protected readonly ModuleHandlerInterface $moduleHandler,\n    protected readonly ?MigrateAccessCheck $migrateAccessCheck,\n  ) {}\n\n  /**\n   * {@inheritdoc}\n   */\n  public static function create(ContainerInterface $container): static {\n    $migrateAccessCheck = $container->get('module_handler')->moduleExists('migrate_permissions')\n      ? $container->get('migrate_permissions.access_check')\n      : NULL;\n\n    return new static(\n      $container->get('plugin.manager.migration'),\n      $container->get('database'),\n      $container->get('date.formatter'),\n      $container->get('module_handler'),\n      $migrateAccessCheck,\n    );\n  }\n\n  /**\n   * Builds the migration dashboard page.\n   *\n   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   *   The current request.\n   *\n   * @return array\n   *   A render array.\n   */\n  public function dashboard(Request $request): array {\n    $search = $request->query->get('search', '');\n    $statusFilter = $request->query->get('status', '');\n    $groupFilter = $request->query->get('group', '');\n\n    $migrations = $this->migrationPluginManager->createInstances([]);\n\n    if (empty($migrations)) {\n      return [\n        '#markup' => '<p>' . $this->t('No migrations are currently configured. Configure migrations using migration YAML files or Drush commands.') . '</p>',\n      ];\n    }\n\n    // Collect all groups for the filter dropdown.\n    $allGroups = [];\n    $groupedMigrations = [];\n\n    $account = $this->currentUser();\n    $permissionsModuleEnabled = $this->migrateAccessCheck !== NULL;\n\n    foreach ($migrations as $migrationId => $migration) {\n      // Apply per-migration view permission filter.\n      if ($permissionsModuleEnabled && !$this->migrateAccessCheck->canViewMigration($account, $migrationId)) {\n        continue;\n      }\n\n      $label = $migration->label() ?: $migrationId;\n      $definition = $migration->getPluginDefinition();\n      $group = $definition['migration_group'] ?? 'default';\n      $allGroups[$group] = $group;\n\n      // Apply text search filter.\n      if ($search !== '' && stripos($migrationId, $search) === FALSE && stripos((string) $label, $search) === FALSE) {\n        continue;\n      }\n\n      // Get migration status.\n      $status = $this->getMigrationStatus($migration);\n\n      // Apply status filter.\n      if ($statusFilter !== '' && $status !== $statusFilter) {\n        continue;\n      }\n\n      // Apply group filter.\n      if ($groupFilter !== '' && $group !== $groupFilter) {\n        continue;\n      }\n\n      // Get counts from map table.\n      $counts = $this->getItemCounts($migrationId);\n\n      // Get source count.\n      $sourceCount = $this->getSourceCount($migration);\n\n      // Get last run timestamp.\n      $lastRun = $this->getLastRunTimestamp($migrationId);\n\n      $groupedMigrations[$group][$migrationId] = [\n        'label' => $label,\n        'group' => $group,\n        'status' => $status,\n        'source_count' => $sourceCount,\n        'imported_count' => $counts['imported'],\n        'failed_count' => $counts['failed'],\n        'last_run' => $lastRun,\n      ];\n    }\n\n    ksort($allGroups);\n\n    $build = [];\n\n    // Filter form.\n    $build['filters'] = $this->buildFilterForm($search, $statusFilter, $groupFilter, $allGroups);\n\n    // Build grouped tables.\n    foreach ($groupedMigrations as $group => $groupMigrations) {\n      $build['group_' . $group] = $this->buildGroupTable($group, $groupMigrations);\n    }\n\n    if (empty($groupedMigrations)) {\n      if ($permissionsModuleEnabled && $search === '' && $statusFilter === '' && $groupFilter === '') {\n        $build['empty'] = [\n          '#markup' => '<p>' . $this->t('You do not have permission to view any migrations. Contact your site administrator to grant you per-migration view permissions.') . '</p>',\n        ];\n      }\n      else {\n        $build['empty'] = [\n          '#markup' => '<p>' . $this->t('No migrations match the current filters.') . '</p>',\n        ];\n      }\n    }\n\n    $build['#attached'] = [\n      'library' => ['migrate_admin/dashboard'],\n    ];\n    $build['#cache'] = [\n      'contexts' => ['url.query_args'],\n      'tags' => ['migration_plugins'],\n    ];\n\n    return $build;\n  }\n\n  /**\n   * Gets the current status of a migration.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   *   The migration plugin instance.\n   *\n   * @return string\n   *   The status string: idle, importing, rolling_back, completed, or failed.\n   */\n  protected function getMigrationStatus($migration): string {\n    $status = $migration->getStatusLabel();\n\n    // Map Drupal's status labels to our internal statuses.\n    $statusString = (string) $status;\n    $statusMap = [\n      'Idle' => 'idle',\n      'Importing' => 'importing',\n      'Rolling back' => 'rolling_back',\n      'Stopping' => 'idle',\n      'Disabled' => 'idle',\n    ];\n\n    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n\n    // Check run log for completed/failed status if currently idle.\n    if ($migrationStatus === 'idle') {\n      $migrationId = $migration->id();\n      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n        ->fields('r', ['status'])\n        ->condition('migration_id', $migrationId)\n        ->orderBy('id', 'DESC')\n        ->range(0, 1)\n        ->execute()\n        ->fetchField();\n\n      if ($lastRun === 'completed') {\n        $migrationStatus = 'completed';\n      }\n      elseif ($lastRun === 'failed') {\n        $migrationStatus = 'failed';\n      }\n    }\n\n    return $migrationStatus;\n  }\n\n  /**\n   * Gets item counts from the map table.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   *\n   * @return array\n   *   Associative array with 'imported', 'needs_update', 'failed' counts.\n   */\n  protected function getItemCounts(string $migrationId): array {\n    $counts = [\n      'imported' => 0,\n      'needs_update' => 0,\n      'failed' => 0,\n    ];\n\n    $table = 'migrate_map_' . $migrationId;\n    if (!$this->database->schema()->tableExists($table)) {\n      return $counts;\n    }\n\n    $results = $this->database->select($table, 'map')\n      ->fields('map', ['source_row_status'])\n      ->groupBy('source_row_status')\n      ->addExpression('COUNT(*)', 'count')\n      ->execute()\n      ->fetchAllKeyed();\n\n    // Status constants: 0 = imported, 1 = needs_update, 2 = failed.\n    $statusMap = [\n      '0' => 'imported',\n      '1' => 'needs_update',\n      '2' => 'failed',\n    ];\n\n    foreach ($results as $status => $count) {\n      $key = $statusMap[(string) $status] ?? NULL;\n      if ($key !== NULL) {\n        $counts[$key] = (int) $count;\n      }\n    }\n\n    return $counts;\n  }\n\n  /**\n   * Gets the source count for a migration.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   *   The migration plugin instance.\n   *\n   * @return int|string\n   *   The source count or 'N/A' if unavailable.\n   */\n  protected function getSourceCount($migration): int|string {\n    try {\n      $source = $migration->getSourcePlugin();\n      $count = $source->count();\n      return $count === -1 ? 'N/A' : $count;\n    }\n    catch (\\Exception $e) {\n      return 'N/A';\n    }\n  }\n\n  /**\n   * Gets the last run timestamp for a migration.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   *\n   * @return int|null\n   *   The timestamp of the last run, or NULL if never run.\n   */\n  protected function getLastRunTimestamp(string $migrationId): ?int {\n    $result = $this->database->select('migrate_suite_run_log', 'r')\n      ->fields('r', ['started'])\n      ->condition('migration_id', $migrationId)\n      ->orderBy('id', 'DESC')\n      ->range(0, 1)\n      ->execute()\n      ->fetchField();\n\n    return $result ? (int) $result : NULL;\n  }\n\n  /**\n   * Builds the filter form.\n   *\n   * @param string $search\n   *   Current search value.\n   * @param string $statusFilter\n   *   Current status filter.\n   * @param string $groupFilter\n   *   Current group filter.\n   * @param array $allGroups\n   *   All available migration groups.\n   *\n   * @return array\n   *   A render array for the filter form.\n   */\n  protected function buildFilterForm(string $search, string $statusFilter, string $groupFilter, array $allGroups): array {\n    $statusOptions = [\n      '' => $this->t('- All statuses -'),\n      'idle' => $this->t('Idle'),\n      'importing' => $this->t('Importing'),\n      'rolling_back' => $this->t('Rolling back'),\n      'completed' => $this->t('Completed'),\n      'failed' => $this->t('Failed'),\n    ];\n\n    $groupOptions = ['' => $this->t('- All groups -')];\n    foreach ($allGroups as $group) {\n      $groupOptions[$group] = $group;\n    }\n\n    return [\n      '#type' => 'container',\n      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n      'form' => [\n        '#type' => 'html_tag',\n        '#tag' => 'form',\n        '#attributes' => [\n          'method' => 'get',\n          'class' => ['migrate-dashboard-filter-form'],\n        ],\n        'search' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-search'],\n            '#value' => $this->t('Search'),\n          ],\n          'input' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'text',\n              'name' => 'search',\n              'id' => 'edit-search',\n              'value' => $search,\n              'placeholder' => $this->t('Migration ID or label'),\n              'class' => ['form-text'],\n            ],\n          ],\n        ],\n        'status' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-status'],\n            '#value' => $this->t('Status'),\n          ],\n          'select' => [\n            '#type' => 'html_tag',\n            '#tag' => 'select',\n            '#attributes' => [\n              'name' => 'status',\n              'id' => 'edit-status',\n              'class' => ['form-select'],\n            ],\n            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n          ],\n        ],\n        'group' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-group'],\n            '#value' => $this->t('Group'),\n          ],\n          'select' => [\n            '#type' => 'html_tag',\n            '#tag' => 'select',\n            '#attributes' => [\n              'name' => 'group',\n              'id' => 'edit-group',\n              'class' => ['form-select'],\n            ],\n            'options' => $this->buildSelectOptions($groupOptions, $groupFilter),\n          ],\n        ],\n        'actions' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-actions']],\n          'submit' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'submit',\n              'value' => $this->t('Filter'),\n              'class' => ['button', 'button--primary'],\n            ],\n          ],\n        ],\n      ],\n    ];\n  }\n\n  /**\n   * Builds select option elements.\n   *\n   * @param array $options\n   *   The options array.\n   * @param string $selectedValue\n   *   The currently selected value.\n   *\n   * @return array\n   *   A render array of option elements.\n   */\n  protected function buildSelectOptions(array $options, string $selectedValue): array {\n    $elements = [];\n    foreach ($options as $value => $label) {\n      $attributes = ['value' => $value];\n      if ((string) $value === $selectedValue) {\n        $attributes['selected'] = 'selected';\n      }\n      $elements[] = [\n        '#type' => 'html_tag',\n        '#tag' => 'option',\n        '#attributes' => $attributes,\n        '#value' => $label,\n      ];\n    }\n    return $elements;\n  }\n\n  /**\n   * Builds a migration group table.\n   *\n   * @param string $group\n   *   The group name.\n   * @param array $migrations\n   *   The migrations in this group.\n   *\n   * @return array\n   *   A render array for the group.\n   */\n  protected function buildGroupTable(string $group, array $migrations): array {\n    $rows = [];\n    foreach ($migrations as $migrationId => $data) {\n      $statusBadge = $this->buildStatusBadge($data['status']);\n\n      $lastRun = $data['last_run']\n        ? $this->dateFormatter->format($data['last_run'], 'short')\n        : $this->t('Never');\n\n      $rows[] = [\n        Link::fromTextAndUrl($data['label'], Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]))->toString(),\n        $data['group'],\n        $statusBadge,\n        $data['source_count'],\n        $data['imported_count'],\n        $data['failed_count'],\n        $lastRun,\n      ];\n    }\n\n    return [\n      '#type' => 'details',\n      '#title' => $this->t('Group: @group (@count)', [\n        '@group' => $group,\n        '@count' => count($migrations),\n      ]),\n      '#open' => TRUE,\n      'table' => [\n        '#type' => 'table',\n        '#header' => [\n          $this->t('Migration'),\n          $this->t('Group'),\n          $this->t('Status'),\n          $this->t('Source count'),\n          $this->t('Imported'),\n          $this->t('Failed'),\n          $this->t('Last run'),\n        ],\n        '#rows' => $rows,\n        '#empty' => $this->t('No migrations in this group.'),\n      ],\n    ];\n  }\n\n  /**\n   * Builds a colored status badge.\n   *\n   * @param string $status\n   *   The migration status.\n   *\n   * @return array|string\n   *   A markup string with the status badge.\n   */\n  protected function buildStatusBadge(string $status): array|string {\n    $labels = [\n      'idle' => $this->t('Idle'),\n      'importing' => $this->t('Importing'),\n      'rolling_back' => $this->t('Rolling back'),\n      'completed' => $this->t('Completed'),\n      'failed' => $this->t('Failed'),\n    ];\n\n    $colors = [\n      'idle' => 'color--success',\n      'importing' => 'color--primary',\n      'rolling_back' => 'color--warning',\n      'completed' => 'color--success',\n      'failed' => 'color--error',\n    ];\n\n    $label = $labels[$status] ?? $status;\n    $colorClass = $colors[$status] ?? '';\n\n    return [\n      'data' => [\n        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n      ],\n    ];\n  }\n\n}\n","numLines":547,"startLine":1,"totalLines":547}}}
