 105→  }\n   106→\n   107→  /**\n   108→   * {@inheritdoc}\n   109→   */\n   110→  public function buildForm(array $form, FormStateInterface $form_state, ?string $migration_id = NULL): array {\n   111→    if ($migration_id === NULL) {\n   112→      throw new NotFoundHttpException();\n   113→    }\n   114→\n   115→    $this->migrationId = $migration_id;\n   116→\n   117→    try {\n   118→      $migrations = $this->migrationPluginManager->createInstances([$migration_id]);\n   119→      $this->migration = $migrations[$migration_id] ?? NULL;\n   120→    }\n   121→    catch (\\Exception $e) {\n   122→      $this->migration = NULL;\n   123→    }\n   124→\n   125→    if ($this->migration === NULL) {\n   126→      throw new NotFoundHttpException();\n   127→    }\n   128→\n   129→    // Check rollback permission.\n   130→    $this->checkRollbackAccess();\n   131→\n   132→    // Check if dependent migrations exist.\n   133→    $dependencyWarnings = $this->checkDependents();\n   134→    if (!empty($dependencyWarnings)) {\n   135→      $form['dependency_warnings'] = [\n   136→        '#type' => 'container',\n   137→        '#attributes' => ['class' => ['messages', 'messages--warning']],\n   138→        'heading' => [\n   139→          '#markup' => '<h3>' . $this->t('Dependency warnings') . '</h3>',\n   140→        ],\n   141→        'list' => [\n   142→          '#theme' => 'item_list',\n   143→          '#items' => $dependencyWarnings,\n   144→        ],\n   145→      ];\n   146→    }\n   147→\n   148→    return parent::buildForm($form, $form_state);\n   149→  }\n   150→\n   151→  /**\n   152→   * {@inheritdoc}\n   153→   */\n   154→  public function submitForm(array &$form, FormStateInterface $form_state): void {\n   155→    $migration = $this->migration;\n   156→    $migrationId = $this->migrationId;\n   157→\n   158→    $batch = [\n   159→      'title' => $this->t('Rolling back migration: @migration', [\n   160→        '@migration' => $migration->label() ?: $migrationId,\n 