{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014oDsTEyHTzmbxe36WEPs9x","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_suite\\Service;\n     6→\n     7→use Drupal\\Core\\Database\\Connection;\n     8→use Drupal\\migrate\\Plugin\\MigrateIdMapInterface;\n     9→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    10→\n    11→/**\n    12→ * Service for querying migration map tables.\n    13→ */\n    14→class MigrateMapQuery {\n    15→\n    16→  /**\n    17→   * Constructs a MigrateMapQuery object.\n    18→   *\n    19→   * @param \\Drupal\\Core\\Database\\Connection $database\n    20→   *   The database connection.\n    21→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    22→   *   The migration plugin manager.\n    23→   */\n    24→  public function __construct(\n    25→    protected readonly Connection $database,\n    26→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    27→  ) {}\n    28→\n    29→  /**\n    30→   * Gets the map table name for a migration.\n    31→   *\n    32→   * @param string $migrationId\n    33→   *   The migration plugin ID.\n    34→   *\n    35→   * @return string\n    36→   *   The map table name.\n    37→   */\n    38→  protected function getMapTableName(string $migrationId): string {\n    39→    return 'migrate_map_' . $migrationId;\n    40→  }\n    41→\n    42→  /**\n    43→   * Looks up destination IDs by source ID.\n    44→   *\n    45→   * @param string $migrationId\n    46→   *   The migration plugin ID.\n    47→   * @param array $sourceIdValues\n    48→   *   The source ID values keyed by source ID field name.\n    49→   *\n    50→   * @return array\n    51→   *   The destination ID values, or an empty array if not found.\n    52→   */\n    53→  public function lookupDestinationIds(string $migrationId, array $sourceIdValues): array {\n    54→    $table = $this->getMapTableName($migrationId);\n    55→\n    56→    if (!$this->database->schema()->tableExists($table)) {\n    57→      return [];\n    58→    }\n    59→\n    60→    $query = $this->database->select($table, 'map')\n    61→      ->fields('map');\n    62→\n    63→    $index = 1;\n    64→    foreach ($sourceIdValues as $value) {\n    65→      $query->condition('sourceid' . $index, $value);\n    66→      $index++;\n    67→    }\n    68→\n    69→    $row = $query->execute()->fetchAssoc();\n    70→\n    71→    if (!$row) {\n    72→      return [];\n    73→    }\n    74→\n    75→    $destIds = [];\n    76→    foreach ($row as $key => $value) {\n    77→      if (str_starts_with($key, 'destid')) {\n    78→        $destIds[$key] = $value;\n    79→      }\n    80→    }\n    81→\n    82→    return $destIds;\n    83→  }\n    84→\n    85→  /**\n    86→   * Lists all imported items for a migration.\n    87→   *\n    88→   * @param string $migrationId\n    89→   *   The migration plugin ID.\n    90→   * @param int $limit\n    91→   *   The number of items to return.\n    92→   * @param int $offset\n    93→   *   The offset for pagination.\n    94→   *\n    95→   * @return array\n    96→   *   An array of map table rows.\n    97→   */\n    98→  public function listImportedItems(string $migrationId, int $limit = 50, int $offset = 0): array {\n    99→    $table = $this->getMapTableName($migrationId);\n   100→\n   101→    if (!$this->database->schema()->tableExists($table)) {\n   102→      return [];\n   103→    }\n   104→\n   105→    return $this->database->select($table, 'map')\n   106→      ->fields('map')\n   107→      ->range($offset, $limit)\n   108→      ->execute()\n   109→      ->fetchAll();\n   110→  }\n   111→\n   112→  /**\n   113→   * Counts items by status for a migration.\n   114→   *\n   115→   * @param string $migrationId\n   116→   *   The migration plugin ID.\n   117→   *\n   118→   * @return array\n   119→   *   An associative array with keys 'imported', 'needs_update', 'failed'\n   120→   *   and their respective counts.\n   121→   */\n   122→  public function countItemsByStatus(string $migrationId): array {\n   123→    $table = $this->getMapTableName($migrationId);\n   124→\n   125→    $counts = [\n   126→      'imported' => 0,\n   127→      'needs_update' => 0,\n   128→      'failed' => 0,\n   129→    ];\n   130→\n   131→    if (!$this->database->schema()->tableExists($table)) {\n   132→      return $counts;\n   133→    }\n   134→\n   135→    $results = $this->database->select($table, 'map')\n   136→      ->fields('map', ['source_row_status'])\n   137→      ->groupBy('source_row_status')\n   138→      ->addExpression('COUNT(*)', 'count')\n   139→      ->execute()\n   140→      ->fetchAllKeyed();\n   141→\n   142→    $statusMap = [\n   143→      (string) MigrateIdMapInterface::STATUS_IMPORTED => 'imported',\n   144→      (string) MigrateIdMapInterface::STATUS_NEEDS_UPDATE => 'needs_update',\n   145→      (string) MigrateIdMapInterface::STATUS_FAILED => 'failed',\n   146→    ];\n   147→\n   148→    foreach ($results as $status => $count) {\n   149→      $key = $statusMap[(string) $status] ?? NULL;\n   150→      if ($key !== NULL) {\n   151→        $counts[$key] = (int) $count;\n   152→      }\n   153→    }\n   154→\n   155→    return $counts;\n   156→  }\n   157→\n   158→}\n   159→"}]},"parent_tool_use_id":"toolu_01LEtAv55nTQZa2h3M5mw8KW","session_id":"83d2f696-dcc4-44a7-bdc8-ff6d1a66e4a4","uuid":"aecb6e2d-7797-4c6a-b6d1-d19d2d67f0ea"}
