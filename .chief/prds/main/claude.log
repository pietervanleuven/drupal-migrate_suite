{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GEyaag8aXV5b1bXUWE2tvU","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_suite\\Service;\n     6→\n     7→use Drupal\\Core\\Database\\Connection;\n     8→\n     9→/**\n    10→ * Service for querying migration message tables.\n    11→ */\n    12→class MigrateMessageQuery {\n    13→\n    14→  /**\n    15→   * Constructs a MigrateMessageQuery object.\n    16→   *\n    17→   * @param \\Drupal\\Core\\Database\\Connection $database\n    18→   *   The database connection.\n    19→   */\n    20→  public function __construct(\n    21→    protected readonly Connection $database,\n    22→  ) {}\n    23→\n    24→  /**\n    25→   * Gets the message table name for a migration.\n    26→   *\n    27→   * @param string $migrationId\n    28→   *   The migration plugin ID.\n    29→   *\n    30→   * @return string\n    31→   *   The message table name.\n    32→   */\n    33→  protected function getMessageTableName(string $migrationId): string {\n    34→    return 'migrate_message_' . $migrationId;\n    35→  }\n    36→\n    37→  /**\n    38→   * Fetches messages for a specific migration.\n    39→   *\n    40→   * @param string $migrationId\n    41→   *   The migration plugin ID.\n    42→   * @param int $limit\n    43→   *   The number of messages to return.\n    44→   * @param int $offset\n    45→   *   The offset for pagination.\n    46→   *\n    47→   * @return array\n    48→   *   An array of message rows.\n    49→   */\n    50→  public function getMessages(string $migrationId, int $limit = 50, int $offset = 0): array {\n    51→    $table = $this->getMessageTableName($migrationId);\n    52→\n    53→    if (!$this->database->schema()->tableExists($table)) {\n    54→      return [];\n    55→    }\n    56→\n    57→    return $this->database->select($table, 'msg')\n    58→      ->fields('msg')\n    59→      ->range($offset, $limit)\n    60→      ->execute()\n    61→      ->fetchAll();\n    62→  }\n    63→\n    64→  /**\n    65→   * Fetches messages for a specific source ID within a migration.\n    66→   *\n    67→   * @param string $migrationId\n    68→   *   The migration plugin ID.\n    69→   * @param array $sourceIdValues\n    70→   *   The source ID values.\n    71→   *\n    72→   * @return array\n    73→   *   An array of message rows for the given source ID.\n    74→   */\n    75→  public function getMessagesForSourceId(string $migrationId, array $sourceIdValues): array {\n    76→    $table = $this->getMessageTableName($migrationId);\n    77→\n    78→    if (!$this->database->schema()->tableExists($table)) {\n    79→      return [];\n    80→    }\n    81→\n    82→    $query = $this->database->select($table, 'msg')\n    83→      ->fields('msg');\n    84→\n    85→    $index = 1;\n    86→    foreach ($sourceIdValues as $value) {\n    87→      $query->condition('src_' . $index, $value);\n    88→      $index++;\n    89→    }\n    90→\n    91→    return $query->execute()->fetchAll();\n    92→  }\n    93→\n    94→}\n    95→"}]},"parent_tool_use_id":"toolu_01LEtAv55nTQZa2h3M5mw8KW","session_id":"83d2f696-dcc4-44a7-bdc8-ff6d1a66e4a4","uuid":"002770d7-6221-41b8-a376-02ec48d9e37a"}
