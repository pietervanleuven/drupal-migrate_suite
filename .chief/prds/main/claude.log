{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014h82RAtQw3SdwbEi4wJ6M9","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_permissions;\n     6→\n     7→use Drupal\\Core\\Session\\AccountInterface;\n     8→\n     9→/**\n    10→ * Checks per-migration view access.\n    11→ */\n    12→class MigrateAccessCheck {\n    13→\n    14→  /**\n    15→   * Checks if a user can view a specific migration.\n    16→   *\n    17→   * @param \\Drupal\\Core\\Session\\AccountInterface $account\n    18→   *   The user account to check.\n    19→   * @param string $migration_id\n    20→   *   The migration plugin ID.\n    21→   *\n    22→   * @return bool\n    23→   *   TRUE if the user can view this migration.\n    24→   */\n    25→  public function canViewMigration(AccountInterface $account, string $migration_id): bool {\n    26→    // Bypass for admin-level permissions.\n    27→    if ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n    28→      return TRUE;\n    29→    }\n    30→\n    31→    $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower($migration_id));\n    32→    return $account->hasPermission(\"view migration $safe_id\");\n    33→  }\n    34→\n    35→  /**\n    36→   * Checks if a user can run a specific migration.\n    37→   *\n    38→   * @param \\Drupal\\Core\\Session\\AccountInterface $account\n    39→   *   The user account to check.\n    40→   * @param string $migration_id\n    41→   *   The migration plugin ID.\n    42→   *\n    43→   * @return bool\n    44→   *   TRUE if the user can run this migration.\n    45→   */\n    46→  public function canRunMigration(AccountInterface $account, string $migration_id): bool {\n    47→    if ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n    48→      return TRUE;\n    49→    }\n    50→\n    51→    $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower($migration_id));\n    52→    return $account->hasPermission(\"run migration $safe_id\");\n    53→  }\n    54→\n    55→  /**\n    56→   * Checks if a user can rollback a specific migration.\n    57→   *\n    58→   * @param \\Drupal\\Core\\Session\\AccountInterface $account\n    59→   *   The user account to check.\n    60→   * @param string $migration_id\n    61→   *   The migration plugin ID.\n    62→   *\n    63→   * @return bool\n    64→   *   TRUE if the user can rollback this migration.\n    65→   */\n    66→  public function canRollbackMigration(AccountInterface $account, string $migration_id): bool {\n    67→    if ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n    68→      return TRUE;\n    69→    }\n    70→\n    71→    $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower($migration_id));\n    72→    return $account->hasPermission(\"rollback migration $safe_id\");\n    73→  }\n    74→\n    75→}\n    76→"}]},"parent_tool_use_id":null,"session_id":"804c2cf8-5541-47a7-a331-3655bdfe0e70","uuid":"a629b827-7c49-4054-929a-d47207a10f13","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_permissions/src/MigrateAccessCheck.php","content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace Drupal\\migrate_permissions;\n\nuse Drupal\\Core\\Session\\AccountInterface;\n\n/**\n * Checks per-migration view access.\n */\nclass MigrateAccessCheck {\n\n  /**\n   * Checks if a user can view a specific migration.\n   *\n   * @param \\Drupal\\Core\\Session\\AccountInterface $account\n   *   The user account to check.\n   * @param string $migration_id\n   *   The migration plugin ID.\n   *\n   * @return bool\n   *   TRUE if the user can view this migration.\n   */\n  public function canViewMigration(AccountInterface $account, string $migration_id): bool {\n    // Bypass for admin-level permissions.\n    if ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n      return TRUE;\n    }\n\n    $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower($migration_id));\n    return $account->hasPermission(\"view migration $safe_id\");\n  }\n\n  /**\n   * Checks if a user can run a specific migration.\n   *\n   * @param \\Drupal\\Core\\Session\\AccountInterface $account\n   *   The user account to check.\n   * @param string $migration_id\n   *   The migration plugin ID.\n   *\n   * @return bool\n   *   TRUE if the user can run this migration.\n   */\n  public function canRunMigration(AccountInterface $account, string $migration_id): bool {\n    if ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n      return TRUE;\n    }\n\n    $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower($migration_id));\n    return $account->hasPermission(\"run migration $safe_id\");\n  }\n\n  /**\n   * Checks if a user can rollback a specific migration.\n   *\n   * @param \\Drupal\\Core\\Session\\AccountInterface $account\n   *   The user account to check.\n   * @param string $migration_id\n   *   The migration plugin ID.\n   *\n   * @return bool\n   *   TRUE if the user can rollback this migration.\n   */\n  public function canRollbackMigration(AccountInterface $account, string $migration_id): bool {\n    if ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n      return TRUE;\n    }\n\n    $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower($migration_id));\n    return $account->hasPermission(\"rollback migration $safe_id\");\n  }\n\n}\n","numLines":76,"startLine":1,"totalLines":76}}}
