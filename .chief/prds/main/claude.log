{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wef3zdPHuM2iSEE5n5XGFQ","type":"tool_result","content":"     1→<?php\n     2→\n     3→/**\n     4→ * @file\n     5→ * Provides migration provenance pseudo-field on migrated entities.\n     6→ */\n     7→\n     8→declare(strict_types=1);\n     9→\n    10→use Drupal\\Core\\Entity\\Display\\EntityViewDisplayInterface;\n    11→use Drupal\\Core\\Entity\\EntityInterface;\n    12→use Drupal\\Core\\Form\\FormStateInterface;\n    13→use Drupal\\Core\\Url;\n    14→use Drupal\\node\\NodeInterface;\n    15→use Drupal\\node\\NodeTypeInterface;\n    16→\n    17→/**\n    18→ * Implements hook_entity_extra_field_info().\n    19→ */\n    20→function migrate_source_field_entity_extra_field_info(): array {\n    21→  $extra = [];\n    22→\n    23→  $nodeTypes = \\Drupal::entityTypeManager()\n    24→    ->getStorage('node_type')\n    25→    ->loadMultiple();\n    26→\n    27→  foreach ($nodeTypes as $nodeType) {\n    28→    assert($nodeType instanceof NodeTypeInterface);\n    29→    $extra['node'][$nodeType->id()]['display']['migrate_provenance'] = [\n    30→      'label' => t('Migration provenance'),\n    31→      'description' => t('Shows migration source information for imported content.'),\n    32→      'weight' => 100,\n    33→      'visible' => FALSE,\n    34→    ];\n    35→    $extra['node'][$nodeType->id()]['form']['migrate_provenance'] = [\n    36→      'label' => t('Migration provenance'),\n    37→      'description' => t('Shows migration source information for imported content.'),\n    38→      'weight' => 100,\n    39→      'visible' => FALSE,\n    40→    ];\n    41→  }\n    42→\n    43→  return $extra;\n    44→}\n    45→\n    46→/**\n    47→ * Implements hook_ENTITY_TYPE_view() for node entities.\n    48→ */\n    49→function migrate_source_field_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {\n    50→  if (!$display->getComponent('migrate_provenance')) {\n    51→    return;\n    52→  }\n    53→\n    54→  $provenance = _migrate_source_field_get_provenance($entity);\n    55→  if ($provenance === NULL) {\n    56→    return;\n    57→  }\n    58→\n    59→  $build['migrate_provenance'] = _migrate_source_field_build_provenance_display($provenance);\n    60→  $build['migrate_provenance']['#cache'] = [\n    61→    'tags' => ['migrate_source_field:provenance'],\n    62→  ];\n    63→}\n    64→\n    65→/**\n    66→ * Implements hook_form_BASE_FORM_ID_alter() for node forms.\n    67→ */\n    68→function migrate_source_field_form_node_form_alter(array &$form, FormStateInterface $form_state): void {\n    69→  /** @var \\Drupal\\node\\NodeInterface $node */\n    70→  $node = $form_state->getFormObject()->getEntity();\n    71→\n    72→  if ($node->isNew()) {\n    73→    return;\n    74→  }\n    75→\n    76→  // Check if the pseudo-field is enabled on the form display.\n    77→  $formDisplay = \\Drupal::entityTypeManager()\n    78→    ->getStorage('entity_form_display')\n    79→    ->load('node.' . $node->bundle() . '.default');\n    80→\n    81→  if (!$formDisplay || !$formDisplay->getComponent('migrate_provenance')) {\n    82→    return;\n    83→  }\n    84→\n    85→  $provenance = _migrate_source_field_get_provenance($node);\n    86→  if ($provenance === NULL) {\n    87→    return;\n    88→  }\n    89→\n    90→  $form['migrate_provenance'] = _migrate_source_field_build_provenance_display($provenance);\n    91→  $form['migrate_provenance']['#weight'] = 100;\n    92→}\n    93→\n    94→/**\n    95→ * Gets provenance data for an entity.\n    96→ *\n    97→ * @param \\Drupal\\Core\\Entity\\EntityInterface $entity\n    98→ *   The entity.\n    99→ *\n   100→ * @return array|null\n   101→ *   Provenance data or NULL if not found.\n   102→ */\n   103→function _migrate_source_field_get_provenance(EntityInterface $entity): ?array {\n   104→  if (!$entity instanceof NodeInterface || $entity->isNew()) {\n   105→    return NULL;\n   106→  }\n   107→\n   108→  /** @var \\Drupal\\migrate_source_field\\Service\\ProvenanceLookup $provenanceLookup */\n   109→  $provenanceLookup = \\Drupal::service('migrate_source_field.provenance_lookup');\n   110→  return $provenanceLookup->lookupProvenance(\n   111→    $entity->getEntityTypeId(),\n   112→    $entity->id(),\n   113→  );\n   114→}\n   115→\n   116→/**\n   117→ * Builds the provenance display render array.\n   118→ *\n   119→ * @param array $provenance\n   120→ *   The provenance data from ProvenanceLookup.\n   121→ *\n   122→ * @return array\n   123→ *   A render array.\n   124→ */\n   125→function _migrate_source_field_build_provenance_display(array $provenance): array {\n   126→  $migrationLabel = $provenance['migration_label'];\n   127→  $migrationId = $provenance['migration_id'];\n   128→\n   129→  // Link to detail page if user has permission.\n   130→  $currentUser = \\Drupal::currentUser();\n   131→  $hasDetailAccess = $currentUser->hasPermission('view migrate suite dashboard');\n   132→  if ($hasDetailAccess) {\n   133→    try {\n   134→      $url = Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]);\n   135→      $migrationLabel = '<a href=\"' . $url->toString() . '\">' . htmlspecialchars((string) $migrationLabel, ENT_QUOTES) . '</a>';\n   136→    }\n   137→    catch (\\Exception $e) {\n   138→      // Route may not exist if migrate_admin is not installed.\n   139→      $migrationLabel = htmlspecialchars((string) $migrationLabel, ENT_QUOTES);\n   140→    }\n   141→  }\n   142→  else {\n   143→    $migrationLabel = htmlspecialchars((string) $migrationLabel, ENT_QUOTES);\n   144→  }\n   145→\n   146→  $rows = [\n   147→    [t('Migration'), ['data' => ['#markup' => $migrationLabel]]],\n   148→    [t('Source ID(s)'), implode(' / ', $provenance['source_ids'])],\n   149→  ];\n   150→\n   151→  if ($provenance['last_imported'] !== NULL) {\n   152→    $importDate = \\Drupal::service('date.formatter')\n   153→      ->format($provenance['last_imported'], 'short');\n   154→    $rows[] = [t('Import date'), $importDate];\n   155→  }\n   156→\n   157→  return [\n   158→    '#type' => 'details',\n   159→    '#title' => t('Migration provenance'),\n   160→    '#open' => TRUE,\n   161→    'table' => [\n   162→      '#type' => 'table',\n   163→      '#rows' => $rows,\n   164→    ],\n   165→  ];\n   166→}\n   167→"}]},"parent_tool_use_id":null,"session_id":"28cfe27e-2fc7-424c-a54a-476b587371b6","uuid":"6b126a36-a17b-46ed-beaa-e6c862e25b8f","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_source_field/migrate_source_field.module","content":"<?php\n\n/**\n * @file\n * Provides migration provenance pseudo-field on migrated entities.\n */\n\ndeclare(strict_types=1);\n\nuse Drupal\\Core\\Entity\\Display\\EntityViewDisplayInterface;\nuse Drupal\\Core\\Entity\\EntityInterface;\nuse Drupal\\Core\\Form\\FormStateInterface;\nuse Drupal\\Core\\Url;\nuse Drupal\\node\\NodeInterface;\nuse Drupal\\node\\NodeTypeInterface;\n\n/**\n * Implements hook_entity_extra_field_info().\n */\nfunction migrate_source_field_entity_extra_field_info(): array {\n  $extra = [];\n\n  $nodeTypes = \\Drupal::entityTypeManager()\n    ->getStorage('node_type')\n    ->loadMultiple();\n\n  foreach ($nodeTypes as $nodeType) {\n    assert($nodeType instanceof NodeTypeInterface);\n    $extra['node'][$nodeType->id()]['display']['migrate_provenance'] = [\n      'label' => t('Migration provenance'),\n      'description' => t('Shows migration source information for imported content.'),\n      'weight' => 100,\n      'visible' => FALSE,\n    ];\n    $extra['node'][$nodeType->id()]['form']['migrate_provenance'] = [\n      'label' => t('Migration provenance'),\n      'description' => t('Shows migration source information for imported content.'),\n      'weight' => 100,\n      'visible' => FALSE,\n    ];\n  }\n\n  return $extra;\n}\n\n/**\n * Implements hook_ENTITY_TYPE_view() for node entities.\n */\nfunction migrate_source_field_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {\n  if (!$display->getComponent('migrate_provenance')) {\n    return;\n  }\n\n  $provenance = _migrate_source_field_get_provenance($entity);\n  if ($provenance === NULL) {\n    return;\n  }\n\n  $build['migrate_provenance'] = _migrate_source_field_build_provenance_display($provenance);\n  $build['migrate_provenance']['#cache'] = [\n    'tags' => ['migrate_source_field:provenance'],\n  ];\n}\n\n/**\n * Implements hook_form_BASE_FORM_ID_alter() for node forms.\n */\nfunction migrate_source_field_form_node_form_alter(array &$form, FormStateInterface $form_state): void {\n  /** @var \\Drupal\\node\\NodeInterface $node */\n  $node = $form_state->getFormObject()->getEntity();\n\n  if ($node->isNew()) {\n    return;\n  }\n\n  // Check if the pseudo-field is enabled on the form display.\n  $formDisplay = \\Drupal::entityTypeManager()\n    ->getStorage('entity_form_display')\n    ->load('node.' . $node->bundle() . '.default');\n\n  if (!$formDisplay || !$formDisplay->getComponent('migrate_provenance')) {\n    return;\n  }\n\n  $provenance = _migrate_source_field_get_provenance($node);\n  if ($provenance === NULL) {\n    return;\n  }\n\n  $form['migrate_provenance'] = _migrate_source_field_build_provenance_display($provenance);\n  $form['migrate_provenance']['#weight'] = 100;\n}\n\n/**\n * Gets provenance data for an entity.\n *\n * @param \\Drupal\\Core\\Entity\\EntityInterface $entity\n *   The entity.\n *\n * @return array|null\n *   Provenance data or NULL if not found.\n */\nfunction _migrate_source_field_get_provenance(EntityInterface $entity): ?array {\n  if (!$entity instanceof NodeInterface || $entity->isNew()) {\n    return NULL;\n  }\n\n  /** @var \\Drupal\\migrate_source_field\\Service\\ProvenanceLookup $provenanceLookup */\n  $provenanceLookup = \\Drupal::service('migrate_source_field.provenance_lookup');\n  return $provenanceLookup->lookupProvenance(\n    $entity->getEntityTypeId(),\n    $entity->id(),\n  );\n}\n\n/**\n * Builds the provenance display render array.\n *\n * @param array $provenance\n *   The provenance data from ProvenanceLookup.\n *\n * @return array\n *   A render array.\n */\nfunction _migrate_source_field_build_provenance_display(array $provenance): array {\n  $migrationLabel = $provenance['migration_label'];\n  $migrationId = $provenance['migration_id'];\n\n  // Link to detail page if user has permission.\n  $currentUser = \\Drupal::currentUser();\n  $hasDetailAccess = $currentUser->hasPermission('view migrate suite dashboard');\n  if ($hasDetailAccess) {\n    try {\n      $url = Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]);\n      $migrationLabel = '<a href=\"' . $url->toString() . '\">' . htmlspecialchars((string) $migrationLabel, ENT_QUOTES) . '</a>';\n    }\n    catch (\\Exception $e) {\n      // Route may not exist if migrate_admin is not installed.\n      $migrationLabel = htmlspecialchars((string) $migrationLabel, ENT_QUOTES);\n    }\n  }\n  else {\n    $migrationLabel = htmlspecialchars((string) $migrationLabel, ENT_QUOTES);\n  }\n\n  $rows = [\n    [t('Migration'), ['data' => ['#markup' => $migrationLabel]]],\n    [t('Source ID(s)'), implode(' / ', $provenance['source_ids'])],\n  ];\n\n  if ($provenance['last_imported'] !== NULL) {\n    $importDate = \\Drupal::service('date.formatter')\n      ->format($provenance['last_imported'], 'short');\n    $rows[] = [t('Import date'), $importDate];\n  }\n\n  return [\n    '#type' => 'details',\n    '#title' => t('Migration provenance'),\n    '#open' => TRUE,\n    'table' => [\n      '#type' => 'table',\n      '#rows' => $rows,\n    ],\n  ];\n}\n","numLines":167,"startLine":1,"totalLines":167}}}
