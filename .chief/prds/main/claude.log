{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015znKpYgo6xqnaJHcPH86NZ","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_admin\\Controller;\n     6→\n     7→use Drupal\\Core\\Controller\\ControllerBase;\n     8→use Drupal\\Core\\Database\\Connection;\n     9→use Drupal\\Core\\Datetime\\DateFormatterInterface;\n    10→use Drupal\\Core\\Link;\n    11→use Drupal\\Core\\Url;\n    12→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    13→use Symfony\\Component\\DependencyInjection\\ContainerInterface;\n    14→use Symfony\\Component\\HttpFoundation\\Request;\n    15→\n    16→/**\n    17→ * Controller for the migration dashboard page.\n    18→ */\n    19→class MigrationDashboardController extends ControllerBase {\n    20→\n    21→  /**\n    22→   * Constructs a MigrationDashboardController object.\n    23→   *\n    24→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    25→   *   The migration plugin manager.\n    26→   * @param \\Drupal\\Core\\Database\\Connection $database\n    27→   *   The database connection.\n    28→   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n    29→   *   The date formatter service.\n    30→   */\n    31→  public function __construct(\n    32→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    33→    protected readonly Connection $database,\n    34→    protected readonly DateFormatterInterface $dateFormatter,\n    35→  ) {}\n    36→\n    37→  /**\n    38→   * {@inheritdoc}\n    39→   */\n    40→  public static function create(ContainerInterface $container): static {\n    41→    return new static(\n    42→      $container->get('plugin.manager.migration'),\n    43→      $container->get('database'),\n    44→      $container->get('date.formatter'),\n    45→    );\n    46→  }\n    47→\n    48→  /**\n    49→   * Builds the migration dashboard page.\n    50→   *\n    51→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n    52→   *   The current request.\n    53→   *\n    54→   * @return array\n    55→   *   A render array.\n    56→   */\n    57→  public function dashboard(Request $request): array {\n    58→    $search = $request->query->get('search', '');\n    59→    $statusFilter = $request->query->get('status', '');\n    60→    $groupFilter = $request->query->get('group', '');\n    61→\n    62→    $migrations = $this->migrationPluginManager->createInstances([]);\n    63→\n    64→    if (empty($migrations)) {\n    65→      return [\n    66→        '#markup' => '<p>' . $this->t('No migrations are currently configured. Configure migrations using migration YAML files or Drush commands.') . '</p>',\n    67→      ];\n    68→    }\n    69→\n    70→    // Collect all groups for the filter dropdown.\n    71→    $allGroups = [];\n    72→    $groupedMigrations = [];\n    73→\n    74→    foreach ($migrations as $migrationId => $migration) {\n    75→      $label = $migration->label() ?: $migrationId;\n    76→      $definition = $migration->getPluginDefinition();\n    77→      $group = $definition['migration_group'] ?? 'default';\n    78→      $allGroups[$group] = $group;\n    79→\n    80→      // Apply text search filter.\n    81→      if ($search !== '' && stripos($migrationId, $search) === FALSE && stripos((string) $label, $search) === FALSE) {\n    82→        continue;\n    83→      }\n    84→\n    85→      // Get migration status.\n    86→      $status = $this->getMigrationStatus($migration);\n    87→\n    88→      // Apply status filter.\n    89→      if ($statusFilter !== '' && $status !== $statusFilter) {\n    90→        continue;\n    91→      }\n    92→\n    93→      // Apply group filter.\n    94→      if ($groupFilter !== '' && $group !== $groupFilter) {\n    95→        continue;\n    96→      }\n    97→\n    98→      // Get counts from map table.\n    99→      $counts = $this->getItemCounts($migrationId);\n   100→\n   101→      // Get source count.\n   102→      $sourceCount = $this->getSourceCount($migration);\n   103→\n   104→      // Get last run timestamp.\n   105→      $lastRun = $this->getLastRunTimestamp($migrationId);\n   106→\n   107→      $groupedMigrations[$group][$migrationId] = [\n   108→        'label' => $label,\n   109→        'group' => $group,\n   110→        'status' => $status,\n   111→        'source_count' => $sourceCount,\n   112→        'imported_count' => $counts['imported'],\n   113→        'failed_count' => $counts['failed'],\n   114→        'last_run' => $lastRun,\n   115→      ];\n   116→    }\n   117→\n   118→    ksort($allGroups);\n   119→\n   120→    $build = [];\n   121→\n   122→    // Filter form.\n   123→    $build['filters'] = $this->buildFilterForm($search, $statusFilter, $groupFilter, $allGroups);\n   124→\n   125→    // Build grouped tables.\n   126→    foreach ($groupedMigrations as $group => $groupMigrations) {\n   127→      $build['group_' . $group] = $this->buildGroupTable($group, $groupMigrations);\n   128→    }\n   129→\n   130→    if (empty($groupedMigrations)) {\n   131→      $build['empty'] = [\n   132→        '#markup' => '<p>' . $this->t('No migrations match the current filters.') . '</p>',\n   133→      ];\n   134→    }\n   135→\n   136→    $build['#attached'] = [\n   137→      'library' => ['migrate_admin/dashboard'],\n   138→    ];\n   139→    $build['#cache'] = [\n   140→      'contexts' => ['url.query_args'],\n   141→      'tags' => ['migration_plugins'],\n   142→    ];\n   143→\n   144→    return $build;\n   145→  }\n   146→\n   147→  /**\n   148→   * Gets the current status of a migration.\n   149→   *\n   150→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   151→   *   The migration plugin instance.\n   152→   *\n   153→   * @return string\n   154→   *   The status string: idle, importing, rolling_back, completed, or failed.\n   155→   */\n   156→  protected function getMigrationStatus($migration): string {\n   157→    $status = $migration->getStatusLabel();\n   158→\n   159→    // Map Drupal's status labels to our internal statuses.\n   160→    $statusString = (string) $status;\n   161→    $statusMap = [\n   162→      'Idle' => 'idle',\n   163→      'Importing' => 'importing',\n   164→      'Rolling back' => 'rolling_back',\n   165→      'Stopping' => 'idle',\n   166→      'Disabled' => 'idle',\n   167→    ];\n   168→\n   169→    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n   170→\n   171→    // Check run log for completed/failed status if currently idle.\n   172→    if ($migrationStatus === 'idle') {\n   173→      $migrationId = $migration->id();\n   174→      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   175→        ->fields('r', ['status'])\n   176→        ->condition('migration_id', $migrationId)\n   177→        ->orderBy('id', 'DESC')\n   178→        ->range(0, 1)\n   179→        ->execute()\n   180→        ->fetchField();\n   181→\n   182→      if ($lastRun === 'completed') {\n   183→        $migrationStatus = 'completed';\n   184→      }\n   185→      elseif ($lastRun === 'failed') {\n   186→        $migrationStatus = 'failed';\n   187→      }\n   188→    }\n   189→\n   190→    return $migrationStatus;\n   191→  }\n   192→\n   193→  /**\n   194→   * Gets item counts from the map table.\n   195→   *\n   196→   * @param string $migrationId\n   197→   *   The migration ID.\n   198→   *\n   199→   * @return array\n   200→   *   Associative array with 'imported', 'needs_update', 'failed' counts.\n   201→   */\n   202→  protected function getItemCounts(string $migrationId): array {\n   203→    $counts = [\n   204→      'imported' => 0,\n   205→      'needs_update' => 0,\n   206→      'failed' => 0,\n   207→    ];\n   208→\n   209→    $table = 'migrate_map_' . $migrationId;\n   210→    if (!$this->database->schema()->tableExists($table)) {\n   211→      return $counts;\n   212→    }\n   213→\n   214→    $results = $this->database->select($table, 'map')\n   215→      ->fields('map', ['source_row_status'])\n   216→      ->groupBy('source_row_status')\n   217→      ->addExpression('COUNT(*)', 'count')\n   218→      ->execute()\n   219→      ->fetchAllKeyed();\n   220→\n   221→    // Status constants: 0 = imported, 1 = needs_update, 2 = failed.\n   222→    $statusMap = [\n   223→      '0' => 'imported',\n   224→      '1' => 'needs_update',\n   225→      '2' => 'failed',\n   226→    ];\n   227→\n   228→    foreach ($results as $status => $count) {\n   229→      $key = $statusMap[(string) $status] ?? NULL;\n   230→      if ($key !== NULL) {\n   231→        $counts[$key] = (int) $count;\n   232→      }\n   233→    }\n   234→\n   235→    return $counts;\n   236→  }\n   237→\n   238→  /**\n   239→   * Gets the source count for a migration.\n   240→   *\n   241→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   242→   *   The migration plugin instance.\n   243→   *\n   244→   * @return int|string\n   245→   *   The source count or 'N/A' if unavailable.\n   246→   */\n   247→  protected function getSourceCount($migration): int|string {\n   248→    try {\n   249→      $source = $migration->getSourcePlugin();\n   250→      $count = $source->count();\n   251→      return $count === -1 ? 'N/A' : $count;\n   252→    }\n   253→    catch (\\Exception $e) {\n   254→      return 'N/A';\n   255→    }\n   256→  }\n   257→\n   258→  /**\n   259→   * Gets the last run timestamp for a migration.\n   260→   *\n   261→   * @param string $migrationId\n   262→   *   The migration ID.\n   263→   *\n   264→   * @return int|null\n   265→   *   The timestamp of the last run, or NULL if never run.\n   266→   */\n   267→  protected function getLastRunTimestamp(string $migrationId): ?int {\n   268→    $result = $this->database->select('migrate_suite_run_log', 'r')\n   269→      ->fields('r', ['started'])\n   270→      ->condition('migration_id', $migrationId)\n   271→      ->orderBy('id', 'DESC')\n   272→      ->range(0, 1)\n   273→      ->execute()\n   274→      ->fetchField();\n   275→\n   276→    return $result ? (int) $result : NULL;\n   277→  }\n   278→\n   279→  /**\n   280→   * Builds the filter form.\n   281→   *\n   282→   * @param string $search\n   283→   *   Current search value.\n   284→   * @param string $statusFilter\n   285→   *   Current status filter.\n   286→   * @param string $groupFilter\n   287→   *   Current group filter.\n   288→   * @param array $allGroups\n   289→   *   All available migration groups.\n   290→   *\n   291→   * @return array\n   292→   *   A render array for the filter form.\n   293→   */\n   294→  protected function buildFilterForm(string $search, string $statusFilter, string $groupFilter, array $allGroups): array {\n   295→    $statusOptions = [\n   296→      '' => $this->t('- All statuses -'),\n   297→      'idle' => $this->t('Idle'),\n   298→      'importing' => $this->t('Importing'),\n   299→      'rolling_back' => $this->t('Rolling back'),\n   300→      'completed' => $this->t('Completed'),\n   301→      'failed' => $this->t('Failed'),\n   302→    ];\n   303→\n   304→    $groupOptions = ['' => $this->t('- All groups -')];\n   305→    foreach ($allGroups as $group) {\n   306→      $groupOptions[$group] = $group;\n   307→    }\n   308→\n   309→    return [\n   310→      '#type' => 'container',\n   311→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   312→      'form' => [\n   313→        '#type' => 'html_tag',\n   314→        '#tag' => 'form',\n   315→        '#attributes' => [\n   316→          'method' => 'get',\n   317→          'class' => ['migrate-dashboard-filter-form'],\n   318→        ],\n   319→        'search' => [\n   320→          '#type' => 'html_tag',\n   321→          '#tag' => 'div',\n   322→          '#attributes' => ['class' => ['form-item']],\n   323→          'label' => [\n   324→            '#type' => 'html_tag',\n   325→            '#tag' => 'label',\n   326→            '#attributes' => ['for' => 'edit-search'],\n   327→            '#value' => $this->t('Search'),\n   328→          ],\n   329→          'input' => [\n   330→            '#type' => 'html_tag',\n   331→            '#tag' => 'input',\n   332→            '#attributes' => [\n   333→              'type' => 'text',\n   334→              'name' => 'search',\n   335→              'id' => 'edit-search',\n   336→              'value' => $search,\n   337→              'placeholder' => $this->t('Migration ID or label'),\n   338→              'class' => ['form-text'],\n   339→            ],\n   340→          ],\n   341→        ],\n   342→        'status' => [\n   343→          '#type' => 'html_tag',\n   344→          '#tag' => 'div',\n   345→          '#attributes' => ['class' => ['form-item']],\n   346→          'label' => [\n   347→            '#type' => 'html_tag',\n   348→            '#tag' => 'label',\n   349→            '#attributes' => ['for' => 'edit-status'],\n   350→            '#value' => $this->t('Status'),\n   351→          ],\n   352→          'select' => [\n   353→            '#type' => 'html_tag',\n   354→            '#tag' => 'select',\n   355→            '#attributes' => [\n   356→              'name' => 'status',\n   357→              'id' => 'edit-status',\n   358→              'class' => ['form-select'],\n   359→            ],\n   360→            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n   361→          ],\n   362→        ],\n   363→        'group' => [\n   364→          '#type' => 'html_tag',\n   365→          '#tag' => 'div',\n   366→          '#attributes' => ['class' => ['form-item']],\n   367→          'label' => [\n   368→            '#type' => 'html_tag',\n   369→            '#tag' => 'label',\n   370→            '#attributes' => ['for' => 'edit-group'],\n   371→            '#value' => $this->t('Group'),\n   372→          ],\n   373→          'select' => [\n   374→            '#type' => 'html_tag',\n   375→            '#tag' => 'select',\n   376→            '#attributes' => [\n   377→              'name' => 'group',\n   378→              'id' => 'edit-group',\n   379→              'class' => ['form-select'],\n   380→            ],\n   381→            'options' => $this->buildSelectOptions($groupOptions, $groupFilter),\n   382→          ],\n   383→        ],\n   384→        'actions' => [\n   385→          '#type' => 'html_tag',\n   386→          '#tag' => 'div',\n   387→          '#attributes' => ['class' => ['form-actions']],\n   388→          'submit' => [\n   389→            '#type' => 'html_tag',\n   390→            '#tag' => 'input',\n   391→            '#attributes' => [\n   392→              'type' => 'submit',\n   393→              'value' => $this->t('Filter'),\n   394→              'class' => ['button', 'button--primary'],\n   395→            ],\n   396→          ],\n   397→        ],\n   398→      ],\n   399→    ];\n   400→  }\n   401→\n   402→  /**\n   403→   * Builds select option elements.\n   404→   *\n   405→   * @param array $options\n   406→   *   The options array.\n   407→   * @param string $selectedValue\n   408→   *   The currently selected value.\n   409→   *\n   410→   * @return array\n   411→   *   A render array of option elements.\n   412→   */\n   413→  protected function buildSelectOptions(array $options, string $selectedValue): array {\n   414→    $elements = [];\n   415→    foreach ($options as $value => $label) {\n   416→      $attributes = ['value' => $value];\n   417→      if ((string) $value === $selectedValue) {\n   418→        $attributes['selected'] = 'selected';\n   419→      }\n   420→      $elements[] = [\n   421→        '#type' => 'html_tag',\n   422→        '#tag' => 'option',\n   423→        '#attributes' => $attributes,\n   424→        '#value' => $label,\n   425→      ];\n   426→    }\n   427→    return $elements;\n   428→  }\n   429→\n   430→  /**\n   431→   * Builds a migration group table.\n   432→   *\n   433→   * @param string $group\n   434→   *   The group name.\n   435→   * @param array $migrations\n   436→   *   The migrations in this group.\n   437→   *\n   438→   * @return array\n   439→   *   A render array for the group.\n   440→   */\n   441→  protected function buildGroupTable(string $group, array $migrations): array {\n   442→    $rows = [];\n   443→    foreach ($migrations as $migrationId => $data) {\n   444→      $statusBadge = $this->buildStatusBadge($data['status']);\n   445→\n   446→      $lastRun = $data['last_run']\n   447→        ? $this->dateFormatter->format($data['last_run'], 'short')\n   448→        : $this->t('Never');\n   449→\n   450→      $rows[] = [\n   451→        Link::fromTextAndUrl($data['label'], Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]))->toString(),\n   452→        $data['group'],\n   453→        $statusBadge,\n   454→        $data['source_count'],\n   455→        $data['imported_count'],\n   456→        $data['failed_count'],\n   457→        $lastRun,\n   458→      ];\n   459→    }\n   460→\n   461→    return [\n   462→      '#type' => 'details',\n   463→      '#title' => $this->t('Group: @group (@count)', [\n   464→        '@group' => $group,\n   465→        '@count' => count($migrations),\n   466→      ]),\n   467→      '#open' => TRUE,\n   468→      'table' => [\n   469→        '#type' => 'table',\n   470→        '#header' => [\n   471→          $this->t('Migration'),\n   472→          $this->t('Group'),\n   473→          $this->t('Status'),\n   474→          $this->t('Source count'),\n   475→          $this->t('Imported'),\n   476→          $this->t('Failed'),\n   477→          $this->t('Last run'),\n   478→        ],\n   479→        '#rows' => $rows,\n   480→        '#empty' => $this->t('No migrations in this group.'),\n   481→      ],\n   482→    ];\n   483→  }\n   484→\n   485→  /**\n   486→   * Builds a colored status badge.\n   487→   *\n   488→   * @param string $status\n   489→   *   The migration status.\n   490→   *\n   491→   * @return array|string\n   492→   *   A markup string with the status badge.\n   493→   */\n   494→  protected function buildStatusBadge(string $status): array|string {\n   495→    $labels = [\n   496→      'idle' => $this->t('Idle'),\n   497→      'importing' => $this->t('Importing'),\n   498→      'rolling_back' => $this->t('Rolling back'),\n   499→      'completed' => $this->t('Completed'),\n   500→      'failed' => $this->t('Failed'),\n   501→    ];\n   502→\n   503→    $colors = [\n   504→      'idle' => 'color--success',\n   505→      'importing' => 'color--primary',\n   506→      'rolling_back' => 'color--warning',\n   507→      'completed' => 'color--success',\n   508→      'failed' => 'color--error',\n   509→    ];\n   510→\n   511→    $label = $labels[$status] ?? $status;\n   512→    $colorClass = $colors[$status] ?? '';\n   513→\n   514→    return [\n   515→      'data' => [\n   516→        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n   517→      ],\n   518→    ];\n   519→  }\n   520→\n   521→  /**\n   522→   * Placeholder for the migration detail page.\n   523→   *\n   524→   * @param string $migration_id\n   525→   *   The migration plugin ID.\n   526→   *\n   527→   * @return array\n   528→   *   A render array.\n   529→   */\n   530→  public function detail(string $migration_id): array {\n   531→    return [\n   532→      '#markup' => '<p>' . $this->t('Migration detail page for @id. This will be implemented in a future update.', ['@id' => $migration_id]) . '</p>',\n   533→    ];\n   534→  }\n   535→\n   536→}\n   537→"}]},"parent_tool_use_id":null,"session_id":"c2acd8b5-f80d-48c8-b462-6b0e23d48724","uuid":"659abf6f-8957-4ebe-91ea-cdc7c40bedb1","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_admin/src/Controller/MigrationDashboardController.php","content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace Drupal\\migrate_admin\\Controller;\n\nuse Drupal\\Core\\Controller\\ControllerBase;\nuse Drupal\\Core\\Database\\Connection;\nuse Drupal\\Core\\Datetime\\DateFormatterInterface;\nuse Drupal\\Core\\Link;\nuse Drupal\\Core\\Url;\nuse Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\nuse Symfony\\Component\\DependencyInjection\\ContainerInterface;\nuse Symfony\\Component\\HttpFoundation\\Request;\n\n/**\n * Controller for the migration dashboard page.\n */\nclass MigrationDashboardController extends ControllerBase {\n\n  /**\n   * Constructs a MigrationDashboardController object.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n   *   The migration plugin manager.\n   * @param \\Drupal\\Core\\Database\\Connection $database\n   *   The database connection.\n   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n   *   The date formatter service.\n   */\n  public function __construct(\n    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    protected readonly Connection $database,\n    protected readonly DateFormatterInterface $dateFormatter,\n  ) {}\n\n  /**\n   * {@inheritdoc}\n   */\n  public static function create(ContainerInterface $container): static {\n    return new static(\n      $container->get('plugin.manager.migration'),\n      $container->get('database'),\n      $container->get('date.formatter'),\n    );\n  }\n\n  /**\n   * Builds the migration dashboard page.\n   *\n   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   *   The current request.\n   *\n   * @return array\n   *   A render array.\n   */\n  public function dashboard(Request $request): array {\n    $search = $request->query->get('search', '');\n    $statusFilter = $request->query->get('status', '');\n    $groupFilter = $request->query->get('group', '');\n\n    $migrations = $this->migrationPluginManager->createInstances([]);\n\n    if (empty($migrations)) {\n      return [\n        '#markup' => '<p>' . $this->t('No migrations are currently configured. Configure migrations using migration YAML files or Drush commands.') . '</p>',\n      ];\n    }\n\n    // Collect all groups for the filter dropdown.\n    $allGroups = [];\n    $groupedMigrations = [];\n\n    foreach ($migrations as $migrationId => $migration) {\n      $label = $migration->label() ?: $migrationId;\n      $definition = $migration->getPluginDefinition();\n      $group = $definition['migration_group'] ?? 'default';\n      $allGroups[$group] = $group;\n\n      // Apply text search filter.\n      if ($search !== '' && stripos($migrationId, $search) === FALSE && stripos((string) $label, $search) === FALSE) {\n        continue;\n      }\n\n      // Get migration status.\n      $status = $this->getMigrationStatus($migration);\n\n      // Apply status filter.\n      if ($statusFilter !== '' && $status !== $statusFilter) {\n        continue;\n      }\n\n      // Apply group filter.\n      if ($groupFilter !== '' && $group !== $groupFilter) {\n        continue;\n      }\n\n      // Get counts from map table.\n      $counts = $this->getItemCounts($migrationId);\n\n      // Get source count.\n      $sourceCount = $this->getSourceCount($migration);\n\n      // Get last run timestamp.\n      $lastRun = $this->getLastRunTimestamp($migrationId);\n\n      $groupedMigrations[$group][$migrationId] = [\n        'label' => $label,\n        'group' => $group,\n        'status' => $status,\n        'source_count' => $sourceCount,\n        'imported_count' => $counts['imported'],\n        'failed_count' => $counts['failed'],\n        'last_run' => $lastRun,\n      ];\n    }\n\n    ksort($allGroups);\n\n    $build = [];\n\n    // Filter form.\n    $build['filters'] = $this->buildFilterForm($search, $statusFilter, $groupFilter, $allGroups);\n\n    // Build grouped tables.\n    foreach ($groupedMigrations as $group => $groupMigrations) {\n      $build['group_' . $group] = $this->buildGroupTable($group, $groupMigrations);\n    }\n\n    if (empty($groupedMigrations)) {\n      $build['empty'] = [\n        '#markup' => '<p>' . $this->t('No migrations match the current filters.') . '</p>',\n      ];\n    }\n\n    $build['#attached'] = [\n      'library' => ['migrate_admin/dashboard'],\n    ];\n    $build['#cache'] = [\n      'contexts' => ['url.query_args'],\n      'tags' => ['migration_plugins'],\n    ];\n\n    return $build;\n  }\n\n  /**\n   * Gets the current status of a migration.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   *   The migration plugin instance.\n   *\n   * @return string\n   *   The status string: idle, importing, rolling_back, completed, or failed.\n   */\n  protected function getMigrationStatus($migration): string {\n    $status = $migration->getStatusLabel();\n\n    // Map Drupal's status labels to our internal statuses.\n    $statusString = (string) $status;\n    $statusMap = [\n      'Idle' => 'idle',\n      'Importing' => 'importing',\n      'Rolling back' => 'rolling_back',\n      'Stopping' => 'idle',\n      'Disabled' => 'idle',\n    ];\n\n    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n\n    // Check run log for completed/failed status if currently idle.\n    if ($migrationStatus === 'idle') {\n      $migrationId = $migration->id();\n      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n        ->fields('r', ['status'])\n        ->condition('migration_id', $migrationId)\n        ->orderBy('id', 'DESC')\n        ->range(0, 1)\n        ->execute()\n        ->fetchField();\n\n      if ($lastRun === 'completed') {\n        $migrationStatus = 'completed';\n      }\n      elseif ($lastRun === 'failed') {\n        $migrationStatus = 'failed';\n      }\n    }\n\n    return $migrationStatus;\n  }\n\n  /**\n   * Gets item counts from the map table.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   *\n   * @return array\n   *   Associative array with 'imported', 'needs_update', 'failed' counts.\n   */\n  protected function getItemCounts(string $migrationId): array {\n    $counts = [\n      'imported' => 0,\n      'needs_update' => 0,\n      'failed' => 0,\n    ];\n\n    $table = 'migrate_map_' . $migrationId;\n    if (!$this->database->schema()->tableExists($table)) {\n      return $counts;\n    }\n\n    $results = $this->database->select($table, 'map')\n      ->fields('map', ['source_row_status'])\n      ->groupBy('source_row_status')\n      ->addExpression('COUNT(*)', 'count')\n      ->execute()\n      ->fetchAllKeyed();\n\n    // Status constants: 0 = imported, 1 = needs_update, 2 = failed.\n    $statusMap = [\n      '0' => 'imported',\n      '1' => 'needs_update',\n      '2' => 'failed',\n    ];\n\n    foreach ($results as $status => $count) {\n      $key = $statusMap[(string) $status] ?? NULL;\n      if ($key !== NULL) {\n        $counts[$key] = (int) $count;\n      }\n    }\n\n    return $counts;\n  }\n\n  /**\n   * Gets the source count for a migration.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   *   The migration plugin instance.\n   *\n   * @return int|string\n   *   The source count or 'N/A' if unavailable.\n   */\n  protected function getSourceCount($migration): int|string {\n    try {\n      $source = $migration->getSourcePlugin();\n      $count = $source->count();\n      return $count === -1 ? 'N/A' : $count;\n    }\n    catch (\\Exception $e) {\n      return 'N/A';\n    }\n  }\n\n  /**\n   * Gets the last run timestamp for a migration.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   *\n   * @return int|null\n   *   The timestamp of the last run, or NULL if never run.\n   */\n  protected function getLastRunTimestamp(string $migrationId): ?int {\n    $result = $this->database->select('migrate_suite_run_log', 'r')\n      ->fields('r', ['started'])\n      ->condition('migration_id', $migrationId)\n      ->orderBy('id', 'DESC')\n      ->range(0, 1)\n      ->execute()\n      ->fetchField();\n\n    return $result ? (int) $result : NULL;\n  }\n\n  /**\n   * Builds the filter form.\n   *\n   * @param string $search\n   *   Current search value.\n   * @param string $statusFilter\n   *   Current status filter.\n   * @param string $groupFilter\n   *   Current group filter.\n   * @param array $allGroups\n   *   All available migration groups.\n   *\n   * @return array\n   *   A render array for the filter form.\n   */\n  protected function buildFilterForm(string $search, string $statusFilter, string $groupFilter, array $allGroups): array {\n    $statusOptions = [\n      '' => $this->t('- All statuses -'),\n      'idle' => $this->t('Idle'),\n      'importing' => $this->t('Importing'),\n      'rolling_back' => $this->t('Rolling back'),\n      'completed' => $this->t('Completed'),\n      'failed' => $this->t('Failed'),\n    ];\n\n    $groupOptions = ['' => $this->t('- All groups -')];\n    foreach ($allGroups as $group) {\n      $groupOptions[$group] = $group;\n    }\n\n    return [\n      '#type' => 'container',\n      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n      'form' => [\n        '#type' => 'html_tag',\n        '#tag' => 'form',\n        '#attributes' => [\n          'method' => 'get',\n          'class' => ['migrate-dashboard-filter-form'],\n        ],\n        'search' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-search'],\n            '#value' => $this->t('Search'),\n          ],\n          'input' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'text',\n              'name' => 'search',\n              'id' => 'edit-search',\n              'value' => $search,\n              'placeholder' => $this->t('Migration ID or label'),\n              'class' => ['form-text'],\n            ],\n          ],\n        ],\n        'status' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-status'],\n            '#value' => $this->t('Status'),\n          ],\n          'select' => [\n            '#type' => 'html_tag',\n            '#tag' => 'select',\n            '#attributes' => [\n              'name' => 'status',\n              'id' => 'edit-status',\n              'class' => ['form-select'],\n            ],\n            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n          ],\n        ],\n        'group' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-group'],\n            '#value' => $this->t('Group'),\n          ],\n          'select' => [\n            '#type' => 'html_tag',\n            '#tag' => 'select',\n            '#attributes' => [\n              'name' => 'group',\n              'id' => 'edit-group',\n              'class' => ['form-select'],\n            ],\n            'options' => $this->buildSelectOptions($groupOptions, $groupFilter),\n          ],\n        ],\n        'actions' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-actions']],\n          'submit' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'submit',\n              'value' => $this->t('Filter'),\n              'class' => ['button', 'button--primary'],\n            ],\n          ],\n        ],\n      ],\n    ];\n  }\n\n  /**\n   * Builds select option elements.\n   *\n   * @param array $options\n   *   The options array.\n   * @param string $selectedValue\n   *   The currently selected value.\n   *\n   * @return array\n   *   A render array of option elements.\n   */\n  protected function buildSelectOptions(array $options, string $selectedValue): array {\n    $elements = [];\n    foreach ($options as $value => $label) {\n      $attributes = ['value' => $value];\n      if ((string) $value === $selectedValue) {\n        $attributes['selected'] = 'selected';\n      }\n      $elements[] = [\n        '#type' => 'html_tag',\n        '#tag' => 'option',\n        '#attributes' => $attributes,\n        '#value' => $label,\n      ];\n    }\n    return $elements;\n  }\n\n  /**\n   * Builds a migration group table.\n   *\n   * @param string $group\n   *   The group name.\n   * @param array $migrations\n   *   The migrations in this group.\n   *\n   * @return array\n   *   A render array for the group.\n   */\n  protected function buildGroupTable(string $group, array $migrations): array {\n    $rows = [];\n    foreach ($migrations as $migrationId => $data) {\n      $statusBadge = $this->buildStatusBadge($data['status']);\n\n      $lastRun = $data['last_run']\n        ? $this->dateFormatter->format($data['last_run'], 'short')\n        : $this->t('Never');\n\n      $rows[] = [\n        Link::fromTextAndUrl($data['label'], Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]))->toString(),\n        $data['group'],\n        $statusBadge,\n        $data['source_count'],\n        $data['imported_count'],\n        $data['failed_count'],\n        $lastRun,\n      ];\n    }\n\n    return [\n      '#type' => 'details',\n      '#title' => $this->t('Group: @group (@count)', [\n        '@group' => $group,\n        '@count' => count($migrations),\n      ]),\n      '#open' => TRUE,\n      'table' => [\n        '#type' => 'table',\n        '#header' => [\n          $this->t('Migration'),\n          $this->t('Group'),\n          $this->t('Status'),\n          $this->t('Source count'),\n          $this->t('Imported'),\n          $this->t('Failed'),\n          $this->t('Last run'),\n        ],\n        '#rows' => $rows,\n        '#empty' => $this->t('No migrations in this group.'),\n      ],\n    ];\n  }\n\n  /**\n   * Builds a colored status badge.\n   *\n   * @param string $status\n   *   The migration status.\n   *\n   * @return array|string\n   *   A markup string with the status badge.\n   */\n  protected function buildStatusBadge(string $status): array|string {\n    $labels = [\n      'idle' => $this->t('Idle'),\n      'importing' => $this->t('Importing'),\n      'rolling_back' => $this->t('Rolling back'),\n      'completed' => $this->t('Completed'),\n      'failed' => $this->t('Failed'),\n    ];\n\n    $colors = [\n      'idle' => 'color--success',\n      'importing' => 'color--primary',\n      'rolling_back' => 'color--warning',\n      'completed' => 'color--success',\n      'failed' => 'color--error',\n    ];\n\n    $label = $labels[$status] ?? $status;\n    $colorClass = $colors[$status] ?? '';\n\n    return [\n      'data' => [\n        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n      ],\n    ];\n  }\n\n  /**\n   * Placeholder for the migration detail page.\n   *\n   * @param string $migration_id\n   *   The migration plugin ID.\n   *\n   * @return array\n   *   A render array.\n   */\n  public function detail(string $migration_id): array {\n    return [\n      '#markup' => '<p>' . $this->t('Migration detail page for @id. This will be implemented in a future update.', ['@id' => $migration_id]) . '</p>',\n    ];\n  }\n\n}\n","numLines":537,"startLine":1,"totalLines":537}}}
