{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ls9LuvKkQHg2a3bqasvyBJ","type":"tool_result","content":"     1→<?php\n     2→\n     3→/**\n     4→ * @file\n     5→ * Install, update, and uninstall functions for Migrate Suite.\n     6→ */\n     7→\n     8→/**\n     9→ * Implements hook_schema().\n    10→ */\n    11→function migrate_suite_schema(): array {\n    12→  $schema['migrate_suite_run_log'] = [\n    13→    'description' => 'Stores migration run history.',\n    14→    'fields' => [\n    15→      'id' => [\n    16→        'description' => 'Primary key.',\n    17→        'type' => 'serial',\n    18→        'unsigned' => TRUE,\n    19→        'not null' => TRUE,\n    20→      ],\n    21→      'migration_id' => [\n    22→        'description' => 'The migration plugin ID.',\n    23→        'type' => 'varchar',\n    24→        'length' => 255,\n    25→        'not null' => TRUE,\n    26→        'default' => '',\n    27→      ],\n    28→      'status' => [\n    29→        'description' => 'Run status: idle, running, completed, failed.',\n    30→        'type' => 'varchar',\n    31→        'length' => 32,\n    32→        'not null' => TRUE,\n    33→        'default' => 'idle',\n    34→      ],\n    35→      'started' => [\n    36→        'description' => 'Timestamp when the run started.',\n    37→        'type' => 'int',\n    38→        'not null' => TRUE,\n    39→        'default' => 0,\n    40→      ],\n    41→      'finished' => [\n    42→        'description' => 'Timestamp when the run finished.',\n    43→        'type' => 'int',\n    44→        'not null' => FALSE,\n    45→        'default' => NULL,\n    46→      ],\n    47→      'items_processed' => [\n    48→        'description' => 'Number of items processed.',\n    49→        'type' => 'int',\n    50→        'unsigned' => TRUE,\n    51→        'not null' => TRUE,\n    52→        'default' => 0,\n    53→      ],\n    54→      'items_created' => [\n    55→        'description' => 'Number of items created.',\n    56→        'type' => 'int',\n    57→        'unsigned' => TRUE,\n    58→        'not null' => TRUE,\n    59→        'default' => 0,\n    60→      ],\n    61→      'items_updated' => [\n    62→        'description' => 'Number of items updated.',\n    63→        'type' => 'int',\n    64→        'unsigned' => TRUE,\n    65→        'not null' => TRUE,\n    66→        'default' => 0,\n    67→      ],\n    68→      'items_failed' => [\n    69→        'description' => 'Number of items that failed.',\n    70→        'type' => 'int',\n    71→        'unsigned' => TRUE,\n    72→        'not null' => TRUE,\n    73→        'default' => 0,\n    74→      ],\n    75→    ],\n    76→    'primary key' => ['id'],\n    77→    'indexes' => [\n    78→      'migration_id' => ['migration_id'],\n    79→      'status' => ['status'],\n    80→    ],\n    81→  ];\n    82→\n    83→  return $schema;\n    84→}\n    85→"}]},"parent_tool_use_id":"toolu_01PnAFK2r5kSh8K8TwvF49xg","session_id":"47a3c04a-88ca-462e-9d23-1a6a80ee0429","uuid":"c5debac5-8ebe-4bba-958e-be62bfa35470"}
