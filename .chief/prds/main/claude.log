  214→   */\n   215→  public static function batchFinished(bool $success, array $results, array $operations): void {\n   216→    if (!empty($results['errors'])) {\n   217→      foreach ($results['errors'] as $error) {\n   218→        \\Drupal::messenger()->addError($error);\n   219→      }\n   220→      return;\n   221→    }\n   222→\n   223→    if ($success && isset($results['status'])) {\n   224→      $label = $results['migration_label'] ?? $results['migration_id'] ?? 'Unknown';\n   225→\n   226→      if ($results['status'] === MigrationInterface::RESULT_COMPLETED) {\n   227→        \\Drupal::messenger()->addStatus(t('Migration %migration rollback completed successfully.', [\n   228→          '%migration' => $label,\n   229→        ]));\n   230→      }\n   231→      else {\n   232→        \\Drupal::messenger()->addWarning(t('Migration %migration rollback finished with status: @status.', [\n   233→          '%migration' => $label,\n   234→          '@status' => $results['status'],\n   235→        ]));\n   236→      }\n   237→    }\n   238→    else {\n   239→      \\Drupal::messenger()->addError(t('An error occurred during the migration rollback.'));\n   240→    }\n   241→  }\n   242→\n   243→  /**\n   244→   * Checks if the current user has permission to rollback this migration.\n   245→   */\n   246→  protected function checkRollbackAccess(): void {\n   247→    if ($this->migrateAccessCheck !== NULL) {\n   248→      if (!$this->migrateAccessCheck->canRollbackMigration($this->currentUser, $this->migrationId)) {\n   249→        throw new AccessDeniedHttpException();\n   250→      }\n   251→    }\n   252→    elseif (!$this->currentUser->hasPermission('administer migrations') && !$this->currentUser->hasPermission('administer site configuration')) {\n   253→      throw new AccessDeniedHttpException();\n   254→    }\n   255→  }\n   256→\n   257→  /**\n   258→   * Gets the imported item count for this migration.\n   259→   *\n   260→   * @return int|null\n   261→   *   The imported count, or NULL if map table doesn't exist.\n   262→   */\n   263→  protected function getImportedCount(): ?int {\n   264→    $mapTable = 'migrate_map_' . $this->migrationId;\n   265→    if (!$this->database->schema()->tableExists($mapTable)) {\n   266→      return NULL;\n   267→    }\n   268→\n   269→    return (int) $this->database->select($mapTable, 'map')\n   270→      ->condition('source_row_status', 0)\n   271→      ->countQuery()\n   272→      ->execute()\n   273→      ->fetchField();\n   274→  }\n   275→\n   276→  /**\n   277→   * Checks for migrations that depend on this one.\n   278→   *\n   279→   * @return array\n   280→   *   Array of warning message strings.\n   281→   */\n   282→  protected function checkDependents(): array {\n   283→    $warnings = [];\n   284→\n   285→    try {\n   286→      $allMigrations = $this->migrationPluginManager->createInstances([]);\n   287→    }\n   288→    catch (\\Exception $e) {\n   289→      return $warnings;\n   290→    }\n   291→\n   292→    foreach ($allMigrations as $otherId => $otherMigration) {\n   293→      if ($otherId === $this->migrationId) {\n   294→        continue;\n   295→      }\n   296→\n   297→      $definition = $otherMigration->getPluginDefinition();\n   298→      $requirements = $definition['migration_dependencies']['required'] ?? [];\n   299→\n   300→      if (in_array($this->migrationId, $requirements, TRUE)) {\n   301→        $mapTable = 'migrate_map_' . $otherId;\n   302→        if ($this->database->schema()->tableExists($mapTable)) {\n   303→          $importedCount = (int) $this->database->select($mapTable, 'map')\n   304→            ->condition('source_row_status', 0)\n   305→            ->countQuery()\n   306→            ->execute()\n   307→            ->fetchField();\n   308→\n   309→          if ($importedCount > 0) {\n   310→            $label = $otherMigration->label() ?: $otherId;\n   311→            $warnings[] = $this->t('Migration %migration depends on this migration and 