{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EGzxSfRZG3E1RFoi86feAT","type":"tool_result","content":"     1→migrate_admin.dashboard:\n     2→  path: '/admin/structure/migrate-suite'\n     3→  defaults:\n     4→    _controller: '\\Drupal\\migrate_admin\\Controller\\MigrationDashboardController::dashboard'\n     5→    _title: 'Migration Dashboard'\n     6→  requirements:\n     7→    _permission: 'view migrate suite dashboard'\n     8→\n     9→migrate_admin.migration_detail:\n    10→  path: '/admin/structure/migrate-suite/{migration_id}'\n    11→  defaults:\n    12→    _controller: '\\Drupal\\migrate_admin\\Controller\\MigrationDashboardController::detail'\n    13→    _title: 'Migration Detail'\n    14→  requirements:\n    15→    _permission: 'view migrate suite dashboard'\n    16→"}]},"parent_tool_use_id":null,"session_id":"c2acd8b5-f80d-48c8-b462-6b0e23d48724","uuid":"70201206-6a8d-4872-bd7f-f618237b93d6","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_admin/migrate_admin.routing.yml","content":"migrate_admin.dashboard:\n  path: '/admin/structure/migrate-suite'\n  defaults:\n    _controller: '\\Drupal\\migrate_admin\\Controller\\MigrationDashboardController::dashboard'\n    _title: 'Migration Dashboard'\n  requirements:\n    _permission: 'view migrate suite dashboard'\n\nmigrate_admin.migration_detail:\n  path: '/admin/structure/migrate-suite/{migration_id}'\n  defaults:\n    _controller: '\\Drupal\\migrate_admin\\Controller\\MigrationDashboardController::detail'\n    _title: 'Migration Detail'\n  requirements:\n    _permission: 'view migrate suite dashboard'\n","numLines":16,"startLine":1,"totalLines":16}}}
