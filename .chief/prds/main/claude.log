> ['class' => ['migrate-health-summary']],\n      'healthy' => [\n        '#type' => 'html_tag',\n        '#tag' => 'div',\n        '#attributes' => ['class' => ['migrate-health-summary-item']],\n        '#value' => '<span class=\"health-badge health--healthy\">' . $summary[MigrationHealthAnalyzer::HEALTHY] . '</span> ' . $this->t('healthy'),\n      ],\n      'stale' => [\n        '#type' => 'html_tag',\n        '#tag' => 'div',\n        '#attributes' => ['class' => ['migrate-health-summary-item']],\n        '#value' => '<span class=\"health-badge health--stale\">' . $summary[MigrationHealthAnalyzer::STALE] . '</span> ' . $this->t('stale'),\n      ],\n      'failing' => [\n        '#type' => 'html_tag',\n        '#tag' => 'div',\n        '#attributes' => ['class' => ['migrate-health-summary-item']],\n        '#value' => '<span class=\"health-badge health--failing\">' . $summary[MigrationHealthAnalyzer::FAILING] . '</span> ' . $this->t('failing'),\n      ],\n    ];\n  }\n\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1333,"cache_read_input_tokens":67842,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1333},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"47a3c04a-88ca-462e-9d23-1a6a80ee0429","uuid":"ad2b733c-6814-439e-a0f8-8917c48bf397"}
