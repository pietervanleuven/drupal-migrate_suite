unt,\n   142→        'imported_count' => $counts['imported'],\n   143→        'failed_count' => $counts['failed'],\n   144→        'last_run' => $lastRun,\n   145→        'can_run' => $canRun,\n   146→        'can_rollback' => $canRollback,\n   147→      ];\n   148→    }\n   149→\n   150→    ksort($allGroups);\n   151→\n   152→    $build = [];\n   153→\n   154→    // Filter form.\n   155→    $build['filters'] = $this->buildFilterForm($search, $statusFilter, $groupFilter, $allGroups);\n   156→\n   157→    // Build grouped tables.\n   158→    foreach ($groupedMigrations as $group => $groupMigrations) {\n   159→      $build['group_' . $group] = $this->buildGroupTable($group, $groupMigrations);\n   160→    }\n   161→\n   162→    if (empty($groupedMigrations)) {\n   163→      if ($permissionsModuleEnabled && $search === '' && $statusFilter === '' && $groupFilter === '') {\n   164→        $build['empty'] = [\n   165→          '#markup' => '<p>' . $this->t('You do not have permission to view any migrations. Contact your site administrator to grant you per-migration view permissions.') . '</p>',\n   166→        ];\n   167→      }\n   168→      else {\n   169→        $build['empty'] = [\n   170→          '#markup' => '<p>' . $this->t('No migrations match the current filters.') . '</p>',\n   171→        ];\n   172→      }\n   173→    }\n   174→\n   175→    $build['#attached'] = [\n   176→      'library' => ['migrate_admin/dashboard'],\n   177→    ];\n   178→    $build['#cache'] = [\n   179→      'contexts' => ['url.query_args'],\n   180→      'tags' => ['migration_plugins'],\n   181→    ];\n   182→\n   183→    return $build;\n   184→  }\n   185→\n   186→  /**\n   187→   * Gets the current status of a migration.\n   188→   *\n   189→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   190→   *   The migration plugin instance.\n   191→   *\n   192→   * @return string\n   193→   *   The status string: idle, importing, rolling_back, completed, or failed.\n   194→   */\n   195→  protected function getMigrationStatus($migration): string {\n   196→    $status = $migration->getStatusLabel();\n   197→\n   198→    // Map Drupal's status labels to our internal statuses.\n   199→    $statusString = (string) $status;\n   200→    $statusMap = [\n   201→      'Idle' => 'idle',\n   202→      'Importing' => 'importing',\n   203→      'Rolling back' => 'rolling_back',\n   204→      'Stopping' => 'idle',\n   205→      'Disabled' => 'idle',\n   206→    ];\n   207→\n   208→    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n   209→\n   210→    // Check run log for completed/failed status if currently idle.\n   211→    if ($migrationStatus === 'idle') {\n   212→      $migrationId = $migration->id();\n   213→      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   214→        ->fields('r', ['status'])\n   215→        ->condition('migration_id', $migrationId)\n   216→        ->orderBy('id', 'DESC')\n   217→        ->range(0, 1)\n   218→        ->execute()\n   219→        ->fetchField();\n   220→\n   221→      if ($lastRun === 'completed') {\n   222→        $migrationStatus = 'completed';\n   223→      }\n   224→      elseif ($lastRun === 'failed') {\n   225→        $migrationStatus = 'failed';\n   226→      }\n   227→    }\n   228→\n   229→    return $migrationStatus;\n   230→  }\n   231→\n   232→  /**\n   233→   * Gets item counts from the map table.\n   234→   *\n   235→   * @param string $migrationId\n   236→   *   The migration ID.\n   237→   *\n   238→   * @return array\n   239→   *   Associative array with 'imported', 'needs_update', 'failed' counts.\n   240→   */\n   241→  protected function getItemCounts(string $migrationId): array {\n   242→    $counts = [\n   243→      'imported' => 0,\n   244→      'needs_update' => 0,\n   245→      'failed' => 0,\n   246→    ];\n   247→\n   248→    $table = 'migrate_map_' . $migrationId;\n   249→    if (!$this->database->schema()->tableExists($table)) {\n   250→      return $counts;\n   251→    }\n   252→\n   253→    $results = $this->database->select($table, 'map')\n   254→      ->fields('map', ['source_row_status'])\n   255→      ->groupBy('source_row_status')\n   256→      ->addExpression('COUNT(*)', 'count')\n   257→      ->execute()\n   258→      ->fetchAllKeyed();\n   259→\n   260→    // Status constants: 0 = imported, 1 = needs_update, 2 = failed.\n   261→    $statusMap = [\n   262→      '0' => 'imported',\n   263→      '1' => 'needs_update',\n   264→      '2' => 'failed',\n   265→    ];\n   266→\n   267→    foreach ($results as $status => $count) {\n   268→      $key = $statusMap[(string) $status] ?? NULL;\n   269→      if ($key !== NULL) {\n   270→        $counts[$key] = (int) $count;\n   271→      }\n   272→    }\n   273→\n   274→    return $counts;\n   275→  }\n   276→\n   277→  /**\n   278→   * Gets the source count for a migration.\n   279→   *\n   280→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   281→   *   The migration plugin instance.\n   282→   *\n   283→   * @return int|string\n   284→   *   The source count or 'N/A' if unavailable.\n   285→   */\n   286→  protected function getSourceCount($migration): int|string {\n   287→    try {\n   288→      $source = $migration->getSourcePlugin();\n   289→      $count = $source->count();\n   290→      return $count === -1 ? 'N/A' : $count;\n   291→    }\n   292→    catch (\\Exception $e) {\n   293→      return 'N/A';\n   294→    }\n   295→  }\n   296→\n   297→  /**\n   298→   * Gets the last run timestamp for a migration.\n   299→   *\n   300→   * @param string $migrationId\n   301→   *   The migration ID.\n   302→   *\n   303→   * @return int|null\n   304→   *   The timestamp of the last run, or NULL if never run.\n   305→   */\n   306→  protected function getLastRunTimestamp(string $migrationId): ?int {\n   307→    $result = $this->database->select('migrate_suite_run_log', 'r')\n   308→      ->fields('r', ['started'])\n   309→      ->condition