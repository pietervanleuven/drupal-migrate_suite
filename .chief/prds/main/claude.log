{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CuqpjzEUFuzFVZEPcUrphr","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_admin\\Controller;\n     6→\n     7→use Drupal\\Core\\Controller\\ControllerBase;\n     8→use Drupal\\Core\\Database\\Connection;\n     9→use Drupal\\Core\\Datetime\\DateFormatterInterface;\n    10→use Drupal\\Core\\Url;\n    11→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    12→use Symfony\\Component\\DependencyInjection\\ContainerInterface;\n    13→use Symfony\\Component\\HttpFoundation\\Request;\n    14→use Symfony\\Component\\HttpKernel\\Exception\\NotFoundHttpException;\n    15→\n    16→/**\n    17→ * Controller for the migration detail page.\n    18→ */\n    19→class MigrationDetailController extends ControllerBase {\n    20→\n    21→  /**\n    22→   * Number of items per page.\n    23→   */\n    24→  protected const ITEMS_PER_PAGE = 50;\n    25→\n    26→  /**\n    27→   * Constructs a MigrationDetailController object.\n    28→   *\n    29→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    30→   *   The migration plugin manager.\n    31→   * @param \\Drupal\\Core\\Database\\Connection $database\n    32→   *   The database connection.\n    33→   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n    34→   *   The date formatter service.\n    35→   */\n    36→  public function __construct(\n    37→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    38→    protected readonly Connection $database,\n    39→    protected readonly DateFormatterInterface $dateFormatter,\n    40→  ) {}\n    41→\n    42→  /**\n    43→   * {@inheritdoc}\n    44→   */\n    45→  public static function create(ContainerInterface $container): static {\n    46→    return new static(\n    47→      $container->get('plugin.manager.migration'),\n    48→      $container->get('database'),\n    49→      $container->get('date.formatter'),\n    50→    );\n    51→  }\n    52→\n    53→  /**\n    54→   * Builds the migration detail page.\n    55→   *\n    56→   * @param string $migration_id\n    57→   *   The migration plugin ID.\n    58→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n    59→   *   The current request.\n    60→   *\n    61→   * @return array\n    62→   *   A render array.\n    63→   */\n    64→  public function detail(string $migration_id, Request $request): array {\n    65→    $migration = $this->loadMigration($migration_id);\n    66→\n    67→    $definition = $migration->getPluginDefinition();\n    68→    $group = $definition['migration_group'] ?? 'default';\n    69→    $sourcePlugin = $definition['source']['plugin'] ?? $this->t('Unknown');\n    70→    $destinationPlugin = $definition['destination']['plugin'] ?? $this->t('Unknown');\n    71→\n    72→    // Get status.\n    73→    $status = $this->getMigrationStatus($migration);\n    74→\n    75→    // Get last run stats.\n    76→    $lastRun = $this->getLastRunStats($migration_id);\n    77→\n    78→    // Build summary section.\n    79→    $build = [];\n    80→\n    81→    $build['summary'] = [\n    82→      '#type' => 'details',\n    83→      '#title' => $this->t('Summary'),\n    84→      '#open' => TRUE,\n    85→      'table' => [\n    86→        '#type' => 'table',\n    87→        '#rows' => [\n    88→          [$this->t('Migration'), $migration->label() ?: $migration_id],\n    89→          [$this->t('Group'), $group],\n    90→          [$this->t('Source plugin'), $sourcePlugin],\n    91→          [$this->t('Destination plugin'), $destinationPlugin],\n    92→          [$this->t('Status'), $this->buildStatusBadge($status)],\n    93→          [$this->t('Last run'), $lastRun ? $this->buildLastRunSummary($lastRun) : $this->t('Never')],\n    94→        ],\n    95→      ],\n    96→    ];\n    97→\n    98→    // Build tabs.\n    99→    $build['tabs'] = [\n   100→      '#type' => 'container',\n   101→      '#attributes' => ['class' => ['migrate-detail-tabs']],\n   102→      'items_tab' => [\n   103→        '#type' => 'html_tag',\n   104→        '#tag' => 'a',\n   105→        '#value' => $this->t('Imported Items'),\n   106→        '#attributes' => [\n   107→          'href' => Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migration_id])->toString(),\n   108→          'class' => ['migrate-tab', 'migrate-tab--active'],\n   109→        ],\n   110→      ],\n   111→      'messages_tab' => [\n   112→        '#type' => 'html_tag',\n   113→        '#tag' => 'a',\n   114→        '#value' => $this->t('Messages'),\n   115→        '#attributes' => [\n   116→          'href' => Url::fromRoute('migrate_admin.migration_messages', ['migration_id' => $migration_id])->toString(),\n   117→          'class' => ['migrate-tab'],\n   118→        ],\n   119→      ],\n   120→    ];\n   121→\n   122→    // Build imported items section.\n   123→    $build['items'] = $this->buildImportedItemsSection($migration_id, $request);\n   124→\n   125→    $build['#attached'] = [\n   126→      'library' => ['migrate_admin/dashboard'],\n   127→    ];\n   128→    $build['#cache'] = [\n   129→      'contexts' => ['url.query_args', 'url.path'],\n   130→      'tags' => ['migration_plugins'],\n   131→    ];\n   132→\n   133→    return $build;\n   134→  }\n   135→\n   136→  /**\n   137→   * Builds the migration messages page.\n   138→   *\n   139→   * @param string $migration_id\n   140→   *   The migration plugin ID.\n   141→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   142→   *   The current request.\n   143→   *\n   144→   * @return array\n   145→   *   A render array.\n   146→   */\n   147→  public function messages(string $migration_id, Request $request): array {\n   148→    $migration = $this->loadMigration($migration_id);\n   149→\n   150→    $build = [];\n   151→\n   152→    // Build tabs