{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013nUxYwChpo2FiQUgUt4iue","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_permissions;\n     6→\n     7→use Drupal\\Core\\DependencyInjection\\ContainerInjectionInterface;\n     8→use Drupal\\Core\\StringTranslation\\StringTranslationTrait;\n     9→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    10→use Symfony\\Component\\DependencyInjection\\ContainerInterface;\n    11→\n    12→/**\n    13→ * Provides dynamic per-migration permissions.\n    14→ */\n    15→class MigratePermissions implements ContainerInjectionInterface {\n    16→\n    17→  use StringTranslationTrait;\n    18→\n    19→  public function __construct(\n    20→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    21→  ) {}\n    22→\n    23→  /**\n    24→   * {@inheritdoc}\n    25→   */\n    26→  public static function create(ContainerInterface $container): static {\n    27→    return new static(\n    28→      $container->get('plugin.manager.migration'),\n    29→    );\n    30→  }\n    31→\n    32→  /**\n    33→   * Returns an array of per-migration view permissions.\n    34→   *\n    35→   * @return array\n    36→   *   An array of permission definitions keyed by permission machine name.\n    37→   */\n    38→  public function permissions(): array {\n    39→    $permissions = [];\n    40→\n    41→    try {\n    42→      $migrations = $this->migrationPluginManager->createInstances([]);\n    43→    }\n    44→    catch (\\Exception $e) {\n    45→      return $permissions;\n    46→    }\n    47→\n    48→    foreach ($migrations as $migration_id => $migration) {\n    49→      $label = $migration->label() ?: $migration_id;\n    50→      $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower((string) $migration_id));\n    51→\n    52→      $permissions[\"view migration $safe_id\"] = [\n    53→        'title' => $this->t('View migration: @label', ['@label' => $label]),\n    54→        'description' => $this->t('Allows viewing the @label migration on the Migrate Suite dashboard.', ['@label' => $label]),\n    55→      ];\n    56→    }\n    57→\n    58→    return $permissions;\n    59→  }\n    60→\n    61→}\n    62→"}]},"parent_tool_use_id":"toolu_01JAmBAdd5ZHjEG9NHm5kRWQ","session_id":"d40015d6-5dc4-4d37-b8ef-a7f6409020fa","uuid":"fc5668f5-905a-4990-b660-82f67509f1d9"}
