{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017wu2UGYba65LsKeFeTn2KA","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_permissions;\n     6→\n     7→use Drupal\\Core\\Session\\AccountInterface;\n     8→\n     9→/**\n    10→ * Checks per-migration view access.\n    11→ */\n    12→class MigrateAccessCheck {\n    13→\n    14→  /**\n    15→   * Checks if a user can view a specific migration.\n    16→   *\n    17→   * @param \\Drupal\\Core\\Session\\AccountInterface $account\n    18→   *   The user account to check.\n    19→   * @param string $migration_id\n    20→   *   The migration plugin ID.\n    21→   *\n    22→   * @return bool\n    23→   *   TRUE if the user can view this migration.\n    24→   */\n    25→  public function canViewMigration(AccountInterface $account, string $migration_id): bool {\n    26→    // Bypass for admin-level permissions.\n    27→    if ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n    28→      return TRUE;\n    29→    }\n    30→\n    31→    $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower($migration_id));\n    32→    return $account->hasPermission(\"view migration $safe_id\");\n    33→  }\n    34→\n    35→}\n    36→"}]},"parent_tool_use_id":null,"session_id":"d40015d6-5dc4-4d37-b8ef-a7f6409020fa","uuid":"89bb0b3e-6f89-44e5-8d47-13dc95c20fd3","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_permissions/src/MigrateAccessCheck.php","content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace Drupal\\migrate_permissions;\n\nuse Drupal\\Core\\Session\\AccountInterface;\n\n/**\n * Checks per-migration view access.\n */\nclass MigrateAccessCheck {\n\n  /**\n   * Checks if a user can view a specific migration.\n   *\n   * @param \\Drupal\\Core\\Session\\AccountInterface $account\n   *   The user account to check.\n   * @param string $migration_id\n   *   The migration plugin ID.\n   *\n   * @return bool\n   *   TRUE if the user can view this migration.\n   */\n  public function canViewMigration(AccountInterface $account, string $migration_id): bool {\n    // Bypass for admin-level permissions.\n    if ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n      return TRUE;\n    }\n\n    $safe_id = preg_replace('/[^a-z0-9_]/', '_', strtolower($migration_id));\n    return $account->hasPermission(\"view migration $safe_id\");\n  }\n\n}\n","numLines":36,"startLine":1,"totalLines":36}}}
