{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Se1GP2wv1ruwYXg4t55HFU","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_admin\\Controller;\n     6→\n     7→use Drupal\\Core\\Controller\\ControllerBase;\n     8→use Drupal\\Core\\Database\\Connection;\n     9→use Drupal\\Core\\Datetime\\DateFormatterInterface;\n    10→use Drupal\\Core\\Extension\\ModuleHandlerInterface;\n    11→use Drupal\\Core\\Link;\n    12→use Drupal\\Core\\Url;\n    13→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    14→use Drupal\\migrate_permissions\\MigrateAccessCheck;\n    15→use Symfony\\Component\\DependencyInjection\\ContainerInterface;\n    16→use Symfony\\Component\\HttpFoundation\\Request;\n    17→\n    18→/**\n    19→ * Controller for the migration dashboard page.\n    20→ */\n    21→class MigrationDashboardController extends ControllerBase {\n    22→\n    23→  /**\n    24→   * Constructs a MigrationDashboardController object.\n    25→   *\n    26→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    27→   *   The migration plugin manager.\n    28→   * @param \\Drupal\\Core\\Database\\Connection $database\n    29→   *   The database connection.\n    30→   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n    31→   *   The date formatter service.\n    32→   */\n    33→  public function __construct(\n    34→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    35→    protected readonly Connection $database,\n    36→    protected readonly DateFormatterInterface $dateFormatter,\n    37→    protected readonly ModuleHandlerInterface $moduleHandler,\n    38→    protected readonly ?MigrateAccessCheck $migrateAccessCheck,\n    39→  ) {}\n    40→\n    41→  /**\n    42→   * {@inheritdoc}\n    43→   */\n    44→  public static function create(ContainerInterface $container): static {\n    45→    $migrateAccessCheck = $container->get('module_handler')->moduleExists('migrate_permissions')\n    46→      ? $container->get('migrate_permissions.access_check')\n    47→      : NULL;\n    48→\n    49→    return new static(\n    50→      $container->get('plugin.manager.migration'),\n    51→      $container->get('database'),\n    52→      $container->get('date.formatter'),\n    53→      $container->get('module_handler'),\n    54→      $migrateAccessCheck,\n    55→    );\n    56→  }\n    57→\n    58→  /**\n    59→   * Builds the migration dashboard page.\n    60→   *\n    61→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n    62→   *   The current request.\n    63→   *\n    64→   * @return array\n    65→   *   A render array.\n    66→   */\n    67→  public function dashboard(Request $request): array {\n    68→    $search = $request->query->get('search', '');\n    69→    $statusFilter = $request->query->get('status', '');\n    70→    $groupFilter = $request->query->get('group', '');\n    71→\n    72→    $migrations = $this->migrationPluginManager->createInstances([]);\n    73→\n    74→    if (empty($migrations)) {\n    75→      return [\n    76→        '#markup' => '<p>' . $this->t('No migrations are currently configured. Configure migrations using migration YAML files or Drush commands.') . '</p>',\n    77→      ];\n    78→    }\n    79→\n    80→    // Collect all groups for the filter dropdown.\n    81→    $allGroups = [];\n    82→    $groupedMigrations = [];\n    83→\n    84→    $account = $this->currentUser();\n    85→    $permissionsModuleEnabled = $this->migrateAccessCheck !== NULL;\n    86→\n    87→    foreach ($migrations as $migrationId => $migration) {\n    88→      // Apply per-migration view permission filter.\n    89→      if ($permissionsModuleEnabled && !$this->migrateAccessCheck->canViewMigration($account, $migrationId)) {\n    90→        continue;\n    91→      }\n    92→\n    93→      $label = $migration->label() ?: $migrationId;\n    94→      $definition = $migration->getPluginDefinition();\n    95→      $group = $definition['migration_group'] ?? 'default';\n    96→      $allGroups[$group] = $group;\n    97→\n    98→      // Apply text search filter.\n    99→      if ($search !== '' && stripos($migrationId, $search) === FALSE && stripos((string) $label, $search) === FALSE) {\n   100→        continue;\n   101→      }\n   102→\n   103→      // Get migration status.\n   104→      $status = $this->getMigrationStatus($migration);\n   105→\n   106→      // Apply status filter.\n   107→      if ($statusFilter !== '' && $status !== $statusFilter) {\n   108→        continue;\n   109→      }\n   110→\n   111→      // Apply group filter.\n   112→      if ($groupFilter !== '' && $group !== $groupFilter) {\n   113→        continue;\n   114→      }\n   115→\n   116→      // Get counts from map table.\n   117→      $counts = $this->getItemCounts($migrationId);\n   118→\n   119→      // Get source count.\n   120→      $sourceCount = $this->getSourceCount($migration);\n   121→\n   122→      // Get last run timestamp.\n   123→      $lastRun = $this->getLastRunTimestamp($migrationId);\n   124→\n   125→      // Determine run/rollback access.\n   126→      $canRun = FALSE;\n   127→      $canRollback = FALSE;\n   128→      if ($permissionsModuleEnabled) {\n   129→        $canRun = $this->migrateAccessCheck->canRunMigration($account, $migrationId);\n   130→        $canRollback = $this->migrateAccessCheck->canRollbackMigration($account, $migrationId);\n   131→      }\n   132→      elseif ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n   133→        $canRun = TRUE;\n   134→        $canRollback = TRUE;\n   135→      }\n   136→\n   137→      $groupedMigrations[$group][$migrationId] = [\n   138→        'label' => $label,\n   139→        'group' => $group,\n   140→        'status' => $status,\n   141→        'source_count' => $sourceCount,\n   142→        'imported_count' => $counts['imported'],\n   143→        'failed_count' => $counts['failed'],\n   144→        'last_run' => $lastRun,\n   145→        'can_run' => $canRun,\n   146→        'can_rollback' => $canRollback,\n   147→      ];\n   148→    }\n   149→\n   150→    ksort($allGroups);\n   151→\n   152→    $build = [];\n   153→\n   154→    // Filter form.\n   155→    $build['filters'] = $this->buildFilterForm($search, $statusFilter, $groupFilter, $allGroups);\n   156→\n   157→    // Build grouped tables.\n   158→    foreach ($groupedMigrations as $group => $groupMigrations) {\n   159→      $build['group_' . $group] = $this->buildGroupTable($group, $groupMigrations);\n   160→    }\n   161→\n   162→    if (empty($groupedMigrations)) {\n   163→      if ($permissionsModuleEnabled && $search === '' && $statusFilter === '' && $groupFilter === '') {\n   164→        $build['empty'] = [\n   165→          '#markup' => '<p>' . $this->t('You do not have permission to view any migrations. Contact your site administrator to grant you per-migration view permissions.') . '</p>',\n   166→        ];\n   167→      }\n   168→      else {\n   169→        $build['empty'] = [\n   170→          '#markup' => '<p>' . $this->t('No migrations match the current filters.') . '</p>',\n   171→        ];\n   172→      }\n   173→    }\n   174→\n   175→    $build['#attached'] = [\n   176→      'library' => ['migrate_admin/dashboard'],\n   177→    ];\n   178→    $build['#cache'] = [\n   179→      'contexts' => ['url.query_args'],\n   180→      'tags' => ['migration_plugins'],\n   181→    ];\n   182→\n   183→    return $build;\n   184→  }\n   185→\n   186→  /**\n   187→   * Gets the current status of a migration.\n   188→   *\n   189→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   190→   *   The migration plugin instance.\n   191→   *\n   192→   * @return string\n   193→   *   The status string: idle, importing, rolling_back, completed, or failed.\n   194→   */\n   195→  protected function getMigrationStatus($migration): string {\n   196→    $status = $migration->getStatusLabel();\n   197→\n   198→    // Map Drupal's status labels to our internal statuses.\n   199→    $statusString = (string) $status;\n   200→    $statusMap = [\n   201→      'Idle' => 'idle',\n   202→      'Importing' => 'importing',\n   203→      'Rolling back' => 'rolling_back',\n   204→      'Stopping' => 'idle',\n   205→      'Disabled' => 'idle',\n   206→    ];\n   207→\n   208→    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n   209→\n   210→    // Check run log for completed/failed status if currently idle.\n   211→    if ($migrationStatus === 'idle') {\n   212→      $migrationId = $migration->id();\n   213→      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   214→        ->fields('r', ['status'])\n   215→        ->condition('migration_id', $migrationId)\n   216→        ->orderBy('id', 'DESC')\n   217→        ->range(0, 1)\n   218→        ->execute()\n   219→        ->fetchField();\n   220→\n   221→      if ($lastRun === 'completed') {\n   222→        $migrationStatus = 'completed';\n   223→      }\n   224→      elseif ($lastRun === 'failed') {\n   225→        $migrationStatus = 'failed';\n   226→      }\n   227→    }\n   228→\n   229→    return $migrationStatus;\n   230→  }\n   231→\n   232→  /**\n   233→   * Gets item counts from the map table.\n   234→   *\n   235→   * @param string $migrationId\n   236→   *   The migration ID.\n   237→   *\n   238→   * @return array\n   239→   *   Associative array with 'imported', 'needs_update', 'failed' counts.\n   240→   */\n   241→  protected function getItemCounts(string $migrationId): array {\n   242→    $counts = [\n   243→      'imported' => 0,\n   244→      'needs_update' => 0,\n   245→      'failed' => 0,\n   246→    ];\n   247→\n   248→    $table = 'migrate_map_' . $migrationId;\n   249→    if (!$this->database->schema()->tableExists($table)) {\n   250→      return $counts;\n   251→    }\n   252→\n   253→    $results = $this->database->select($table, 'map')\n   254→      ->fields('map', ['source_row_status'])\n   255→      ->groupBy('source_row_status')\n   256→      ->addExpression('COUNT(*)', 'count')\n   257→      ->execute()\n   258→      ->fetchAllKeyed();\n   259→\n   260→    // Status constants: 0 = imported, 1 = needs_update, 2 = failed.\n   261→    $statusMap = [\n   262→      '0' => 'imported',\n   263→      '1' => 'needs_update',\n   264→      '2' => 'failed',\n   265→    ];\n   266→\n   267→    foreach ($results as $status => $count) {\n   268→      $key = $statusMap[(string) $status] ?? NULL;\n   269→      if ($key !== NULL) {\n   270→        $counts[$key] = (int) $count;\n   271→      }\n   272→    }\n   273→\n   274→    return $counts;\n   275→  }\n   276→\n   277→  /**\n   278→   * Gets the source count for a migration.\n   279→   *\n   280→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   281→   *   The migration plugin instance.\n   282→   *\n   283→   * @return int|string\n   284→   *   The source count or 'N/A' if unavailable.\n   285→   */\n   286→  protected function getSourceCount($migration): int|string {\n   287→    try {\n   288→      $source = $migration->getSourcePlugin();\n   289→      $count = $source->count();\n   290→      return $count === -1 ? 'N/A' : $count;\n   291→    }\n   292→    catch (\\Exception $e) {\n   293→      return 'N/A';\n   294→    }\n   295→  }\n   296→\n   297→  /**\n   298→   * Gets the last run timestamp for a migration.\n   299→   *\n   300→   * @param string $migrationId\n   301→   *   The migration ID.\n   302→   *\n   303→   * @return int|null\n   304→   *   The timestamp of the last run, or NULL if never run.\n   305→   */\n   306→  protected function getLastRunTimestamp(string $migrationId): ?int {\n   307→    $result = $this->database->select('migrate_suite_run_log', 'r')\n   308→      ->fields('r', ['started'])\n   309→      ->condition('migration_id', $migrationId)\n   310→      ->orderBy('id', 'DESC')\n   311→      ->range(0, 1)\n   312→      ->execute()\n   313→      ->fetchField();\n   314→\n   315→    return $result ? (int) $result : NULL;\n   316→  }\n   317→\n   318→  /**\n   319→   * Builds the filter form.\n   320→   *\n   321→   * @param string $search\n   322→   *   Current search value.\n   323→   * @param string $statusFilter\n   324→   *   Current status filter.\n   325→   * @param string $groupFilter\n   326→   *   Current group filter.\n   327→   * @param array $allGroups\n   328→   *   All available migration groups.\n   329→   *\n   330→   * @return array\n   331→   *   A render array for the filter form.\n   332→   */\n   333→  protected function buildFilterForm(string $search, string $statusFilter, string $groupFilter, array $allGroups): array {\n   334→    $statusOptions = [\n   335→      '' => $this->t('- All statuses -'),\n   336→      'idle' => $this->t('Idle'),\n   337→      'importing' => $this->t('Importing'),\n   338→      'rolling_back' => $this->t('Rolling back'),\n   339→      'completed' => $this->t('Completed'),\n   340→      'failed' => $this->t('Failed'),\n   341→    ];\n   342→\n   343→    $groupOptions = ['' => $this->t('- All groups -')];\n   344→    foreach ($allGroups as $group) {\n   345→      $groupOptions[$group] = $group;\n   346→    }\n   347→\n   348→    return [\n   349→      '#type' => 'container',\n   350→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   351→      'form' => [\n   352→        '#type' => 'html_tag',\n   353→        '#tag' => 'form',\n   354→        '#attributes' => [\n   355→          'method' => 'get',\n   356→          'class' => ['migrate-dashboard-filter-form'],\n   357→        ],\n   358→        'search' => [\n   359→          '#type' => 'html_tag',\n   360→          '#tag' => 'div',\n   361→          '#attributes' => ['class' => ['form-item']],\n   362→          'label' => [\n   363→            '#type' => 'html_tag',\n   364→            '#tag' => 'label',\n   365→            '#attributes' => ['for' => 'edit-search'],\n   366→            '#value' => $this->t('Search'),\n   367→          ],\n   368→          'input' => [\n   369→            '#type' => 'html_tag',\n   370→            '#tag' => 'input',\n   371→            '#attributes' => [\n   372→              'type' => 'text',\n   373→              'name' => 'search',\n   374→              'id' => 'edit-search',\n   375→              'value' => $search,\n   376→              'placeholder' => $this->t('Migration ID or label'),\n   377→              'class' => ['form-text'],\n   378→            ],\n   379→          ],\n   380→        ],\n   381→        'status' => [\n   382→          '#type' => 'html_tag',\n   383→          '#tag' => 'div',\n   384→          '#attributes' => ['class' => ['form-item']],\n   385→          'label' => [\n   386→            '#type' => 'html_tag',\n   387→            '#tag' => 'label',\n   388→            '#attributes' => ['for' => 'edit-status'],\n   389→            '#value' => $this->t('Status'),\n   390→          ],\n   391→          'select' => [\n   392→            '#type' => 'html_tag',\n   393→            '#tag' => 'select',\n   394→            '#attributes' => [\n   395→              'name' => 'status',\n   396→              'id' => 'edit-status',\n   397→              'class' => ['form-select'],\n   398→            ],\n   399→            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n   400→          ],\n   401→        ],\n   402→        'group' => [\n   403→          '#type' => 'html_tag',\n   404→          '#tag' => 'div',\n   405→          '#attributes' => ['class' => ['form-item']],\n   406→          'label' => [\n   407→            '#type' => 'html_tag',\n   408→            '#tag' => 'label',\n   409→            '#attributes' => ['for' => 'edit-group'],\n   410→            '#value' => $this->t('Group'),\n   411→          ],\n   412→          'select' => [\n   413→            '#type' => 'html_tag',\n   414→            '#tag' => 'select',\n   415→            '#attributes' => [\n   416→              'name' => 'group',\n   417→              'id' => 'edit-group',\n   418→              'class' => ['form-select'],\n   419→            ],\n   420→            'options' => $this->buildSelectOptions($groupOptions, $groupFilter),\n   421→          ],\n   422→        ],\n   423→        'actions' => [\n   424→          '#type' => 'html_tag',\n   425→          '#tag' => 'div',\n   426→          '#attributes' => ['class' => ['form-actions']],\n   427→          'submit' => [\n   428→            '#type' => 'html_tag',\n   429→            '#tag' => 'input',\n   430→            '#attributes' => [\n   431→              'type' => 'submit',\n   432→              'value' => $this->t('Filter'),\n   433→              'class' => ['button', 'button--primary'],\n   434→            ],\n   435→          ],\n   436→        ],\n   437→      ],\n   438→    ];\n   439→  }\n   440→\n   441→  /**\n   442→   * Builds select option elements.\n   443→   *\n   444→   * @param array $options\n   445→   *   The options array.\n   446→   * @param string $selectedValue\n   447→   *   The currently selected value.\n   448→   *\n   449→   * @return array\n   450→   *   A render array of option elements.\n   451→   */\n   452→  protected function buildSelectOptions(array $options, string $selectedValue): array {\n   453→    $elements = [];\n   454→    foreach ($options as $value => $label) {\n   455→      $attributes = ['value' => $value];\n   456→      if ((string) $value === $selectedValue) {\n   457→        $attributes['selected'] = 'selected';\n   458→      }\n   459→      $elements[] = [\n   460→        '#type' => 'html_tag',\n   461→        '#tag' => 'option',\n   462→        '#attributes' => $attributes,\n   463→        '#value' => $label,\n   464→      ];\n   465→    }\n   466→    return $elements;\n   467→  }\n   468→\n   469→  /**\n   470→   * Builds a migration group table.\n   471→   *\n   472→   * @param string $group\n   473→   *   The group name.\n   474→   * @param array $migrations\n   475→   *   The migrations in this group.\n   476→   *\n   477→   * @return array\n   478→   *   A render array for the group.\n   479→   */\n   480→  protected function buildGroupTable(string $group, array $migrations): array {\n   481→    $rows = [];\n   482→    $showActions = FALSE;\n   483→    foreach ($migrations as $migrationId => $data) {\n   484→      $statusBadge = $this->buildStatusBadge($data['status']);\n   485→\n   486→      $lastRun = $data['last_run']\n   487→        ? $this->dateFormatter->format($data['last_run'], 'short')\n   488→        : $this->t('Never');\n   489→\n   490→      // Build action links.\n   491→      $actions = [];\n   492→      if ($data['can_run']) {\n   493→        $showActions = TRUE;\n   494→        $actions[] = Link::fromTextAndUrl($this->t('Run'), Url::fromRoute('migrate_admin.migration_run_confirm', ['migration_id' => $migrationId]))->toString();\n   495→      }\n   496→      if ($data['can_rollback']) {\n   497→        $showActions = TRUE;\n   498→        $actions[] = Link::fromTextAndUrl($this->t('Rollback'), Url::fromRoute('migrate_admin.migration_rollback_confirm', ['migration_id' => $migrationId]))->toString();\n   499→      }\n   500→      $actionsMarkup = $actions ? implode(' | ', $actions) : '';\n   501→\n   502→      $row = [\n   503→        Link::fromTextAndUrl($data['label'], Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]))->toString(),\n   504→        $data['group'],\n   505→        $statusBadge,\n   506→        $data['source_count'],\n   507→        $data['imported_count'],\n   508→        $data['failed_count'],\n   509→        $lastRun,\n   510→        ['data' => ['#markup' => $actionsMarkup]],\n   511→      ];\n   512→      $rows[] = $row;\n   513→    }\n   514→\n   515→    $header = [\n   516→      $this->t('Migration'),\n   517→      $this->t('Group'),\n   518→      $this->t('Status'),\n   519→      $this->t('Source count'),\n   520→      $this->t('Imported'),\n   521→      $this->t('Failed'),\n   522→      $this->t('Last run'),\n   523→      $this->t('Actions'),\n   524→    ];\n   525→\n   526→    return [\n   527→      '#type' => 'details',\n   528→      '#title' => $this->t('Group: @group (@count)', [\n   529→        '@group' => $group,\n   530→        '@count' => count($migrations),\n   531→      ]),\n   532→      '#open' => TRUE,\n   533→      'table' => [\n   534→        '#type' => 'table',\n   535→        '#header' => $header,\n   536→        '#rows' => $rows,\n   537→        '#empty' => $this->t('No migrations in this group.'),\n   538→      ],\n   539→    ];\n   540→  }\n   541→\n   542→  /**\n   543→   * Builds a colored status badge.\n   544→   *\n   545→   * @param string $status\n   546→   *   The migration status.\n   547→   *\n   548→   * @return array|string\n   549→   *   A markup string with the status badge.\n   550→   */\n   551→  protected function buildStatusBadge(string $status): array|string {\n   552→    $labels = [\n   553→      'idle' => $this->t('Idle'),\n   554→      'importing' => $this->t('Importing'),\n   555→      'rolling_back' => $this->t('Rolling back'),\n   556→      'completed' => $this->t('Completed'),\n   557→      'failed' => $this->t('Failed'),\n   558→    ];\n   559→\n   560→    $colors = [\n   561→      'idle' => 'color--success',\n   562→      'importing' => 'color--primary',\n   563→      'rolling_back' => 'color--warning',\n   564→      'completed' => 'color--success',\n   565→      'failed' => 'color--error',\n   566→    ];\n   567→\n   568→    $label = $labels[$status] ?? $status;\n   569→    $colorClass = $colors[$status] ?? '';\n   570→\n   571→    return [\n   572→      'data' => [\n   573→        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n   574→      ],\n   575→    ];\n   576→  }\n   577→\n   578→}\n   579→"}]},"parent_tool_use_id":null,"session_id":"47a3c04a-88ca-462e-9d23-1a6a80ee0429","uuid":"4d57081c-81e7-482a-bcc5-95d29eeb462c","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/modules/migrate_admin/src/Controller/MigrationDashboardController.php","content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace Drupal\\migrate_admin\\Controller;\n\nuse Drupal\\Core\\Controller\\ControllerBase;\nuse Drupal\\Core\\Database\\Connection;\nuse Drupal\\Core\\Datetime\\DateFormatterInterface;\nuse Drupal\\Core\\Extension\\ModuleHandlerInterface;\nuse Drupal\\Core\\Link;\nuse Drupal\\Core\\Url;\nuse Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\nuse Drupal\\migrate_permissions\\MigrateAccessCheck;\nuse Symfony\\Component\\DependencyInjection\\ContainerInterface;\nuse Symfony\\Component\\HttpFoundation\\Request;\n\n/**\n * Controller for the migration dashboard page.\n */\nclass MigrationDashboardController extends ControllerBase {\n\n  /**\n   * Constructs a MigrationDashboardController object.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n   *   The migration plugin manager.\n   * @param \\Drupal\\Core\\Database\\Connection $database\n   *   The database connection.\n   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n   *   The date formatter service.\n   */\n  public function __construct(\n    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    protected readonly Connection $database,\n    protected readonly DateFormatterInterface $dateFormatter,\n    protected readonly ModuleHandlerInterface $moduleHandler,\n    protected readonly ?MigrateAccessCheck $migrateAccessCheck,\n  ) {}\n\n  /**\n   * {@inheritdoc}\n   */\n  public static function create(ContainerInterface $container): static {\n    $migrateAccessCheck = $container->get('module_handler')->moduleExists('migrate_permissions')\n      ? $container->get('migrate_permissions.access_check')\n      : NULL;\n\n    return new static(\n      $container->get('plugin.manager.migration'),\n      $container->get('database'),\n      $container->get('date.formatter'),\n      $container->get('module_handler'),\n      $migrateAccessCheck,\n    );\n  }\n\n  /**\n   * Builds the migration dashboard page.\n   *\n   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   *   The current request.\n   *\n   * @return array\n   *   A render array.\n   */\n  public function dashboard(Request $request): array {\n    $search = $request->query->get('search', '');\n    $statusFilter = $request->query->get('status', '');\n    $groupFilter = $request->query->get('group', '');\n\n    $migrations = $this->migrationPluginManager->createInstances([]);\n\n    if (empty($migrations)) {\n      return [\n        '#markup' => '<p>' . $this->t('No migrations are currently configured. Configure migrations using migration YAML files or Drush commands.') . '</p>',\n      ];\n    }\n\n    // Collect all groups for the filter dropdown.\n    $allGroups = [];\n    $groupedMigrations = [];\n\n    $account = $this->currentUser();\n    $permissionsModuleEnabled = $this->migrateAccessCheck !== NULL;\n\n    foreach ($migrations as $migrationId => $migration) {\n      // Apply per-migration view permission filter.\n      if ($permissionsModuleEnabled && !$this->migrateAccessCheck->canViewMigration($account, $migrationId)) {\n        continue;\n      }\n\n      $label = $migration->label() ?: $migrationId;\n      $definition = $migration->getPluginDefinition();\n      $group = $definition['migration_group'] ?? 'default';\n      $allGroups[$group] = $group;\n\n      // Apply text search filter.\n      if ($search !== '' && stripos($migrationId, $search) === FALSE && stripos((string) $label, $search) === FALSE) {\n        continue;\n      }\n\n      // Get migration status.\n      $status = $this->getMigrationStatus($migration);\n\n      // Apply status filter.\n      if ($statusFilter !== '' && $status !== $statusFilter) {\n        continue;\n      }\n\n      // Apply group filter.\n      if ($groupFilter !== '' && $group !== $groupFilter) {\n        continue;\n      }\n\n      // Get counts from map table.\n      $counts = $this->getItemCounts($migrationId);\n\n      // Get source count.\n      $sourceCount = $this->getSourceCount($migration);\n\n      // Get last run timestamp.\n      $lastRun = $this->getLastRunTimestamp($migrationId);\n\n      // Determine run/rollback access.\n      $canRun = FALSE;\n      $canRollback = FALSE;\n      if ($permissionsModuleEnabled) {\n        $canRun = $this->migrateAccessCheck->canRunMigration($account, $migrationId);\n        $canRollback = $this->migrateAccessCheck->canRollbackMigration($account, $migrationId);\n      }\n      elseif ($account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration')) {\n        $canRun = TRUE;\n        $canRollback = TRUE;\n      }\n\n      $groupedMigrations[$group][$migrationId] = [\n        'label' => $label,\n        'group' => $group,\n        'status' => $status,\n        'source_count' => $sourceCount,\n        'imported_count' => $counts['imported'],\n        'failed_count' => $counts['failed'],\n        'last_run' => $lastRun,\n        'can_run' => $canRun,\n        'can_rollback' => $canRollback,\n      ];\n    }\n\n    ksort($allGroups);\n\n    $build = [];\n\n    // Filter form.\n    $build['filters'] = $this->buildFilterForm($search, $statusFilter, $groupFilter, $allGroups);\n\n    // Build grouped tables.\n    foreach ($groupedMigrations as $group => $groupMigrations) {\n      $build['group_' . $group] = $this->buildGroupTable($group, $groupMigrations);\n    }\n\n    if (empty($groupedMigrations)) {\n      if ($permissionsModuleEnabled && $search === '' && $statusFilter === '' && $groupFilter === '') {\n        $build['empty'] = [\n          '#markup' => '<p>' . $this->t('You do not have permission to view any migrations. Contact your site administrator to grant you per-migration view permissions.') . '</p>',\n        ];\n      }\n      else {\n        $build['empty'] = [\n          '#markup' => '<p>' . $this->t('No migrations match the current filters.') . '</p>',\n        ];\n      }\n    }\n\n    $build['#attached'] = [\n      'library' => ['migrate_admin/dashboard'],\n    ];\n    $build['#cache'] = [\n      'contexts' => ['url.query_args'],\n      'tags' => ['migration_plugins'],\n    ];\n\n    return $build;\n  }\n\n  /**\n   * Gets the current status of a migration.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   *   The migration plugin instance.\n   *\n   * @return string\n   *   The status string: idle, importing, rolling_back, completed, or failed.\n   */\n  protected function getMigrationStatus($migration): string {\n    $status = $migration->getStatusLabel();\n\n    // Map Drupal's status labels to our internal statuses.\n    $statusString = (string) $status;\n    $statusMap = [\n      'Idle' => 'idle',\n      'Importing' => 'importing',\n      'Rolling back' => 'rolling_back',\n      'Stopping' => 'idle',\n      'Disabled' => 'idle',\n    ];\n\n    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n\n    // Check run log for completed/failed status if currently idle.\n    if ($migrationStatus === 'idle') {\n      $migrationId = $migration->id();\n      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n        ->fields('r', ['status'])\n        ->condition('migration_id', $migrationId)\n        ->orderBy('id', 'DESC')\n        ->range(0, 1)\n        ->execute()\n        ->fetchField();\n\n      if ($lastRun === 'completed') {\n        $migrationStatus = 'completed';\n      }\n      elseif ($lastRun === 'failed') {\n        $migrationStatus = 'failed';\n      }\n    }\n\n    return $migrationStatus;\n  }\n\n  /**\n   * Gets item counts from the map table.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   *\n   * @return array\n   *   Associative array with 'imported', 'needs_update', 'failed' counts.\n   */\n  protected function getItemCounts(string $migrationId): array {\n    $counts = [\n      'imported' => 0,\n      'needs_update' => 0,\n      'failed' => 0,\n    ];\n\n    $table = 'migrate_map_' . $migrationId;\n    if (!$this->database->schema()->tableExists($table)) {\n      return $counts;\n    }\n\n    $results = $this->database->select($table, 'map')\n      ->fields('map', ['source_row_status'])\n      ->groupBy('source_row_status')\n      ->addExpression('COUNT(*)', 'count')\n      ->execute()\n      ->fetchAllKeyed();\n\n    // Status constants: 0 = imported, 1 = needs_update, 2 = failed.\n    $statusMap = [\n      '0' => 'imported',\n      '1' => 'needs_update',\n      '2' => 'failed',\n    ];\n\n    foreach ($results as $status => $count) {\n      $key = $statusMap[(string) $status] ?? NULL;\n      if ($key !== NULL) {\n        $counts[$key] = (int) $count;\n      }\n    }\n\n    return $counts;\n  }\n\n  /**\n   * Gets the source count for a migration.\n   *\n   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   *   The migration plugin instance.\n   *\n   * @return int|string\n   *   The source count or 'N/A' if unavailable.\n   */\n  protected function getSourceCount($migration): int|string {\n    try {\n      $source = $migration->getSourcePlugin();\n      $count = $source->count();\n      return $count === -1 ? 'N/A' : $count;\n    }\n    catch (\\Exception $e) {\n      return 'N/A';\n    }\n  }\n\n  /**\n   * Gets the last run timestamp for a migration.\n   *\n   * @param string $migrationId\n   *   The migration ID.\n   *\n   * @return int|null\n   *   The timestamp of the last run, or NULL if never run.\n   */\n  protected function getLastRunTimestamp(string $migrationId): ?int {\n    $result = $this->database->select('migrate_suite_run_log', 'r')\n      ->fields('r', ['started'])\n      ->condition('migration_id', $migrationId)\n      ->orderBy('id', 'DESC')\n      ->range(0, 1)\n      ->execute()\n      ->fetchField();\n\n    return $result ? (int) $result : NULL;\n  }\n\n  /**\n   * Builds the filter form.\n   *\n   * @param string $search\n   *   Current search value.\n   * @param string $statusFilter\n   *   Current status filter.\n   * @param string $groupFilter\n   *   Current group filter.\n   * @param array $allGroups\n   *   All available migration groups.\n   *\n   * @return array\n   *   A render array for the filter form.\n   */\n  protected function buildFilterForm(string $search, string $statusFilter, string $groupFilter, array $allGroups): array {\n    $statusOptions = [\n      '' => $this->t('- All statuses -'),\n      'idle' => $this->t('Idle'),\n      'importing' => $this->t('Importing'),\n      'rolling_back' => $this->t('Rolling back'),\n      'completed' => $this->t('Completed'),\n      'failed' => $this->t('Failed'),\n    ];\n\n    $groupOptions = ['' => $this->t('- All groups -')];\n    foreach ($allGroups as $group) {\n      $groupOptions[$group] = $group;\n    }\n\n    return [\n      '#type' => 'container',\n      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n      'form' => [\n        '#type' => 'html_tag',\n        '#tag' => 'form',\n        '#attributes' => [\n          'method' => 'get',\n          'class' => ['migrate-dashboard-filter-form'],\n        ],\n        'search' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-search'],\n            '#value' => $this->t('Search'),\n          ],\n          'input' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'text',\n              'name' => 'search',\n              'id' => 'edit-search',\n              'value' => $search,\n              'placeholder' => $this->t('Migration ID or label'),\n              'class' => ['form-text'],\n            ],\n          ],\n        ],\n        'status' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-status'],\n            '#value' => $this->t('Status'),\n          ],\n          'select' => [\n            '#type' => 'html_tag',\n            '#tag' => 'select',\n            '#attributes' => [\n              'name' => 'status',\n              'id' => 'edit-status',\n              'class' => ['form-select'],\n            ],\n            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n          ],\n        ],\n        'group' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-item']],\n          'label' => [\n            '#type' => 'html_tag',\n            '#tag' => 'label',\n            '#attributes' => ['for' => 'edit-group'],\n            '#value' => $this->t('Group'),\n          ],\n          'select' => [\n            '#type' => 'html_tag',\n            '#tag' => 'select',\n            '#attributes' => [\n              'name' => 'group',\n              'id' => 'edit-group',\n              'class' => ['form-select'],\n            ],\n            'options' => $this->buildSelectOptions($groupOptions, $groupFilter),\n          ],\n        ],\n        'actions' => [\n          '#type' => 'html_tag',\n          '#tag' => 'div',\n          '#attributes' => ['class' => ['form-actions']],\n          'submit' => [\n            '#type' => 'html_tag',\n            '#tag' => 'input',\n            '#attributes' => [\n              'type' => 'submit',\n              'value' => $this->t('Filter'),\n              'class' => ['button', 'button--primary'],\n            ],\n          ],\n        ],\n      ],\n    ];\n  }\n\n  /**\n   * Builds select option elements.\n   *\n   * @param array $options\n   *   The options array.\n   * @param string $selectedValue\n   *   The currently selected value.\n   *\n   * @return array\n   *   A render array of option elements.\n   */\n  protected function buildSelectOptions(array $options, string $selectedValue): array {\n    $elements = [];\n    foreach ($options as $value => $label) {\n      $attributes = ['value' => $value];\n      if ((string) $value === $selectedValue) {\n        $attributes['selected'] = 'selected';\n      }\n      $elements[] = [\n        '#type' => 'html_tag',\n        '#tag' => 'option',\n        '#attributes' => $attributes,\n        '#value' => $label,\n      ];\n    }\n    return $elements;\n  }\n\n  /**\n   * Builds a migration group table.\n   *\n   * @param string $group\n   *   The group name.\n   * @param array $migrations\n   *   The migrations in this group.\n   *\n   * @return array\n   *   A render array for the group.\n   */\n  protected function buildGroupTable(string $group, array $migrations): array {\n    $rows = [];\n    $showActions = FALSE;\n    foreach ($migrations as $migrationId => $data) {\n      $statusBadge = $this->buildStatusBadge($data['status']);\n\n      $lastRun = $data['last_run']\n        ? $this->dateFormatter->format($data['last_run'], 'short')\n        : $this->t('Never');\n\n      // Build action links.\n      $actions = [];\n      if ($data['can_run']) {\n        $showActions = TRUE;\n        $actions[] = Link::fromTextAndUrl($this->t('Run'), Url::fromRoute('migrate_admin.migration_run_confirm', ['migration_id' => $migrationId]))->toString();\n      }\n      if ($data['can_rollback']) {\n        $showActions = TRUE;\n        $actions[] = Link::fromTextAndUrl($this->t('Rollback'), Url::fromRoute('migrate_admin.migration_rollback_confirm', ['migration_id' => $migrationId]))->toString();\n      }\n      $actionsMarkup = $actions ? implode(' | ', $actions) : '';\n\n      $row = [\n        Link::fromTextAndUrl($data['label'], Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId]))->toString(),\n        $data['group'],\n        $statusBadge,\n        $data['source_count'],\n        $data['imported_count'],\n        $data['failed_count'],\n        $lastRun,\n        ['data' => ['#markup' => $actionsMarkup]],\n      ];\n      $rows[] = $row;\n    }\n\n    $header = [\n      $this->t('Migration'),\n      $this->t('Group'),\n      $this->t('Status'),\n      $this->t('Source count'),\n      $this->t('Imported'),\n      $this->t('Failed'),\n      $this->t('Last run'),\n      $this->t('Actions'),\n    ];\n\n    return [\n      '#type' => 'details',\n      '#title' => $this->t('Group: @group (@count)', [\n        '@group' => $group,\n        '@count' => count($migrations),\n      ]),\n      '#open' => TRUE,\n      'table' => [\n        '#type' => 'table',\n        '#header' => $header,\n        '#rows' => $rows,\n        '#empty' => $this->t('No migrations in this group.'),\n      ],\n    ];\n  }\n\n  /**\n   * Builds a colored status badge.\n   *\n   * @param string $status\n   *   The migration status.\n   *\n   * @return array|string\n   *   A markup string with the status badge.\n   */\n  protected function buildStatusBadge(string $status): array|string {\n    $labels = [\n      'idle' => $this->t('Idle'),\n      'importing' => $this->t('Importing'),\n      'rolling_back' => $this->t('Rolling back'),\n      'completed' => $this->t('Completed'),\n      'failed' => $this->t('Failed'),\n    ];\n\n    $colors = [\n      'idle' => 'color--success',\n      'importing' => 'color--primary',\n      'rolling_back' => 'color--warning',\n      'completed' => 'color--success',\n      'failed' => 'color--error',\n    ];\n\n    $label = $labels[$status] ?? $status;\n    $colorClass = $colors[$status] ?? '';\n\n    return [\n      'data' => [\n        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n      ],\n    ];\n  }\n\n}\n","numLines":579,"startLine":1,"totalLines":579}}}
