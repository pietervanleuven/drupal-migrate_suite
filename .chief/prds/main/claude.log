{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ATTEFSofteBRod92RDCkNM","type":"tool_result","content":"     1→<?php\n     2→\n     3→declare(strict_types=1);\n     4→\n     5→namespace Drupal\\migrate_admin\\Controller;\n     6→\n     7→use Drupal\\Core\\Controller\\ControllerBase;\n     8→use Drupal\\Core\\Database\\Connection;\n     9→use Drupal\\Core\\Datetime\\DateFormatterInterface;\n    10→use Drupal\\Core\\Url;\n    11→use Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface;\n    12→use Drupal\\migrate_permissions\\MigrateAccessCheck;\n    13→use Symfony\\Component\\DependencyInjection\\ContainerInterface;\n    14→use Symfony\\Component\\HttpFoundation\\Request;\n    15→use Symfony\\Component\\HttpKernel\\Exception\\AccessDeniedHttpException;\n    16→use Symfony\\Component\\HttpKernel\\Exception\\NotFoundHttpException;\n    17→\n    18→/**\n    19→ * Controller for the migration detail page.\n    20→ */\n    21→class MigrationDetailController extends ControllerBase {\n    22→\n    23→  /**\n    24→   * Number of items per page.\n    25→   */\n    26→  protected const ITEMS_PER_PAGE = 50;\n    27→\n    28→  /**\n    29→   * Constructs a MigrationDetailController object.\n    30→   *\n    31→   * @param \\Drupal\\migrate\\Plugin\\MigrationPluginManagerInterface $migrationPluginManager\n    32→   *   The migration plugin manager.\n    33→   * @param \\Drupal\\Core\\Database\\Connection $database\n    34→   *   The database connection.\n    35→   * @param \\Drupal\\Core\\Datetime\\DateFormatterInterface $dateFormatter\n    36→   *   The date formatter service.\n    37→   */\n    38→  public function __construct(\n    39→    protected readonly MigrationPluginManagerInterface $migrationPluginManager,\n    40→    protected readonly Connection $database,\n    41→    protected readonly DateFormatterInterface $dateFormatter,\n    42→    protected readonly ?MigrateAccessCheck $migrateAccessCheck,\n    43→  ) {}\n    44→\n    45→  /**\n    46→   * {@inheritdoc}\n    47→   */\n    48→  public static function create(ContainerInterface $container): static {\n    49→    $migrateAccessCheck = $container->get('module_handler')->moduleExists('migrate_permissions')\n    50→      ? $container->get('migrate_permissions.access_check')\n    51→      : NULL;\n    52→\n    53→    return new static(\n    54→      $container->get('plugin.manager.migration'),\n    55→      $container->get('database'),\n    56→      $container->get('date.formatter'),\n    57→      $migrateAccessCheck,\n    58→    );\n    59→  }\n    60→\n    61→  /**\n    62→   * Builds the migration detail page.\n    63→   *\n    64→   * @param string $migration_id\n    65→   *   The migration plugin ID.\n    66→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n    67→   *   The current request.\n    68→   *\n    69→   * @return array\n    70→   *   A render array.\n    71→   */\n    72→  public function detail(string $migration_id, Request $request): array {\n    73→    $migration = $this->loadMigration($migration_id);\n    74→\n    75→    $definition = $migration->getPluginDefinition();\n    76→    $group = $definition['migration_group'] ?? 'default';\n    77→    $sourcePlugin = $definition['source']['plugin'] ?? $this->t('Unknown');\n    78→    $destinationPlugin = $definition['destination']['plugin'] ?? $this->t('Unknown');\n    79→\n    80→    // Get status.\n    81→    $status = $this->getMigrationStatus($migration);\n    82→\n    83→    // Get last run stats.\n    84→    $lastRun = $this->getLastRunStats($migration_id);\n    85→\n    86→    // Build summary section.\n    87→    $build = [];\n    88→\n    89→    $build['summary'] = [\n    90→      '#type' => 'details',\n    91→      '#title' => $this->t('Summary'),\n    92→      '#open' => TRUE,\n    93→      'table' => [\n    94→        '#type' => 'table',\n    95→        '#rows' => [\n    96→          [$this->t('Migration'), $migration->label() ?: $migration_id],\n    97→          [$this->t('Group'), $group],\n    98→          [$this->t('Source plugin'), $sourcePlugin],\n    99→          [$this->t('Destination plugin'), $destinationPlugin],\n   100→          [$this->t('Status'), $this->buildStatusBadge($status)],\n   101→          [$this->t('Last run'), $lastRun ? $this->buildLastRunSummary($lastRun) : $this->t('Never')],\n   102→        ],\n   103→      ],\n   104→    ];\n   105→\n   106→    // Build tabs.\n   107→    $build['tabs'] = $this->buildTabs($migration_id, 'items');\n   108→\n   109→    // Build imported items section.\n   110→    $build['items'] = $this->buildImportedItemsSection($migration_id, $request);\n   111→\n   112→    $build['#attached'] = [\n   113→      'library' => ['migrate_admin/dashboard'],\n   114→    ];\n   115→    $build['#cache'] = [\n   116→      'contexts' => ['url.query_args', 'url.path'],\n   117→      'tags' => ['migration_plugins'],\n   118→    ];\n   119→\n   120→    return $build;\n   121→  }\n   122→\n   123→  /**\n   124→   * Builds the migration messages page.\n   125→   *\n   126→   * @param string $migration_id\n   127→   *   The migration plugin ID.\n   128→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   129→   *   The current request.\n   130→   *\n   131→   * @return array\n   132→   *   A render array.\n   133→   */\n   134→  public function messages(string $migration_id, Request $request): array {\n   135→    $migration = $this->loadMigration($migration_id);\n   136→\n   137→    $build = [];\n   138→\n   139→    // Build tabs.\n   140→    $build['tabs'] = $this->buildTabs($migration_id, 'messages');\n   141→\n   142→    // Build messages section.\n   143→    $build['messages'] = $this->buildMessagesSection($migration_id, $request);\n   144→\n   145→    $build['#attached'] = [\n   146→      'library' => ['migrate_admin/dashboard'],\n   147→    ];\n   148→    $build['#cache'] = [\n   149→      'contexts' => ['url.query_args', 'url.path'],\n   150→      'tags' => ['migration_plugins'],\n   151→    ];\n   152→\n   153→    return $build;\n   154→  }\n   155→\n   156→  /**\n   157→   * Builds the failed items page.\n   158→   *\n   159→   * @param string $migration_id\n   160→   *   The migration plugin ID.\n   161→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   162→   *   The current request.\n   163→   *\n   164→   * @return array\n   165→   *   A render array.\n   166→   */\n   167→  public function failedItems(string $migration_id, Request $request): array {\n   168→    $migration = $this->loadMigration($migration_id);\n   169→\n   170→    $build = [];\n   171→\n   172→    // Build tabs.\n   173→    $build['tabs'] = $this->buildTabs($migration_id, 'failed');\n   174→\n   175→    // Build failed items section.\n   176→    $build['failed'] = $this->buildFailedItemsSection($migration_id, $request);\n   177→\n   178→    $build['#attached'] = [\n   179→      'library' => ['migrate_admin/dashboard'],\n   180→    ];\n   181→    $build['#cache'] = [\n   182→      'contexts' => ['url.query_args', 'url.path'],\n   183→      'tags' => ['migration_plugins'],\n   184→    ];\n   185→\n   186→    return $build;\n   187→  }\n   188→\n   189→  /**\n   190→   * Builds the tab navigation for the detail page.\n   191→   *\n   192→   * @param string $migrationId\n   193→   *   The migration ID.\n   194→   * @param string $activeTab\n   195→   *   The currently active tab ('items', 'messages', or 'failed').\n   196→   *\n   197→   * @return array\n   198→   *   A render array.\n   199→   */\n   200→  protected function buildTabs(string $migrationId, string $activeTab): array {\n   201→    $failedCount = $this->getFailedItemCount($migrationId);\n   202→    $failedLabel = $failedCount > 0\n   203→      ? $this->t('Failed Items (@count)', ['@count' => $failedCount])\n   204→      : $this->t('Failed Items');\n   205→\n   206→    return [\n   207→      '#type' => 'container',\n   208→      '#attributes' => ['class' => ['migrate-detail-tabs']],\n   209→      'items_tab' => [\n   210→        '#type' => 'html_tag',\n   211→        '#tag' => 'a',\n   212→        '#value' => $this->t('Imported Items'),\n   213→        '#attributes' => [\n   214→          'href' => Url::fromRoute('migrate_admin.migration_detail', ['migration_id' => $migrationId])->toString(),\n   215→          'class' => array_filter(['migrate-tab', $activeTab === 'items' ? 'migrate-tab--active' : '']),\n   216→        ],\n   217→      ],\n   218→      'messages_tab' => [\n   219→        '#type' => 'html_tag',\n   220→        '#tag' => 'a',\n   221→        '#value' => $this->t('Messages'),\n   222→        '#attributes' => [\n   223→          'href' => Url::fromRoute('migrate_admin.migration_messages', ['migration_id' => $migrationId])->toString(),\n   224→          'class' => array_filter(['migrate-tab', $activeTab === 'messages' ? 'migrate-tab--active' : '']),\n   225→        ],\n   226→      ],\n   227→      'failed_tab' => [\n   228→        '#type' => 'html_tag',\n   229→        '#tag' => 'a',\n   230→        '#value' => $failedLabel,\n   231→        '#attributes' => [\n   232→          'href' => Url::fromRoute('migrate_admin.migration_failed_items', ['migration_id' => $migrationId])->toString(),\n   233→          'class' => array_filter([\n   234→            'migrate-tab',\n   235→            $activeTab === 'failed' ? 'migrate-tab--active' : '',\n   236→            $failedCount > 0 ? 'migrate-tab--has-badge' : '',\n   237→          ]),\n   238→        ],\n   239→      ],\n   240→    ];\n   241→  }\n   242→\n   243→  /**\n   244→   * Gets the count of failed items for a migration.\n   245→   *\n   246→   * @param string $migrationId\n   247→   *   The migration ID.\n   248→   *\n   249→   * @return int\n   250→   *   The number of failed items.\n   251→   */\n   252→  protected function getFailedItemCount(string $migrationId): int {\n   253→    $table = 'migrate_map_' . $migrationId;\n   254→    if (!$this->database->schema()->tableExists($table)) {\n   255→      return 0;\n   256→    }\n   257→\n   258→    return (int) $this->database->select($table, 'map')\n   259→      ->condition('source_row_status', 2)\n   260→      ->countQuery()\n   261→      ->execute()\n   262→      ->fetchField();\n   263→  }\n   264→\n   265→  /**\n   266→   * Builds the failed items section with filters and pager.\n   267→   *\n   268→   * @param string $migrationId\n   269→   *   The migration ID.\n   270→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   271→   *   The current request.\n   272→   *\n   273→   * @return array\n   274→   *   A render array.\n   275→   */\n   276→  protected function buildFailedItemsSection(string $migrationId, Request $request): array {\n   277→    $search = $request->query->get('search', '');\n   278→    $page = max(0, (int) $request->query->get('page', 0));\n   279→\n   280→    $mapTable = 'migrate_map_' . $migrationId;\n   281→    if (!$this->database->schema()->tableExists($mapTable)) {\n   282→      return [\n   283→        '#markup' => '<p>' . $this->t('No map table exists for this migration. The migration may not have been run yet.') . '</p>',\n   284→      ];\n   285→    }\n   286→\n   287→    // Query for failed items (source_row_status = 2).\n   288→    $query = $this->database->select($mapTable, 'map')\n   289→      ->fields('map')\n   290→      ->condition('source_row_status', 2);\n   291→\n   292→    // Detect source ID columns.\n   293→    $sourceIdCols = [];\n   294→    for ($i = 1; $i <= 9; $i++) {\n   295→      if ($this->database->schema()->fieldExists($mapTable, 'sourceid' . $i)) {\n   296→        $sourceIdCols[] = 'sourceid' . $i;\n   297→      }\n   298→    }\n   299→\n   300→    // Apply search filter on source IDs.\n   301→    if ($search !== '') {\n   302→      $or = $query->orConditionGroup();\n   303→      foreach ($sourceIdCols as $col) {\n   304→        $or->condition($col, '%' . $this->database->escapeLike($search) . '%', 'LIKE');\n   305→      }\n   306→      $query->condition($or);\n   307→    }\n   308→\n   309→    // Count total for pager.\n   310→    $countQuery = clone $query;\n   311→    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n   312→\n   313→    // Apply pager.\n   314→    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n   315→    $query->orderBy('last_imported', 'DESC');\n   316→    $rows = $query->execute()->fetchAll();\n   317→\n   318→    // Check if message table exists for error messages.\n   319→    $msgTable = 'migrate_message_' . $migrationId;\n   320→    $hasMsgTable = $this->database->schema()->tableExists($msgTable);\n   321→\n   322→    // Detect message source ID columns.\n   323→    $msgSourceIdCols = [];\n   324→    if ($hasMsgTable) {\n   325→      for ($i = 1; $i <= 9; $i++) {\n   326→        $col = 'src_' . $i;\n   327→        if ($this->database->schema()->fieldExists($msgTable, $col)) {\n   328→          $msgSourceIdCols[] = $col;\n   329→        }\n   330→      }\n   331→    }\n   332→\n   333→    // Build filter form.\n   334→    $build = [];\n   335→    $build['filters'] = $this->buildFailedItemFilterForm($migrationId, $search);\n   336→\n   337→    // Check if user can reset failed items.\n   338→    $canReset = $this->canResetFailedItems($migrationId);\n   339→\n   340→    // Build table rows.\n   341→    $tableRows = [];\n   342→    foreach ($rows as $row) {\n   343→      $sourceIds = [];\n   344→      foreach ($sourceIdCols as $col) {\n   345→        if (isset($row->$col) && $row->$col !== NULL) {\n   346→          $sourceIds[] = $row->$col;\n   347→        }\n   348→      }\n   349→\n   350→      $sourceIdStr = implode(', ', $sourceIds);\n   351→\n   352→      // Look up error message from message table.\n   353→      $errorMessage = '';\n   354→      if ($hasMsgTable && !empty($sourceIds)) {\n   355→        $errorMessage = $this->getErrorMessageForSourceIds($msgTable, $msgSourceIdCols, $sourceIds);\n   356→      }\n   357→\n   358→      $lastImported = !empty($row->last_imported)\n   359→        ? $this->dateFormatter->format((int) $row->last_imported, 'short')\n   360→        : $this->t('Unknown');\n   361→\n   362→      $rowData = [\n   363→        $sourceIdStr,\n   364→        $errorMessage,\n   365→        $lastImported,\n   366→      ];\n   367→\n   368→      $tableRows[] = $rowData;\n   369→    }\n   370→\n   371→    $header = [\n   372→      $this->t('Source ID(s)'),\n   373→      $this->t('Error message'),\n   374→      $this->t('Last attempt'),\n   375→    ];\n   376→\n   377→    $build['table'] = [\n   378→      '#type' => 'table',\n   379→      '#header' => $header,\n   380→      '#rows' => $tableRows,\n   381→      '#empty' => $this->t('No failed items found.'),\n   382→    ];\n   383→\n   384→    // Add reset action link if user has permission and there are failed items.\n   385→    if ($canReset && $total > 0) {\n   386→      $build['actions'] = [\n   387→        '#type' => 'container',\n   388→        '#attributes' => ['class' => ['migrate-failed-actions']],\n   389→        'reset_link' => [\n   390→          '#type' => 'html_tag',\n   391→          '#tag' => 'a',\n   392→          '#value' => $this->t('Reset all failed items for retry'),\n   393→          '#attributes' => [\n   394→            'href' => Url::fromRoute('migrate_admin.migration_reset_failed', ['migration_id' => $migrationId])->toString(),\n   395→            'class' => ['button', 'button--danger'],\n   396→          ],\n   397→        ],\n   398→      ];\n   399→    }\n   400→\n   401→    // Build pager.\n   402→    if ($total > self::ITEMS_PER_PAGE) {\n   403→      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request, 'failed');\n   404→    }\n   405→\n   406→    return $build;\n   407→  }\n   408→\n   409→  /**\n   410→   * Gets the error message for a set of source IDs from the message table.\n   411→   *\n   412→   * @param string $msgTable\n   413→   *   The message table name.\n   414→   * @param array $msgSourceIdCols\n   415→   *   The source ID column names in the message table.\n   416→   * @param array $sourceIds\n   417→   *   The source ID values.\n   418→   *\n   419→   * @return string\n   420→   *   The error message, or empty string if not found.\n   421→   */\n   422→  protected function getErrorMessageForSourceIds(string $msgTable, array $msgSourceIdCols, array $sourceIds): string {\n   423→    try {\n   424→      $query = $this->database->select($msgTable, 'msg')\n   425→        ->fields('msg', ['message'])\n   426→        ->orderBy('msgid', 'DESC')\n   427→        ->range(0, 1);\n   428→\n   429→      foreach ($msgSourceIdCols as $index => $col) {\n   430→        if (isset($sourceIds[$index])) {\n   431→          $query->condition($col, $sourceIds[$index]);\n   432→        }\n   433→      }\n   434→\n   435→      $message = $query->execute()->fetchField();\n   436→      return $message !== FALSE ? (string) $message : '';\n   437→    }\n   438→    catch (\\Exception $e) {\n   439→      return '';\n   440→    }\n   441→  }\n   442→\n   443→  /**\n   444→   * Checks if the current user can reset failed items for a migration.\n   445→   *\n   446→   * @param string $migrationId\n   447→   *   The migration ID.\n   448→   *\n   449→   * @return bool\n   450→   *   TRUE if the user can reset failed items.\n   451→   */\n   452→  protected function canResetFailedItems(string $migrationId): bool {\n   453→    $account = $this->currentUser();\n   454→\n   455→    // If migrate_permissions is installed, check run permission.\n   456→    if ($this->migrateAccessCheck !== NULL) {\n   457→      return $this->migrateAccessCheck->canRunMigration($account, $migrationId);\n   458→    }\n   459→\n   460→    // Fallback: check admin permissions.\n   461→    return $account->hasPermission('administer migrations') || $account->hasPermission('administer site configuration');\n   462→  }\n   463→\n   464→  /**\n   465→   * Builds the filter form for failed items.\n   466→   *\n   467→   * @param string $migrationId\n   468→   *   The migration ID.\n   469→   * @param string $search\n   470→   *   Current search value.\n   471→   *\n   472→   * @return array\n   473→   *   A render array.\n   474→   */\n   475→  protected function buildFailedItemFilterForm(string $migrationId, string $search): array {\n   476→    return [\n   477→      '#type' => 'container',\n   478→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   479→      'form' => [\n   480→        '#type' => 'html_tag',\n   481→        '#tag' => 'form',\n   482→        '#attributes' => [\n   483→          'method' => 'get',\n   484→          'class' => ['migrate-dashboard-filter-form'],\n   485→        ],\n   486→        'search' => [\n   487→          '#type' => 'html_tag',\n   488→          '#tag' => 'div',\n   489→          '#attributes' => ['class' => ['form-item']],\n   490→          'label' => [\n   491→            '#type' => 'html_tag',\n   492→            '#tag' => 'label',\n   493→            '#attributes' => ['for' => 'edit-search'],\n   494→            '#value' => $this->t('Source ID'),\n   495→          ],\n   496→          'input' => [\n   497→            '#type' => 'html_tag',\n   498→            '#tag' => 'input',\n   499→            '#attributes' => [\n   500→              'type' => 'text',\n   501→              'name' => 'search',\n   502→              'id' => 'edit-search',\n   503→              'value' => $search,\n   504→              'placeholder' => $this->t('Search source ID'),\n   505→              'class' => ['form-text'],\n   506→            ],\n   507→          ],\n   508→        ],\n   509→        'actions' => [\n   510→          '#type' => 'html_tag',\n   511→          '#tag' => 'div',\n   512→          '#attributes' => ['class' => ['form-actions']],\n   513→          'submit' => [\n   514→            '#type' => 'html_tag',\n   515→            '#tag' => 'input',\n   516→            '#attributes' => [\n   517→              'type' => 'submit',\n   518→              'value' => $this->t('Filter'),\n   519→              'class' => ['button', 'button--primary'],\n   520→            ],\n   521→          ],\n   522→        ],\n   523→      ],\n   524→    ];\n   525→  }\n   526→\n   527→  /**\n   528→   * Loads a migration plugin or throws 404.\n   529→   *\n   530→   * @param string $migration_id\n   531→   *   The migration plugin ID.\n   532→   *\n   533→   * @return \\Drupal\\migrate\\Plugin\\MigrationInterface\n   534→   *   The migration plugin instance.\n   535→   *\n   536→   * @throws \\Symfony\\Component\\HttpKernel\\Exception\\NotFoundHttpException\n   537→   */\n   538→  protected function loadMigration(string $migration_id) {\n   539→    $migrations = $this->migrationPluginManager->createInstances([$migration_id]);\n   540→    if (empty($migrations[$migration_id])) {\n   541→      throw new NotFoundHttpException();\n   542→    }\n   543→\n   544→    // Check per-migration view permission if migrate_permissions is enabled.\n   545→    if ($this->migrateAccessCheck !== NULL && !$this->migrateAccessCheck->canViewMigration($this->currentUser(), $migration_id)) {\n   546→      throw new AccessDeniedHttpException();\n   547→    }\n   548→\n   549→    return $migrations[$migration_id];\n   550→  }\n   551→\n   552→  /**\n   553→   * Gets the current status of a migration.\n   554→   *\n   555→   * @param \\Drupal\\migrate\\Plugin\\MigrationInterface $migration\n   556→   *   The migration plugin instance.\n   557→   *\n   558→   * @return string\n   559→   *   The status string.\n   560→   */\n   561→  protected function getMigrationStatus($migration): string {\n   562→    $statusString = (string) $migration->getStatusLabel();\n   563→    $statusMap = [\n   564→      'Idle' => 'idle',\n   565→      'Importing' => 'importing',\n   566→      'Rolling back' => 'rolling_back',\n   567→      'Stopping' => 'idle',\n   568→      'Disabled' => 'idle',\n   569→    ];\n   570→\n   571→    $migrationStatus = $statusMap[$statusString] ?? 'idle';\n   572→\n   573→    if ($migrationStatus === 'idle') {\n   574→      $lastRun = $this->database->select('migrate_suite_run_log', 'r')\n   575→        ->fields('r', ['status'])\n   576→        ->condition('migration_id', $migration->id())\n   577→        ->orderBy('id', 'DESC')\n   578→        ->range(0, 1)\n   579→        ->execute()\n   580→        ->fetchField();\n   581→\n   582→      if ($lastRun === 'completed') {\n   583→        $migrationStatus = 'completed';\n   584→      }\n   585→      elseif ($lastRun === 'failed') {\n   586→        $migrationStatus = 'failed';\n   587→      }\n   588→    }\n   589→\n   590→    return $migrationStatus;\n   591→  }\n   592→\n   593→  /**\n   594→   * Gets the last run stats from the run log.\n   595→   *\n   596→   * @param string $migrationId\n   597→   *   The migration ID.\n   598→   *\n   599→   * @return object|null\n   600→   *   The last run log row, or NULL if never run.\n   601→   */\n   602→  protected function getLastRunStats(string $migrationId): ?object {\n   603→    $result = $this->database->select('migrate_suite_run_log', 'r')\n   604→      ->fields('r')\n   605→      ->condition('migration_id', $migrationId)\n   606→      ->orderBy('id', 'DESC')\n   607→      ->range(0, 1)\n   608→      ->execute()\n   609→      ->fetchObject();\n   610→\n   611→    return $result ?: NULL;\n   612→  }\n   613→\n   614→  /**\n   615→   * Builds a summary string for the last run.\n   616→   *\n   617→   * @param object $lastRun\n   618→   *   The last run log row.\n   619→   *\n   620→   * @return string\n   621→   *   A formatted summary string.\n   622→   */\n   623→  protected function buildLastRunSummary(object $lastRun): string {\n   624→    $started = $this->dateFormatter->format((int) $lastRun->started, 'short');\n   625→    $parts = [$this->t('Started: @date', ['@date' => $started])];\n   626→\n   627→    if ($lastRun->finished) {\n   628→      $finished = $this->dateFormatter->format((int) $lastRun->finished, 'short');\n   629→      $parts[] = $this->t('Finished: @date', ['@date' => $finished]);\n   630→    }\n   631→\n   632→    $parts[] = $this->t('Processed: @count', ['@count' => $lastRun->items_processed]);\n   633→    $parts[] = $this->t('Created: @count', ['@count' => $lastRun->items_created]);\n   634→    $parts[] = $this->t('Updated: @count', ['@count' => $lastRun->items_updated]);\n   635→    $parts[] = $this->t('Failed: @count', ['@count' => $lastRun->items_failed]);\n   636→\n   637→    return implode(' | ', $parts);\n   638→  }\n   639→\n   640→  /**\n   641→   * Builds a colored status badge.\n   642→   *\n   643→   * @param string $status\n   644→   *   The migration status.\n   645→   *\n   646→   * @return array\n   647→   *   A render array with the badge markup.\n   648→   */\n   649→  protected function buildStatusBadge(string $status): array {\n   650→    $labels = [\n   651→      'idle' => $this->t('Idle'),\n   652→      'importing' => $this->t('Importing'),\n   653→      'rolling_back' => $this->t('Rolling back'),\n   654→      'completed' => $this->t('Completed'),\n   655→      'failed' => $this->t('Failed'),\n   656→    ];\n   657→\n   658→    $colors = [\n   659→      'idle' => 'color--success',\n   660→      'importing' => 'color--primary',\n   661→      'rolling_back' => 'color--warning',\n   662→      'completed' => 'color--success',\n   663→      'failed' => 'color--error',\n   664→    ];\n   665→\n   666→    $label = $labels[$status] ?? $status;\n   667→    $colorClass = $colors[$status] ?? '';\n   668→\n   669→    return [\n   670→      'data' => [\n   671→        '#markup' => '<span class=\"badge ' . $colorClass . '\">' . $label . '</span>',\n   672→      ],\n   673→    ];\n   674→  }\n   675→\n   676→  /**\n   677→   * Builds the imported items section with filters and pager.\n   678→   *\n   679→   * @param string $migrationId\n   680→   *   The migration ID.\n   681→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   682→   *   The current request.\n   683→   *\n   684→   * @return array\n   685→   *   A render array.\n   686→   */\n   687→  protected function buildImportedItemsSection(string $migrationId, Request $request): array {\n   688→    $search = $request->query->get('search', '');\n   689→    $statusFilter = $request->query->get('status', '');\n   690→    $page = max(0, (int) $request->query->get('page', 0));\n   691→\n   692→    $table = 'migrate_map_' . $migrationId;\n   693→    if (!$this->database->schema()->tableExists($table)) {\n   694→      return [\n   695→        '#markup' => '<p>' . $this->t('No map table exists for this migration. The migration may not have been run yet.') . '</p>',\n   696→      ];\n   697→    }\n   698→\n   699→    // Build the query.\n   700→    $query = $this->database->select($table, 'map')\n   701→      ->fields('map');\n   702→\n   703→    // Apply status filter.\n   704→    $statusMap = [\n   705→      'imported' => 0,\n   706→      'needs_update' => 1,\n   707→      'failed' => 2,\n   708→    ];\n   709→    if ($statusFilter !== '' && isset($statusMap[$statusFilter])) {\n   710→      $query->condition('source_row_status', $statusMap[$statusFilter]);\n   711→    }\n   712→\n   713→    // Apply search filter on source IDs.\n   714→    if ($search !== '') {\n   715→      $or = $query->orConditionGroup();\n   716→      // Search across sourceid columns (up to 5).\n   717→      for ($i = 1; $i <= 5; $i++) {\n   718→        $col = 'sourceid' . $i;\n   719→        if ($this->database->schema()->fieldExists($table, $col)) {\n   720→          $or->condition($col, '%' . $this->database->escapeLike($search) . '%', 'LIKE');\n   721→        }\n   722→      }\n   723→      $query->condition($or);\n   724→    }\n   725→\n   726→    // Count total for pager.\n   727→    $countQuery = clone $query;\n   728→    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n   729→\n   730→    // Apply pager.\n   731→    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n   732→    $query->orderBy('last_imported', 'DESC');\n   733→\n   734→    $rows = $query->execute()->fetchAll();\n   735→\n   736→    // Detect source ID and destination ID columns.\n   737→    $sourceIdCols = [];\n   738→    $destIdCols = [];\n   739→    for ($i = 1; $i <= 9; $i++) {\n   740→      if ($this->database->schema()->fieldExists($table, 'sourceid' . $i)) {\n   741→        $sourceIdCols[] = 'sourceid' . $i;\n   742→      }\n   743→      if ($this->database->schema()->fieldExists($table, 'destid' . $i)) {\n   744→        $destIdCols[] = 'destid' . $i;\n   745→      }\n   746→    }\n   747→\n   748→    // Build filter form.\n   749→    $build = [];\n   750→    $build['filters'] = $this->buildItemFilterForm($migrationId, $search, $statusFilter);\n   751→\n   752→    // Build table rows.\n   753→    $tableRows = [];\n   754→    foreach ($rows as $row) {\n   755→      $sourceIds = [];\n   756→      foreach ($sourceIdCols as $col) {\n   757→        if (isset($row->$col) && $row->$col !== NULL) {\n   758→          $sourceIds[] = $row->$col;\n   759→        }\n   760→      }\n   761→\n   762→      $destIds = [];\n   763→      foreach ($destIdCols as $col) {\n   764→        if (isset($row->$col) && $row->$col !== NULL) {\n   765→          $destIds[] = $row->$col;\n   766→        }\n   767→      }\n   768→\n   769→      $destDisplay = implode(', ', $destIds) ?: $this->t('N/A');\n   770→\n   771→      // Try to link to the entity if we have a single destination ID.\n   772→      if (count($destIds) === 1) {\n   773→        $destDisplay = $this->buildEntityLink($migrationId, (string) $destIds[0]) ?: $destDisplay;\n   774→      }\n   775→\n   776→      $statusLabel = $this->getRowStatusLabel((int) $row->source_row_status);\n   777→\n   778→      $lastImported = !empty($row->last_imported)\n   779→        ? $this->dateFormatter->format((int) $row->last_imported, 'short')\n   780→        : $this->t('Unknown');\n   781→\n   782→      $tableRows[] = [\n   783→        implode(', ', $sourceIds),\n   784→        ['data' => ['#markup' => (string) $destDisplay]],\n   785→        $statusLabel,\n   786→        $lastImported,\n   787→      ];\n   788→    }\n   789→\n   790→    $build['table'] = [\n   791→      '#type' => 'table',\n   792→      '#header' => [\n   793→        $this->t('Source ID(s)'),\n   794→        $this->t('Destination entity'),\n   795→        $this->t('Status'),\n   796→        $this->t('Last import'),\n   797→      ],\n   798→      '#rows' => $tableRows,\n   799→      '#empty' => $this->t('No imported items found.'),\n   800→    ];\n   801→\n   802→    // Build pager.\n   803→    if ($total > self::ITEMS_PER_PAGE) {\n   804→      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request);\n   805→    }\n   806→\n   807→    return $build;\n   808→  }\n   809→\n   810→  /**\n   811→   * Builds the messages section with filters and pager.\n   812→   *\n   813→   * @param string $migrationId\n   814→   *   The migration ID.\n   815→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n   816→   *   The current request.\n   817→   *\n   818→   * @return array\n   819→   *   A render array.\n   820→   */\n   821→  protected function buildMessagesSection(string $migrationId, Request $request): array {\n   822→    $severityFilter = $request->query->get('severity', '');\n   823→    $page = max(0, (int) $request->query->get('page', 0));\n   824→\n   825→    $table = 'migrate_message_' . $migrationId;\n   826→    if (!$this->database->schema()->tableExists($table)) {\n   827→      return [\n   828→        '#markup' => '<p>' . $this->t('No message table exists for this migration.') . '</p>',\n   829→      ];\n   830→    }\n   831→\n   832→    $query = $this->database->select($table, 'msg')\n   833→      ->fields('msg');\n   834→\n   835→    // Apply severity filter.\n   836→    $severityMap = [\n   837→      'notice' => 6,\n   838→      'warning' => 4,\n   839→      'error' => 3,\n   840→    ];\n   841→    if ($severityFilter !== '' && isset($severityMap[$severityFilter])) {\n   842→      $query->condition('level', $severityMap[$severityFilter]);\n   843→    }\n   844→\n   845→    // Count total for pager.\n   846→    $countQuery = clone $query;\n   847→    $total = (int) $countQuery->countQuery()->execute()->fetchField();\n   848→\n   849→    $query->range($page * self::ITEMS_PER_PAGE, self::ITEMS_PER_PAGE);\n   850→    $rows = $query->execute()->fetchAll();\n   851→\n   852→    // Detect source ID columns.\n   853→    $sourceIdCols = [];\n   854→    for ($i = 1; $i <= 9; $i++) {\n   855→      $col = 'src_' . $i;\n   856→      if ($this->database->schema()->fieldExists($table, $col)) {\n   857→        $sourceIdCols[] = $col;\n   858→      }\n   859→    }\n   860→\n   861→    // Build severity filter.\n   862→    $build = [];\n   863→    $build['filters'] = $this->buildMessageFilterForm($migrationId, $severityFilter);\n   864→\n   865→    // Build table rows.\n   866→    $tableRows = [];\n   867→    foreach ($rows as $row) {\n   868→      $sourceIds = [];\n   869→      foreach ($sourceIdCols as $col) {\n   870→        if (isset($row->$col) && $row->$col !== NULL) {\n   871→          $sourceIds[] = $row->$col;\n   872→        }\n   873→      }\n   874→\n   875→      $severityIcon = $this->getSeverityIcon((int) $row->level);\n   876→\n   877→      $tableRows[] = [\n   878→        implode(', ', $sourceIds),\n   879→        ['data' => ['#markup' => $severityIcon]],\n   880→        $row->message ?? '',\n   881→      ];\n   882→    }\n   883→\n   884→    $build['table'] = [\n   885→      '#type' => 'table',\n   886→      '#header' => [\n   887→        $this->t('Source ID(s)'),\n   888→        $this->t('Severity'),\n   889→        $this->t('Message'),\n   890→      ],\n   891→      '#rows' => $tableRows,\n   892→      '#empty' => $this->t('No messages found.'),\n   893→    ];\n   894→\n   895→    // Build pager.\n   896→    if ($total > self::ITEMS_PER_PAGE) {\n   897→      $build['pager'] = $this->buildPager($migrationId, $page, $total, $request, 'messages');\n   898→    }\n   899→\n   900→    return $build;\n   901→  }\n   902→\n   903→  /**\n   904→   * Builds the filter form for imported items.\n   905→   *\n   906→   * @param string $migrationId\n   907→   *   The migration ID.\n   908→   * @param string $search\n   909→   *   Current search value.\n   910→   * @param string $statusFilter\n   911→   *   Current status filter.\n   912→   *\n   913→   * @return array\n   914→   *   A render array.\n   915→   */\n   916→  protected function buildItemFilterForm(string $migrationId, string $search, string $statusFilter): array {\n   917→    $statusOptions = [\n   918→      '' => $this->t('- All statuses -'),\n   919→      'imported' => $this->t('Imported'),\n   920→      'needs_update' => $this->t('Needs update'),\n   921→      'failed' => $this->t('Failed'),\n   922→    ];\n   923→\n   924→    return [\n   925→      '#type' => 'container',\n   926→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n   927→      'form' => [\n   928→        '#type' => 'html_tag',\n   929→        '#tag' => 'form',\n   930→        '#attributes' => [\n   931→          'method' => 'get',\n   932→          'class' => ['migrate-dashboard-filter-form'],\n   933→        ],\n   934→        'search' => [\n   935→          '#type' => 'html_tag',\n   936→          '#tag' => 'div',\n   937→          '#attributes' => ['class' => ['form-item']],\n   938→          'label' => [\n   939→            '#type' => 'html_tag',\n   940→            '#tag' => 'label',\n   941→            '#attributes' => ['for' => 'edit-search'],\n   942→            '#value' => $this->t('Source ID'),\n   943→          ],\n   944→          'input' => [\n   945→            '#type' => 'html_tag',\n   946→            '#tag' => 'input',\n   947→            '#attributes' => [\n   948→              'type' => 'text',\n   949→              'name' => 'search',\n   950→              'id' => 'edit-search',\n   951→              'value' => $search,\n   952→              'placeholder' => $this->t('Search source ID'),\n   953→              'class' => ['form-text'],\n   954→            ],\n   955→          ],\n   956→        ],\n   957→        'status' => [\n   958→          '#type' => 'html_tag',\n   959→          '#tag' => 'div',\n   960→          '#attributes' => ['class' => ['form-item']],\n   961→          'label' => [\n   962→            '#type' => 'html_tag',\n   963→            '#tag' => 'label',\n   964→            '#attributes' => ['for' => 'edit-status'],\n   965→            '#value' => $this->t('Status'),\n   966→          ],\n   967→          'select' => [\n   968→            '#type' => 'html_tag',\n   969→            '#tag' => 'select',\n   970→            '#attributes' => [\n   971→              'name' => 'status',\n   972→              'id' => 'edit-status',\n   973→              'class' => ['form-select'],\n   974→            ],\n   975→            'options' => $this->buildSelectOptions($statusOptions, $statusFilter),\n   976→          ],\n   977→        ],\n   978→        'actions' => [\n   979→          '#type' => 'html_tag',\n   980→          '#tag' => 'div',\n   981→          '#attributes' => ['class' => ['form-actions']],\n   982→          'submit' => [\n   983→            '#type' => 'html_tag',\n   984→            '#tag' => 'input',\n   985→            '#attributes' => [\n   986→              'type' => 'submit',\n   987→              'value' => $this->t('Filter'),\n   988→              'class' => ['button', 'button--primary'],\n   989→            ],\n   990→          ],\n   991→        ],\n   992→      ],\n   993→    ];\n   994→  }\n   995→\n   996→  /**\n   997→   * Builds the filter form for messages.\n   998→   *\n   999→   * @param string $migrationId\n  1000→   *   The migration ID.\n  1001→   * @param string $severityFilter\n  1002→   *   Current severity filter.\n  1003→   *\n  1004→   * @return array\n  1005→   *   A render array.\n  1006→   */\n  1007→  protected function buildMessageFilterForm(string $migrationId, string $severityFilter): array {\n  1008→    $severityOptions = [\n  1009→      '' => $this->t('- All severities -'),\n  1010→      'notice' => $this->t('Notice'),\n  1011→      'warning' => $this->t('Warning'),\n  1012→      'error' => $this->t('Error'),\n  1013→    ];\n  1014→\n  1015→    return [\n  1016→      '#type' => 'container',\n  1017→      '#attributes' => ['class' => ['migrate-dashboard-filters']],\n  1018→      'form' => [\n  1019→        '#type' => 'html_tag',\n  1020→        '#tag' => 'form',\n  1021→        '#attributes' => [\n  1022→          'method' => 'get',\n  1023→          'class' => ['migrate-dashboard-filter-form'],\n  1024→        ],\n  1025→        'severity' => [\n  1026→          '#type' => 'html_tag',\n  1027→          '#tag' => 'div',\n  1028→          '#attributes' => ['class' => ['form-item']],\n  1029→          'label' => [\n  1030→            '#type' => 'html_tag',\n  1031→            '#tag' => 'label',\n  1032→            '#attributes' => ['for' => 'edit-severity'],\n  1033→            '#value' => $this->t('Severity'),\n  1034→          ],\n  1035→          'select' => [\n  1036→            '#type' => 'html_tag',\n  1037→            '#tag' => 'select',\n  1038→            '#attributes' => [\n  1039→              'name' => 'severity',\n  1040→              'id' => 'edit-severity',\n  1041→              'class' => ['form-select'],\n  1042→            ],\n  1043→            'options' => $this->buildSelectOptions($severityOptions, $severityFilter),\n  1044→          ],\n  1045→        ],\n  1046→        'actions' => [\n  1047→          '#type' => 'html_tag',\n  1048→          '#tag' => 'div',\n  1049→          '#attributes' => ['class' => ['form-actions']],\n  1050→          'submit' => [\n  1051→            '#type' => 'html_tag',\n  1052→            '#tag' => 'input',\n  1053→            '#attributes' => [\n  1054→              'type' => 'submit',\n  1055→              'value' => $this->t('Filter'),\n  1056→              'class' => ['button', 'button--primary'],\n  1057→            ],\n  1058→          ],\n  1059→        ],\n  1060→      ],\n  1061→    ];\n  1062→  }\n  1063→\n  1064→  /**\n  1065→   * Builds select option elements.\n  1066→   *\n  1067→   * @param array $options\n  1068→   *   The options array.\n  1069→   * @param string $selectedValue\n  1070→   *   The currently selected value.\n  1071→   *\n  1072→   * @return array\n  1073→   *   A render array of option elements.\n  1074→   */\n  1075→  protected function buildSelectOptions(array $options, string $selectedValue): array {\n  1076→    $elements = [];\n  1077→    foreach ($options as $value => $label) {\n  1078→      $attributes = ['value' => $value];\n  1079→      if ((string) $value === $selectedValue) {\n  1080→        $attributes['selected'] = 'selected';\n  1081→      }\n  1082→      $elements[] = [\n  1083→        '#type' => 'html_tag',\n  1084→        '#tag' => 'option',\n  1085→        '#attributes' => $attributes,\n  1086→        '#value' => $label,\n  1087→      ];\n  1088→    }\n  1089→    return $elements;\n  1090→  }\n  1091→\n  1092→  /**\n  1093→   * Builds a simple pager.\n  1094→   *\n  1095→   * @param string $migrationId\n  1096→   *   The migration ID.\n  1097→   * @param int $currentPage\n  1098→   *   The current page number (0-indexed).\n  1099→   * @param int $total\n  1100→   *   The total number of items.\n  1101→   * @param \\Symfony\\Component\\HttpFoundation\\Request $request\n  1102→   *   The current request.\n  1103→   * @param string $tab\n  1104→   *   The current tab ('items' or 'messages').\n  1105→   *\n  1106→   * @return array\n  1107→   *   A render array for the pager.\n  1108→   */\n  1109→  protected function buildPager(string $migrationId, int $currentPage, int $total, Request $request, string $tab = 'items'): array {\n  1110→    $totalPages = (int) ceil($total / self::ITEMS_PER_PAGE);\n  1111→    $routeMap = [\n  1112→      'messages' => 'migrate_admin.migration_messages',\n  1113→      'failed' => 'migrate_admin.migration_failed_items',\n  1114→    ];\n  1115→    $route = $routeMap[$tab] ?? 'migrate_admin.migration_detail';\n  1116→\n  1117→    $queryParams = $request->query->all();\n  1118→    $links = [];\n  1119→\n  1120→    if ($currentPage > 0) {\n  1121→      $queryParams['page'] = $currentPage - 1;\n  1122→      $links['previous'] = [\n  1123→        '#type' => 'html_tag',\n  1124→        '#tag' => 'a',\n  1125→        '#value' => $this->t('Previous'),\n  1126→        '#attributes' => [\n  1127→          'href' => Url::fromRoute($route, ['migration_id' => $migrationId], ['query' => $queryParams])->toString(),\n  1128→          'class' => ['button'],\n  1129→        ],\n  1130→      ];\n  1131→    }\n  1132→\n  1133→    $links['info'] = [\n  1134→      '#type' => 'html_tag',\n  1135→      '#tag' => 'span',\n  1136→      '#value' => $this->t('Page @current of @total (@items items)', [\n  1137→        '@current' => $currentPage + 1,\n  1138→        '@total' => $totalPages,\n  1139→        '@items' => $total,\n  1140→      ]),\n  1141→      '#attributes' => ['class' => ['migrate-pager-info']],\n  1142→    ];\n  1143→\n  1144→    if ($currentPage < $totalPages - 1) {\n  1145→      $queryParams['page'] = $currentPage + 1;\n  1146→      $links['next'] = [\n  1147→        '#type' => 'html_tag',\n  1148→        '#tag' => 'a',\n  1149→        '#value' => $this->t('Next'),\n  1150→        '#attributes' => [\n  1151→          'href' => Url::fromRoute($route, ['migration_id' => $migrationId], ['query' => $queryParams])->toString(),\n  1152→          'class' => ['button'],\n  1153→        ],\n  1154→      ];\n  1155→    }\n  1156→\n  1157→    return [\n  1158→      '#type' => 'container',\n  1159→      '#attributes' => ['class' => ['migrate-pager']],\n  1160→    ] + $links;\n  1161→  }\n  1162→\n  1163→  /**\n  1164→   * Gets a human-readable status label for a row status.\n  1165→   *\n  1166→   * @param int $status\n  1167→   *   The source_row_status value.\n  1168→   *\n  1169→   * @return string\n  1170→   *   The status label.\n  1171→   */\n  1172→  protected function getRowStatusLabel(int $status): string {\n  1173→    $labels = [\n  1174→      0 => (string) $this->t('Imported'),\n  1175→      1 => (string) $this->t('Needs update'),\n  1176→      2 => (string) $this->t('Failed'),\n  1177→    ];\n  1178→\n  1179→    return $labels[$status] ?? (string) $this->t('Unknown');\n  1180→  }\n  1181→\n  1182→  /**\n  1183→   * Gets a severity icon for a message level.\n  1184→   *\n  1185→   * @param int $level\n  1186→   *   The RFC 5424 severity level.\n  1187→   *\n  1188→   * @return string\n  1189→   *   HTML markup for the severity icon.\n  1190→   */\n  1191→  protected function getSeverityIcon(int $level): string {\n  1192→    // RFC 5424 levels: 3=error, 4=warning, 5=notice, 6=info, 7=debug.\n  1193→    if ($level <= 3) {\n  1194→      return '<span class=\"badge color--error\">' . $this->t('Error') . '</span>';\n  1195→    }\n  1196→    elseif ($level <= 4) {\n  1197→      return '<span class=\"badge color--warning\">' . $this->t('Warning') . '</span>';\n  1198→    }\n  1199→    return '<span class=\"badge color--success\">' . $this->t('Notice') . '</span>';\n  1200→  }\n  1201→\n  1202→  /**\n  1203→   * Attempts to build a link to the destination entity.\n  1204→   *\n  1205→   * @param string $migrationId\n  1206→   *   The migration ID.\n  1207→   * @param string $destId\n  1208→   *   The destination entity ID.\n  1209→   *\n  1210→   * @return string|null\n  1211→   *   The HTML link markup, or NULL if not possible.\n  1212→   */\n  1213→  protected function buildEntityLink(string $migrationId, string $destId): ?string {\n  1214→    try {\n  1215→      $migrations = $this->migrationPluginManager->createInstances([$migrationId]);\n  1216→      if (empty($migrations[$migrationId])) {\n  1217→        return NULL;\n  1218→      }\n  1219→      $migration = $migrations[$migrationId];\n  1220→      $definition = $migration->getPluginDefinition();\n  1221→      $destPlugin = $definition['destination']['plugin'] ?? '';\n  1222→\n  1223→      // Extract entity type from destination plugin (e.g., 'entity:node').\n  1224→      if (str_starts_with($destPlugin, 'entity:')) {\n  1225→        $entityTypeId = substr($destPlugin, 7);\n  1226→        $entityTypeManager = \\Drupal::entityTypeManager();\n  1227→        if ($entityTypeManager->hasDefinition($entityTypeId)) {\n  1228→          $entity = $entityTypeManager->getStorage($entityTypeId)->load($destId);\n  1229→          if ($entity && $entity->hasLinkTemplate('canonical')) {\n  1230→            $url = $entity->toUrl()->toString();\n  1231→            $label = method_exists($entity, 'label') ? $entity->label() : $destId;\n  1232→            return '<a href=\"' . $url . '\">' . htmlspecialchars((string) $label, ENT_QUOTES) . ' (' . $destId . ')</a>';\n  1233→          }\n  1234→        }\n  1235→      }\n  1236→    }\n  1237→    catch (\\Exception $e) {\n  1238→      // Fall through to return NULL.\n  1239→    }\n  1240→\n  1241→    return NULL;\n  1242→  }\n  1243→\n  1244→}\n  1245→"}]},"parent_tool_use_id":"toolu_01K4BTcZkXfLmZoZb78Si7ST","session_id":"947754a4-35aa-442f-a4b8-f81a7a0a67f9","uuid":"b5bf4153-53d9-45a9-9b49-9e30468a9f4e"}
