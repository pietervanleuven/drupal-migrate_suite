er of items created.',\n    56→        'type' => 'int',\n    57→        'unsigned' => TRUE,\n    58→        'not null' => TRUE,\n    59→        'default' => 0,\n    60→      ],\n    61→      'items_updated' => [\n    62→        'description' => 'Number of items updated.',\n    63→        'type' => 'int',\n    64→        'unsigned' => TRUE,\n    65→        'not null' => TRUE,\n    66→        'default' => 0,\n    67→      ],\n    68→      'items_failed' => [\n    69→        'description' => 'Number of items that failed.',\n    70→        'type' => 'int',\n    71→        'unsigned' => TRUE,\n    72→        'not null' => TRUE,\n    73→        'default' => 0,\n    74→      ],\n    75→    ],\n    76→    'primary key' => ['id'],\n    77→    'indexes' => [\n    78→      'migration_id' => ['migration_id'],\n    79→      'status' => ['status'],\n    80→    ],\n    81→  ];\n    82→\n    83→  return $schema;\n    84→}\n    85→"}]},"parent_tool_use_id":null,"session_id":"c2acd8b5-f80d-48c8-b462-6b0e23d48724","uuid":"aba8cf51-4ede-4307-95b6-2e4a064a6caa","tool_use_result":{"type":"text","file":{"filePath":"/Users/pieter/Projects/drupal-migrate_suite/migrate_suite.install","content":"<?php\n\n/**\n * @file\n * Install, update, and uninstall functions for Migrate Suite.\n */\n\n/**\n * Implements hook_schema().\n */\nfunction migrate_suite_schema(): array {\n  $schema['migrate_suite_run_log'] = [\n    'description' => 'Stores migration run history.',\n    'fields' => [\n      'id' => [\n        'description' => 'Primary key.',\n        'type' => 'serial',\n        'unsigned' => TRUE,\n        'not null' => TRUE,\n      ],\n      'migration_id' => [\n        'description' => 'The migration plugin ID.',\n        'type' => 'varchar',\n        'length' => 255,\n        'not null' => TRUE,\n        'default' => '',\n      ],\n      'status' => [\n        'description' => 'Run status: idle, running, completed, failed.',\n        'type' => 'varchar',\n        'length' => 32,\n        'not null' => TRUE,\n        'default' => 'idle',\n      ],\n      'started' => [\n        'description' => 'Timestamp when the run started.',\n        'type' => 'int',\n        'not null' => TRUE,\n        'default' => 0,\n      ],\n      'finished' => [\n        'description' => 'Timestamp when the run finished.',\n        'type' => 'int',\n        'not null' => FALSE,\n        'default' => NULL,\n      ],\n      'items_processed' => [\n        'description' => 'Number of items processed.',\n        'type' => 'int',\n        'unsigned' => TRUE,\n        'not null' => TRUE,\n        'default' => 0,\n      ],\n      'items_created' => [\n        'description' => 'Number of items created.',\n        'type' => 'int',\n        'unsigned' => TRUE,\n        'not null' => TRUE,\n        'default' => 0,\n      ],\n      'items_updated' => [\n        'description' => 'Number of items updated.',\n        'type' => 'int',\n        'unsigned' => TRUE,\n        'not null' => TRUE,\n        'default' => 0,\n      ],\n      'items_failed' => [\n        'description' => 'Number of items that failed.',\n        'type' => 'int',\n        'unsigned' => TRUE,\n        'not null' => TRUE,\n        'default' => 0,\n      ],\n    ],\n    'primary key' => ['id'],\n    'indexes' => [\n      'migration_id' => ['migration_id'],\n      'status' => ['status'],\n    ],\n  ];\n\n  return $schema;\n}\n","numLines":85,"startLine":1,"totalLines":85}}}
