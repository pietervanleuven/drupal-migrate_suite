<?php

/**
 * @file
 * Provides cron-based scheduling for migrations.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\migrate_schedule\Hook\MigrateScheduleHooks;

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function migrate_schedule_cron(): void {
  \Drupal::service(MigrateScheduleHooks::class)->cron();
}
