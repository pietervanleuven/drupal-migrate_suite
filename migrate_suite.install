<?php

/**
 * @file
 * Install, update, and uninstall functions for Migrate Suite.
 */

/**
 * Implements hook_schema().
 */
function migrate_suite_schema(): array {
  $schema['migrate_suite_run_log'] = [
    'description' => 'Stores migration run history.',
    'fields' => [
      'id' => [
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'migration_id' => [
        'description' => 'The migration plugin ID.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'status' => [
        'description' => 'Run status: idle, running, completed, failed.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'idle',
      ],
      'started' => [
        'description' => 'Timestamp when the run started.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'finished' => [
        'description' => 'Timestamp when the run finished.',
        'type' => 'int',
        'not null' => FALSE,
        'default' => NULL,
      ],
      'items_processed' => [
        'description' => 'Number of items processed.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'items_created' => [
        'description' => 'Number of items created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'items_updated' => [
        'description' => 'Number of items updated.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'items_failed' => [
        'description' => 'Number of items that failed.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'operation' => [
        'description' => 'Operation type: import or rollback.',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'import',
      ],
      'items_deleted' => [
        'description' => 'Number of items deleted (rollback).',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'source_count' => [
        'description' => 'Snapshot of source item count at run time.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'default' => NULL,
      ],
      'source_hash' => [
        'description' => 'Hash of source row IDs for delta detection.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'default' => NULL,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'migration_id' => ['migration_id'],
      'status' => ['status'],
      'operation' => ['operation'],
    ],
  ];

  return $schema;
}

/**
 * Add 'operation' and 'items_deleted' columns to migrate_suite_run_log.
 */
function migrate_suite_update_10001(): void {
  $schema = \Drupal::database()->schema();

  $schema->addField('migrate_suite_run_log', 'operation', [
    'description' => 'Operation type: import or rollback.',
    'type' => 'varchar',
    'length' => 16,
    'not null' => TRUE,
    'default' => 'import',
  ]);

  $schema->addField('migrate_suite_run_log', 'items_deleted', [
    'description' => 'Number of items deleted (rollback).',
    'type' => 'int',
    'unsigned' => TRUE,
    'not null' => TRUE,
    'default' => 0,
  ]);

  $schema->addIndex('migrate_suite_run_log', 'operation', ['operation'], [
    'fields' => [
      'operation' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'import',
      ],
    ],
  ]);
}

/**
 * Add 'source_count' and 'source_hash' columns for delta detection.
 */
function migrate_suite_update_10002(): void {
  $schema = \Drupal::database()->schema();

  $schema->addField('migrate_suite_run_log', 'source_count', [
    'description' => 'Snapshot of source item count at run time.',
    'type' => 'int',
    'unsigned' => TRUE,
    'not null' => FALSE,
    'default' => NULL,
  ]);

  $schema->addField('migrate_suite_run_log', 'source_hash', [
    'description' => 'Hash of source row IDs for delta detection.',
    'type' => 'varchar',
    'length' => 64,
    'not null' => FALSE,
    'default' => NULL,
  ]);
}
